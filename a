-- ?"??"? SPEED v2 (Warhorn Cycle): the horn's own speed, kept permanently.
-- Owned horn? It gets blown on cooldown through the game's own UseItem path
-- (exact warhorn buff, nothing emulated). No horn? The lock emulates the
-- buff window so the speed is there anyway. While v2 runs, the lock only
-- ever pushes UP: the game's own (higher) horn value is never stomped.
function hubWarhornTick()
    if not Cfg.WarhornV2 then return end
    local now = tick()
    if (getgenv()._HubHornAt or 0) + 1.0 > now then return end
    getgenv()._HubHornAt = now
    local fc = getFC()
    local lf = fc and fc.LocalFighter
    if not (lf and type(lf.Items) == "table") then return end
    local hornSlot, horn = nil, nil
    for slot, it in pairs(lf.Items) do
        local nm = ""
        pcall(function() nm = string.lower(tostring(it.Name or "")) end)
        if string.find(nm, "war horn", 1, true) or string.find(nm, "warhorn", 1, true) then
            hornSlot, horn = slot, it
            break
        end
    end
    if not (horn and hornSlot) then
        -- no horn owned: emulated buff window stays open while toggled on
        getgenv()._HubHornBuffUntil = now + 2
        return
    end
    local ready = true
    pcall(function()
        for k, v in pairs(horn) do
            if type(v) == "number" and v > now and k ~= "_reload_cooldown" then
                local kl = string.lower(tostring(k))
                if string.find(kl, "cooldown", 1, true) then ready = false break end
            end
        end
    end)
    if not ready then return end
    local curSlot = nil
    pcall(function()
        local cur = lf.EquippedItem
        for slot, it in pairs(lf.Items) do
            if it == cur then curSlot = slot break end
        end
    end)
    pcall(function() lf:EquipItem(hornSlot) end)
    task.delay(0.25, function()
        pcall(function()
            local enumLib = getEnumLib()
            local en = enumLib and enumLib:ToEnum("StartShooting")
            local oid = horn:Get("ObjectID")
            ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(oid, en, {}, nil)
        end)
        task.delay(0.6, function()
            pcall(function() if curSlot then lf:EquipItem(curSlot) end end)
        end)
    end)
    getgenv()._HubHornBuffUntil = now + (Cfg.WarhornDuration or 8)
end

-- ?"??"? v15 SKIP EQUIP (insta-swap): kills deploy-family animation tracks in a
-- short window after each weapon switch. Pair with No Cooldown (which already
-- zeroes _equip_cooldown) and swaps land instantly, no animation.
function hubSkipEquipTick()
    if not Cfg.WeaponSkipEquip then getgenv()._HubEquipWin = 0 return end
    local now = tick()
    local cur = nil
    pcall(function()
        local fc = getFC()
        local lf = fc and fc.LocalFighter
