local function rageDesyncPlant(targetPlayer, targetRoot, targetHead)
    if not (targetRoot and targetHead) then return nil end
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local mode = Cfg.RagePosMode or "Off"
    local dist = (myRoot.Position - targetRoot.Position).Magnitude
    local desyncPos = nil
    if mode == "Fly" then
        -- hover drives the body; fire from the live spot, no ghost needed
        if rageFlyTick(targetPlayer, targetRoot, targetHead) then
            return CFrame.lookAt(myRoot.Position, targetHead.Position)
        end
        return nil
    elseif mode == "Sky" then
        -- FIX v21: removed dist gate for Sky -- desync plant moves HRP there instantly
        desyncPos = targetRoot.Position + Vector3.new(0, 55, 0)
    elseif mode == "Underground" then
        -- under their feet, recomputed every shot so it follows them,
        -- body pitched flat (prone) instead of standing through the floor.
        -- FIX v21: removed rageReach()*2 gate -- desync teleports HRP there regardless of real dist
        local feet = targetRoot.Position - Vector3.new(0, 4, 0)
        desyncPos = feet - Vector3.new(0, 3, 0)
        if desyncPos.Y < rageKillFloor() + 4 then return nil end
        local flatCF = CFrame.lookAt(desyncPos, feet) * CFrame.Angles(math.pi / 2, 0, 0)
        local snapCF, snapVel, snapRot = myRoot.CFrame, myRoot.Velocity, myRoot.RotVelocity
        myRoot.CFrame = flatCF
        rageGhostRestore(myRoot, snapCF, snapVel, snapRot)
        return flatCF
    elseif mode == "Behind" then
        if dist > rageReach() then return nil end
        desyncPos = rageBehindPos(targetRoot)
    else -- Off: classic plant (+AlwaysBackstab behind plant inside reach)
        if (Cfg.RageAlwaysBackstab ~= false) and dist <= rageReach() then
            desyncPos = rageBehindPos(targetRoot)
        elseif rageHasKnifeVM(targetPlayer) then
            desyncPos = (targetRoot.CFrame * CFrame.new(0, 6, 0)).Position
        else
            desyncPos = (targetRoot.CFrame * CFrame.new(0, 1, 2)).Position
        end
    end
    if not desyncPos then return nil end
    local desyncCF = CFrame.lookAt(desyncPos, targetHead.Position)
    local snapCF, snapVel, snapRot = myRoot.CFrame, myRoot.Velocity, myRoot.RotVelocity
    myRoot.CFrame = desyncCF
    rageGhostRestore(myRoot, snapCF, snapVel, snapRot)
    return desyncCF
end


