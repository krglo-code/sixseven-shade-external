-- ESP parking while the menu is open (drawings render above all gui).
-- Idempotent: parks once, next live update redraws everything.
function hubEspPark()
    if getgenv()._HubEspParked then return end
    getgenv()._HubEspParked = true
    pcall(function()
        for _, d in pairs(_espPool) do hideESP(d) end
    end)
    pcall(function()
        local pool = getgenv()._HubTripPool
        if type(pool) == "table" then
            for _, o in pairs(pool) do
                if o then o.Visible = false end
            end
        end
    end)
end


function updateESP(cam)
    -- fast path: parked once when disabled, then zero work until re-enabled
    if not Cfg.ESPEnabled then
        if not getgenv()._HubEspHid then
            getgenv()._HubEspHid = true
            for _, d in pairs(_espPool) do hideESP(d) end
        end
        return
    end
    getgenv()._HubEspHid = false
    local selfChar = LP.Character
    local myRoot   = selfChar and selfChar:FindFirstChild("HumanoidRootPart")
    local boxC     = Color3.fromRGB(Cfg.ESPBoxColorR,    Cfg.ESPBoxColorG,    Cfg.ESPBoxColorB)
    local nameC    = Color3.fromRGB(Cfg.ESPNameColorR,   Cfg.ESPNameColorG,   Cfg.ESPNameColorB)
    local tracerC  = Color3.fromRGB(Cfg.ESPTracerColorR, Cfg.ESPTracerColorG, Cfg.ESPTracerColorB)
    local vp       = cam.ViewportSize


    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local d = _espPool[p] or createESPFor(p)
        local model = p.Character


        -- CRITICAL: always re-check alive status every frame
        if not Cfg.ESPEnabled or not model or not modelAlive(model) then
            hideESP(d)
            continue
        end


        if Cfg.ESPTeamCheck and not isEnemy(p) then
            hideESP(d)
            continue
        end


        local root = model:FindFirstChild("HumanoidRootPart")
        local dist = (myRoot and root)
            and (myRoot.Position - root.Position).Magnitude or math.huge
        if dist > Cfg.ESPMaxDist then
            hideESP(d)
            continue
        end


        -- Compute fresh box every frame ??" no caching
        local bx, by, bw, bh = compute2DBox(model, cam)
        if not bx then
            hideESP(d)
            continue
        end


        -- Shape: Circle ring + glow (modern) or Box / Corners (classic)
        local shape = Cfg.ESPShape or "Circle"
        boxC = hubEspColor(boxC)
        local isCircle = (shape == "Circle") and Cfg.ESPBox
        if isCircle then
            d.box.Visible = false
            pcall(function() d.outline.Visible = false end)
            hideESPCorners(d)
            local rcx, rcy = bx + bw * 0.5, by + bh * 0.5
            local rr = math.max(bw, bh) * 0.62
            if Cfg.ESPGlow and d.glow then
                d.glow.Position = Vector2.new(rcx, rcy)
                d.glow.Radius = rr
                d.glow.Color = boxC
                d.glow.Transparency = 1 - (Cfg.ESPGlowAlpha or 0.18)
                d.glow.Visible = true
            elseif d.glow then
                d.glow.Visible = false
            end
            d.ring.Position = Vector2.new(rcx, rcy)
            d.ring.Radius = rr
            d.ring.Color = boxC
            d.ring.Thickness = Cfg.ESPOutline and 2 or 1.5
            d.ring.Visible = true
            if Cfg.ESPFillBox then
                d.boxFill.Position     = Vector2.new(bx, by)
                d.boxFill.Size         = Vector2.new(bw, bh)
                d.boxFill.Color        = boxC
                d.boxFill.Transparency = Cfg.ESPFillAlpha
                d.boxFill.Visible      = true
            else
                d.boxFill.Visible = false
            end
        elseif Cfg.ESPBox then
            if Cfg.ESPModern == false then
                hideESPCorners(d)
                pcall(function() d.outline.Visible = false end)
                d.box.Position = Vector2.new(bx, by)
                d.box.Size     = Vector2.new(bw, bh)
                d.box.Color    = boxC
                d.box.Visible  = true
            elseif Cfg.ESPCorner then
                d.box.Visible = false
                if Cfg.ESPOutline and d.outline then
                    d.outline.Position = Vector2.new(bx - 1, by - 1)
                    d.outline.Size     = Vector2.new(bw + 2, bh + 2)
                    d.outline.Visible  = true
                elseif d.outline then
                    d.outline.Visible = false
                end
                paintESPCorners(d, bx, by, bw, bh, boxC)
            else
                hideESPCorners(d)
                if Cfg.ESPOutline and d.outline then
                    d.outline.Position = Vector2.new(bx - 1, by - 1)
                    d.outline.Size     = Vector2.new(bw + 2, bh + 2)
                    d.outline.Visible  = true
                elseif d.outline then
                    d.outline.Visible = false
                end
                d.box.Position = Vector2.new(bx, by)
                d.box.Size     = Vector2.new(bw, bh)
                d.box.Color    = boxC
                d.box.Visible  = true
            end
            if Cfg.ESPFillBox then
                d.boxFill.Position     = Vector2.new(bx, by)
                d.boxFill.Size         = Vector2.new(bw, bh)
                d.boxFill.Color        = boxC
                d.boxFill.Transparency = Cfg.ESPFillAlpha
                d.boxFill.Visible      = true
            else
                d.boxFill.Visible = false
            end
        else
            d.box.Visible     = false
            d.boxFill.Visible = false
        end


        -- Name tag (above box)
        if Cfg.ESPNames then
            d.nameTag.Text     = p.DisplayName ~= "" and p.DisplayName or p.Name
            d.nameTag.Color    = nameC
            d.nameTag.Position = Vector2.new(bx + bw * 0.5, by - 16)
            d.nameTag.Visible  = true
        else
            d.nameTag.Visible = false
        end
        -- Head dot: exact skull position, chroma-matched
        if Cfg.ESPHeadDot and d.headDot then
            local hd = headOf(model)
            if hd then
                local hsp, hon = cam:WorldToViewportPoint(hd.Position)
                if hon then
                    d.headDot.Position = Vector2.new(hsp.X, hsp.Y)
                    d.headDot.Color = boxC
                    d.headDot.Visible = true
                else
                    d.headDot.Visible = false
                end
            else
                d.headDot.Visible = false
            end
        elseif d.headDot then
            d.headDot.Visible = false
        end


        -- Health bar (left side, 4px wide). Exact fill: full HP bleeds
        -- edge-to-edge, no floor() pixel lost at the top when maxed.
        if Cfg.ESPHealthBar then
            local hp   = healthFraction(model)
            local barW = 4
            local barX = bx - barW - 2
            d.hpBG.Position = Vector2.new(barX, by)
            d.hpBG.Size     = Vector2.new(barW, bh)
            d.hpBG.Visible  = true
            local fillH = math.max(hp > 0 and 1 or 0, bh * hp)
            if fillH > bh then fillH = bh end
            d.hpBar.Position = Vector2.new(barX, by + bh - fillH)
            d.hpBar.Size     = Vector2.new(barW, fillH)
            d.hpBar.Color    = espHealthColor(hp)
            d.hpBar.Visible  = true
            if Cfg.ESPHealthText and d.hpText then
                local hum = getHumanoid(model)
                local cur = hum and math.floor(hum.Health + 0.5) or 0
                local max = hum and math.floor(hum.MaxHealth + 0.5) or 100
                d.hpText.Text     = tostring(cur) .. "/" .. tostring(max)
                d.hpText.Position = Vector2.new(barX - 2, by + bh + 2)
                d.hpText.Visible  = true
            elseif d.hpText then
                d.hpText.Visible = false
            end
            if Cfg.ESPChams and d.cham then
                d.cham.Position     = Vector2.new(bx, by)
                d.cham.Size         = Vector2.new(bw, bh)
                d.cham.Color        = boxC
                d.cham.Transparency = 0.55
                d.cham.Visible      = true
            elseif d.cham then
                d.cham.Visible = false
            end
        else
            d.hpBG.Visible  = false
            d.hpBar.Visible = false
            if d.hpText then d.hpText.Visible = false end
            if d.cham then d.cham.Visible = false end
        end
        if Cfg.ESPWeapon and d.weaponTag then
            local w = espWeaponName(model)
            if w ~= "" then
                d.weaponTag.Text     = w
                d.weaponTag.Position = Vector2.new(bx + bw * 0.5, by + bh + 2)
                d.weaponTag.Visible  = true
            else
                d.weaponTag.Visible = false
            end
        elseif d.weaponTag then
            d.weaponTag.Visible = false
        end
        if Cfg.ESPFlags and d.flagTag then
            local hum = getHumanoid(model)
            local flags = {}
            if hum and hum.Health <= 30 then table.insert(flags, "LOW") end
            if model:FindFirstChildOfClass("ForceField") then table.insert(flags, "IMMUNE") end
            if #flags > 0 then
                d.flagTag.Text     = table.concat(flags, " ")
                d.flagTag.Position = Vector2.new(bx + bw + 3, by)
                d.flagTag.Visible  = true
            else
                d.flagTag.Visible = false
            end
        elseif d.flagTag then
            d.flagTag.Visible = false
        end
        if Cfg.ESPSkeleton then
            paintESPSkeleton(d, model, cam, boxC)
        else
            for i = 1, 6 do
                local s = d["skel" .. i]
                if s then pcall(function() s.Visible = false end) end
            end
        end


        -- Distance label (below box)
        if Cfg.ESPDistance and root then
            d.distLabel.Text     = string.format("%.0f", dist)
            d.distLabel.Position = Vector2.new(bx + bw * 0.5, by + bh + 2)
            d.distLabel.Visible  = true
        else
            d.distLabel.Visible = false
        end


        -- Tracer
        if Cfg.ESPTracers and root then
            local sp, on = cam:WorldToViewportPoint(root.Position)
            if on then
                d.tracer.From    = Vector2.new(vp.X * 0.5, vp.Y)
                d.tracer.To      = Vector2.new(sp.X, sp.Y)
                d.tracer.Color   = tracerC
                d.tracer.Visible = true
            else
                d.tracer.Visible = false
            end
        else
            d.tracer.Visible = false
        end
    end
end


