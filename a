-- ?"??"? Bullet tracers (Misc): fading beams for every shot. Manual shots run
-- from the gun-side of the camera along the aim ray to its hit; ragebot
-- shots use their exact fire origin + aimed point.
-- v9 3D TRACERS: real Beams on anchored, non-colliding, non-querying parts
-- (CanQuery=false so they never block your own raycasts). p1 rides UNDER p0,
-- so destroying the root kills the pair. Capped at 24, oldest recycled.
function hubTracerBeam(fromPos, toPos)
    if not Cfg.TracerEnabled then return end
    pcall(function()
        if not (hubFiniteVec(fromPos) and hubFiniteVec(toPos)) then return end
        local len = (fromPos - toPos).Magnitude
        if not hubFiniteNum(len) or len < 1 or len > 2000 then return end
        local folder = Workspace:FindFirstChild("_HubTracers")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "_HubTracers"
            folder.Parent = Workspace
        end
        local kids = folder:GetChildren()
        if #kids >= 24 then
            local oldest, oldestT = nil, math.huge
            for _, c in ipairs(kids) do
                local ct = 0
                pcall(function() ct = c:GetAttribute("_HubT0") or 0 end)
                if ct < oldestT then oldest, oldestT = c, ct end
            end
            if oldest then pcall(function() oldest:Destroy() end) end
        end
        local col = Color3.fromRGB(Cfg.TracerColorR or 255, Cfg.TracerColorG or 210, Cfg.TracerColorB or 90)
        local w = 0.12 + (Cfg.TracerThick or 2) * 0.08
        local function mkPt(pos, nm)
            local p0 = Instance.new("Part")
            p0.Name = nm
            p0.Anchored = true
            p0.CanCollide = false
            p0.CanQuery = false
            p0.CanTouch = false
            p0.CastShadow = false
            p0.Transparency = 1
            p0.Size = Vector3.new(0.2, 0.2, 0.2)
            p0.CFrame = CFrame.new(pos)
            return p0
        end
        local p0 = mkPt(fromPos, "_HubTr")
        local p1 = mkPt(toPos, "_HubTrTip")
        local a0 = Instance.new("Attachment")
        a0.Parent = p0
        local a1 = Instance.new("Attachment")
        a1.Parent = p1
        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Color = ColorSequence.new(col)
        beam.Width0 = w
        beam.Width1 = w
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.Transparency = NumberSequence.new(0)
        beam.Parent = p0
        p1.Parent = p0
        p0.Parent = folder
        pcall(function() p0:SetAttribute("_HubT0", tick()) end)
    end)
end


