-- ?"??"? Shared: find the live Linoria window (windows are reborn every re-exec)
function findHubWindow()
    -- cached: the full CoreGui sweep runs once, then revalidates cheaply
    -- (destroyed windows lose Parent). Kills the multi-Hz sweeps from the
    -- veil sync + menu-open check.
    local cf = getgenv()._HubWinFrame
    if cf then
        local okV, valid = pcall(function()
            if cf.Parent == nil then return false end
            local tl = getgenv()._HubWinTitle
            if not (tl and tl.Parent ~= nil) then return false end
            local tx = tostring(tl.Text or "")
            return tx == "SHADE" or tx == "_HubShadeTitle" or string.find(tx, "Shade External", 1, true) ~= nil or string.find(tx, "SHADE", 1, true) ~= nil
        end)
        if okV and valid then return cf end
        getgenv()._HubWinFrame = nil
        getgenv()._HubWinTitle = nil
    end
    local ok, win = pcall(function()
        for _, g in ipairs(CoreGui:GetChildren()) do
            if g:IsA("ScreenGui") then
                for _, d in ipairs(g:GetDescendants()) do
                    if d:IsA("TextLabel") and (d.Text == "SHADE" or d.Name == "_HubShadeTitle" or string.find(tostring(d.Text or ""), "Shade External", 1, true) ~= nil or string.find(tostring(d.Text or ""), "SHADE", 1, true) ~= nil) then
                        local inner = d.Parent
                        local w = inner and inner.Parent
                        if w and w:IsA("GuiObject") then
                            getgenv()._HubWinFrame = w
                            getgenv()._HubWinTitle = d
                            return w
                        end
                    end
                end
            end
        end
        return nil
    end)
    if ok then return win end
    return nil
end


