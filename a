                        pcall(function()
                            TweenService:Create(g, TweenInfo.new(0.7,
                                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                                { Position = UDim2.new(g.Position.X.Scale, g.Position.X.Offset, 0, y) }):Play()
                        end)
                        task.wait(0.72)
                    end
                end)
            end
            return g
        end
        local gl = mk("_HubGhostL", false)
        local gr = mk("_HubGhostR", true)
        -- drip loop: each ghost cries a tiny ghost that falls curved, then gone.
        -- Toggle: Settings > Menu > Crying Ghosts. Dies with the hub.
        if Cfg.GhostCry ~= false and not getgenv()._HubGhostLoop and (gl or gr) then
            getgenv()._HubGhostLoop = true
            task.spawn(function()
                local side = false
                while getgenv()._RivalsHubV3Running and Cfg.GhostCry ~= false do
                    task.wait(0.9)
                    pcall(function()
                        local w2 = findHubWindow()
                        if not (w2 and w2.Visible) then return end
                        side = not side
                        local src = side and w2:FindFirstChild("_HubGhostR") or w2:FindFirstChild("_HubGhostL")
                        if not (src and src.Visible) then return end
                        local sx = src.AbsolutePosition.X + 15
                        local sy = src.AbsolutePosition.Y + 26
                        local dir = side and 1 or -1
                        local drop = Instance.new("TextLabel")
                        drop.Name = "_HubGDrop"
                        drop.BackgroundTransparency = 1
                        drop.Font = Enum.Font.GothamBlack
                        drop.TextSize = 12
                        drop.Text = "👻"
                        drop.TextTransparency = 0.2
                        drop.Active = false
                        drop.Size = UDim2.new(0, 16, 0, 16)
                        drop.ZIndex = 49
                        drop.Parent = w2
                        local p0x, p0y = sx, sy
                        local p1x, p1y = sx + dir * 46, sy + 26
                        local p2x, p2y = sx + dir * 30, sy + 86
                        task.spawn(function()
                            for i = 1, 14 do
                                local t2 = i / 14
                                local u = 1 - t2
                                local px = u * u * p0x + 2 * u * t2 * p1x + t2 * t2 * p2x
                                local py = u * u * p0y + 2 * u * t2 * p1y + t2 * t2 * p2y
                                pcall(function()
                                    local wp = w2.AbsolutePosition
                                    drop.Position = UDim2.new(0, px - wp.X, 0, py - wp.Y)
                                    drop.TextTransparency = 0.2 + t2 * 0.75
                                end)
                                task.wait(0.011)
                            end
                            pcall(function() drop:Destroy() end)
                        end)
                    end)
                end
                getgenv()._HubGhostLoop = false
            end)
        end
    end)
end


-- v14 TAB REORDER (browser-style drag): drag a main tab sideways past its
-- neighbour to swap them live; order saves and restores on boot. A tap
-- without dragging still selects normally. True tear-off needs a Linoria
-- fork (content lives in library containers), so this ships reorder.
function hubTabOrderInit()
    pcall(function()
        local win = findHubWindow()
        if not win then return end
        local names = { "Aimbot", "World", "ESP", "Visuals", "Weapons", "Players", "Misc", "Settings" }
        local want = {}
        for _, n in ipairs(names) do want[n] = true end
        local best, bestCount, seen = nil, 0, {}
        for _, d in ipairs(win:GetDescendants()) do
            if d:IsA("TextButton") and want[d.Text] then
                local par = d.Parent
                if par and not seen[par] then
                    seen[par] = true
                    local c = 0
                    for _, ch in ipairs(par:GetChildren()) do
                        if ch:IsA("TextButton") and want[ch.Text] then c += 1 end
                    end
                    if c > bestCount then best, bestCount = par, c end
                end
            end
        end
        if not (best and bestCount >= 3) then return end
        local lay = best:FindFirstChildOfClass("UIListLayout")
        if lay then pcall(function() lay.SortOrder = Enum.SortOrder.LayoutOrder end) end
        local btns = {}
        for _, ch in ipairs(best:GetChildren()) do
            if ch:IsA("TextButton") and want[ch.Text] then table.insert(btns, ch) end
        end
        local rank, r = {}, 0
        if Cfg.HubTabOrder ~= "" then
            for nm in string.gmatch(Cfg.HubTabOrder, "([^,]+)") do
                if want[nm] and not rank[nm] then r += 1 rank[nm] = r end
            end
        end
        table.sort(btns, function(a, b)
            local ra, rb = rank[a.Text] or 999, rank[b.Text] or 999
            if ra ~= rb then return ra < rb end
            return a.AbsolutePosition.X < b.AbsolutePosition.X
        end)
        for i, b in ipairs(btns) do
            b.LayoutOrder = i
            if not b._HubTabDrag then
                b._HubTabDrag = true
                local held, sx, moved = false, 0, false
                b.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                        held, sx, moved = true, inp.Position.X, false
                    end
                end)
                b.InputChanged:Connect(function(inp)
                    if not held then return end
                    if inp.UserInputType ~= Enum.UserInputType.MouseMovement
                        and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                    if math.abs(inp.Position.X - sx) < 10 and not moved then return end
                    moved = true
                    local all = {}
                    for _, ch in ipairs(best:GetChildren()) do
                        if ch:IsA("TextButton") and want[ch.Text] then table.insert(all, ch) end
                    end
                    table.sort(all, function(a, c) return a.LayoutOrder < c.LayoutOrder end)
                    for _, tb in ipairs(all) do
                        if tb ~= b then
                            local cx = tb.AbsolutePosition.X + tb.AbsoluteSize.X / 2
                            if (inp.Position.X > cx and tb.LayoutOrder < b.LayoutOrder)
                                or (inp.Position.X < cx and tb.LayoutOrder > b.LayoutOrder) then
                                local tmp = tb.LayoutOrder
                                tb.LayoutOrder = b.LayoutOrder
                                b.LayoutOrder = tmp
                                break
                            end
                        end
                    end
                end)
                b.InputEnded:Connect(function(inp)
                    if inp.UserInputType ~= Enum.UserInputType.MouseButton1
                        and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                    held = false
                    if not moved then return end
                    moved = false
                    local all = {}
                    for _, ch in ipairs(best:GetChildren()) do
                        if ch:IsA("TextButton") and want[ch.Text] then table.insert(all, ch) end
                    end
                    table.sort(all, function(a, c)
                        if a.LayoutOrder ~= c.LayoutOrder then return a.LayoutOrder < c.LayoutOrder end
                        return a.AbsolutePosition.X < c.AbsolutePosition.X
                    end)
                    local parts = {}
                    for i2, tb in ipairs(all) do
                        tb.LayoutOrder = i2
                        table.insert(parts, tb.Text)
                    end
                    Cfg.HubTabOrder = table.concat(parts, ",")
                    cfgSave()
                end)
            end
        end
    end)
end


