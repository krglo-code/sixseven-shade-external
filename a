-- ?"??"? Rage safety: spectator watch + staff watch. Spectators aren't directly
-- observable, so the watch counts dead/out-of-round players mid-duel (they
-- are the ones watching) plus explicit spectator teams. Staff reads the
-- same PlayerIcon attributes the spoof system uses (dev/employee).
function hubSpectators()
    local out = {}
    pcall(function()
        if not inDuel() then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local dead = true
                local m = p.Character
                local h = m and m:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then dead = false end
                local specTeam = false
                pcall(function()
                    local tn = p.Team and tostring(p.Team.Name or "") or ""
                    if string.find(string.lower(tn), "spect", 1, true) then specTeam = true end
                end)
                if dead or specTeam then table.insert(out, p) end
            end
        end
    end)
    return out
end


function hubStaffPresent()
    local found = nil
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local ic = nil
                pcall(function()
                    ic = p:GetAttribute("PlayerIcon") or p:GetAttribute("Icon")
                end)
                if type(ic) == "string" then
                    local l = string.lower(ic)
                    if l == "dev" or l == "employee" then found = p break end
                end
            end
        end
    end)
    return found
end


-- True when rage must hold fire right now. Warns on transitions only.
function hubRageSafetyHold()
    local hold = false
    local why, who = nil, nil
    pcall(function()
        if not inDuel() then return end
        if Cfg.RageSpecWarn or Cfg.RageSpecPause then
            local sp = hubSpectators()
            if #sp > 0 then
                who = sp[1]
                if Cfg.RageSpecPause then hold, why = true, "spectated" end
            end
        end
        if not hold and (Cfg.RageStaffWatch or Cfg.RageStaffPause) then
            local st = hubStaffPresent()
            if st then
                who = st
                if Cfg.RageStaffPause then hold, why = true, "staff" end
            end
        end
    end)
    pcall(function()
        local sig = why and (why .. ":" .. tostring((who and who.UserId) or "?")) or "clear"
        if sig ~= (getgenv()._HubSafetySig or "clear") then
            getgenv()._HubSafetySig = sig
            if why then
                local nm = who and tostring(who.DisplayName or who.Name) or "?"
                hubNotify((why == "staff" and "Staff in server: " or "Spectated by ") .. nm .. (hold and " - rage paused" or ""), 4)
            end
        end
    end)
    return hold
end


-- Miss-adaptive bone: whiff the same head 3+ times in 30s and the bot drops
-- to the torso until a hit lands. Streaks older than 30s don't count.
-- ?"??"? Rage spec engines (globals: zero chunk registers).
function rageSession(kind, dmg)
    local S = getgenv()._HubRageS
    if type(S) ~= "table" then
        S = { kills = 0, hits = 0, misses = 0, dmg = 0, t0 = tick() }
        getgenv()._HubRageS = S
    end
    if kind == "kill" then S.kills += 1
    elseif kind == "hit" then S.hits += 1 S.dmg += (dmg or 0)
    elseif kind == "miss" then S.misses += 1 end
    return S
end


function rageSessionText()
    local S = rageSession()
    local up = math.floor(tick() - (S.t0 or tick()))
    local tot = S.hits + S.misses
    local acc = tot > 0 and (S.hits / tot * 100) or 0
    return string.format("K:%d H:%d M:%d %.1f%% %d dmg %ds",
        S.kills, S.hits, S.misses, acc, math.floor(S.dmg), up)
end


function rageLogMiss(reason)
    rageSession("miss")
    if Cfg.RageMissLog then
        -- throttled: at fire rate this would be dozens of warns + file
        -- writes per second (real lag source). Counters keep every event.
        if (getgenv()._HubMissLogAt or 0) + 1.0 < tick() then
            getgenv()._HubMissLogAt = tick()
            warn("[Rage] miss: " .. tostring(reason))
        end
    end
end


function rageLogFire(dmg)
    rageSession("hit", dmg or 0)
    if Cfg.RageFireLog then
        if (getgenv()._HubFireLogAt or 0) + 1.0 < tick() then
            getgenv()._HubFireLogAt = tick()
            warn(string.format("[Rage] fire %.2f dmg %.1f", tick(), dmg or 0))
        end
    end
end


