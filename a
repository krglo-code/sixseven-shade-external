--[[
  CLIENT-SIDE HITBOX EXPANSION - FIXED VERSION
  ---------------------------------------------
  The WRONG approach (used in v2): part.Size = part.Size + BigVector
    -> makes the body visually huge. Transparency doesn't help because it
      also affects the hitbox collision visual debug and looks terrible.


  THE RIGHT APPROACH:
    We create an INVISIBLE BasePart (LocalHitboxExpander) parented to the
    character that is WELDED to each hitbox part. It is:
      - Transparency = 1          (completely invisible)
      - CanCollide = false        (no physics interaction)
      - CastShadow = false
      - Massless = true
      - Not CanTouch = false
    Size is set to the expansion amount.
    On each enemy character, we weld one large invisible sphere-like box
    centered on the HumanoidRootPart. This expands the client-side hit
    detection surface without touching the visible character at all.


  This is how all major Roblox clients implement silent aim expansion.
  The visual size of the character parts is NOT changed.
]]


_silentConns     = {}
_expandedChars   = {}  -- [character] = {parts}


function collapseHitboxWatchers()
    for _, c in ipairs(_silentConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(_silentConns)
end


function removeExpandersFromChar(char)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name == "_HubHitboxExpander" then
            pcall(function() d:Destroy() end)
        end
        if d:IsA("WeldConstraint") and d.Name == "_HubHitboxWeld" then
            pcall(function() d:Destroy() end)
        end
    end
    _expandedChars[char] = nil
end


function expandCharacter(char)
    if not char then return end
    if _expandedChars[char] then return end  -- already expanded


    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end


    local expand = Cfg.SilentHitboxSize


    -- Create one large invisible box welded to the root
    local expander = Instance.new("Part")
    expander.Name          = "_HubHitboxExpander"
    expander.Size          = Vector3.new(expand, expand * 2, expand)
    expander.Transparency  = 1
    expander.CanCollide    = false
    expander.CanQuery      = false
    expander.CanTouch      = false
    expander.CastShadow    = false
    expander.Massless      = true
    expander.Anchored      = false
    expander.CFrame        = root.CFrame
    expander.Parent        = char


    local weld = Instance.new("WeldConstraint")
    weld.Name   = "_HubHitboxWeld"
    weld.Part0  = root
    weld.Part1  = expander
    weld.Parent = char


    _expandedChars[char] = true
end


function applyHitboxExpansion()
    collapseHitboxWatchers()


    -- Remove all existing expanders
    for char in pairs(_expandedChars) do
        removeExpandersFromChar(char)
    end
    table.clear(_expandedChars)


    if not Cfg.SilentEnabled then return end


    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if p.Character then
            task.spawn(expandCharacter, p.Character)
        end
        local c1 = p.CharacterAdded:Connect(function(ch)
            task.wait(0.4)
            expandCharacter(ch)
        end)
        table.insert(_silentConns, c1)
        local c2 = p.CharacterRemoving:Connect(function(ch)
            removeExpandersFromChar(ch)
        end)
        table.insert(_silentConns, c2)
    end


    local c3 = Players.PlayerAdded:Connect(function(p)
        if p == LP then return end
        local ca = p.CharacterAdded:Connect(function(ch)
            task.wait(0.4)
            expandCharacter(ch)
        end)
        table.insert(_silentConns, ca)
        local cr = p.CharacterRemoving:Connect(function(ch)
            removeExpandersFromChar(ch)
        end)
        table.insert(_silentConns, cr)
    end)
    table.insert(_silentConns, c3)
end


-- ?"??"? SILENT AIM (namecall redirect, from the pasted universal script ??"
-- rebuilt on hub Cfg so it never fights the hitbox expanders above).
-- Methods: Raycast / FindPartOnRay* redirect the shot ray at the closest
-- enemy part inside SilentFOV; Mouse.Hit/Target answers with the target.
-- Chain-safe: wraps whatever __namecall/__index hook is live (skins +
-- device spoof) and forwards everything else untouched.
SILENT_EXPECTED = {
    FindPartOnRayWithIgnoreList = { n = 3, t = { "Instance", "Ray", "table", "boolean", "boolean" } },
    FindPartOnRayWithWhitelist = { n = 3, t = { "Instance", "Ray", "table", "boolean" } },
    FindPartOnRay = { n = 2, t = { "Instance", "Ray", "Instance", "boolean", "boolean" } },
    Raycast = { n = 3, t = { "Instance", "Vector3", "Vector3", "RaycastParams" } },
}


function silentArgsOK(args, spec)
    if #args < spec.n then return false end
    local m = 0
    for i, want in ipairs(spec.t) do
        if typeof(args[i]) == want then m += 1 end
    end
    return m >= spec.n
end


function silentChanceOK()
    local hc = Cfg.AimHitChance or 100
    if hc >= 100 then return true end
    return math.random(1, 100) <= hc
end


function silentScreenPos(cam, pos)
    local s, on = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on
end


function silentClosestPart(cam)
    if not Cfg.SilentEnabled then return nil end
    local mouse = UserInputService:GetMouseLocation()
    local best, bestD = nil, Cfg.SilentFOV or 130
    local selfChar = LP.Character
    local ignoreLOS = { selfChar, cam }
    local wantPart = Cfg.SilentTargetPart or "Head"
    local function consider(model)
        if not modelAlive(model) then return end
        local pl = nil
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character == model then pl = p break end
            end
        end)
        if Cfg.AimTeamCheck and pl and not isEnemy(pl) then return end
        -- v14: hold fire through parry windows (shared deflect map + buffer)
        if pl and isDeflecting(pl) then return end
        local part = nil
        if wantPart == "Random" then
            local pool = { headOf(model), torsoOf(model) }
            part = pool[math.random(1, 2)]
        elseif wantPart == "HumanoidRootPart" then
            part = model:FindFirstChild("HumanoidRootPart") or headOf(model)
        elseif wantPart == "UpperTorso" then
            part = model:FindFirstChild("UpperTorso") or torsoOf(model)
        else
            part = headOf(model)
        end
        if not part then return end
        local pos = part.Position
        if Cfg.SilentPrediction then
            -- v14: lead from HRP velocity (stable), not the bobbing head part
            local vel = Vector3.zero
            pcall(function()
                local hrp = model:FindFirstChild("HumanoidRootPart")
                vel = (hrp or part).AssemblyLinearVelocity
            end)
            pos = pos + vel * (Cfg.SilentPredAmount or 0.165)
        end
        local sp, on = silentScreenPos(cam, pos)
        if not on then return end
        local d = (mouse - sp).Magnitude
        if d > bestD then return end
        if Cfg.AimWallCheck or Cfg.AimVisibleOnly then
            if not losClear(cam, pos, model, ignoreLOS) then return end
        end
        best, bestD = part, d
    end
    local fc = getFC()
    if fc and type(fc.Objects) == "table" then
        for _, fObj in pairs(fc.Objects) do
            if type(fObj) ~= "table" or fObj.IsLocalPlayer or fObj._destroyed then continue end
            local entity = fObj.Entity
            local model = type(entity) == "table"
                and typeof(entity.Model) == "Instance" and entity.Model
            if model then consider(model) end
        end
    end
    if not best then
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if p.Character then consider(p.Character) end
        end
    end
    return best
end


-- v14 humanizer: tiny random world offset per snap (never pixel-perfect)
function hubSilentJitter()
    local j = (Cfg.SilentJitter or 0) / 100 * 0.5
    if j <= 0 then return Vector3.new(0, 0, 0) end
    return Vector3.new((math.random() - 0.5) * 2 * j,
        (math.random() - 0.5) * 2 * j, (math.random() - 0.5) * 2 * j)
end


function silentDir(origin, pos)
    return (pos - origin).Unit * 1000
end


function applySilentAim()
    -- visuals: FOV ring + target marker follow hub paint cadence
    pcall(function()
        local ring = aimDraw("silFov", "Circle")
        if ring then
            ring.Visible = (Cfg.SilentEnabled and Cfg.SilentShowFOV and not hubMenuOpen()) or false
            if ring.Visible then
                local ml = UserInputService:GetMouseLocation()
                ring.Position = ml
                ring.Radius = Cfg.SilentFOV or 130
                ring.Color = Color3.fromRGB(Cfg.AimFOVColorR, Cfg.AimFOVColorG, Cfg.AimFOVColorB)
                ring.Thickness = 1.5
                ring.Filled = false
                ring.Transparency = 1
            end
        end
    end)
    if getgenv()._HubSilentHooked then return end
    getgenv()._HubSilentHooked = true
    pcall(function()
        local oldNc
        oldNc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local m = getnamecallmethod()
            local gated = Cfg.SilentEnabled and not checkcaller()
                and self == Workspace and silentChanceOK()
            if gated then
                local method = Cfg.SilentMethod or "Raycast"
                local args = { ... }
                if (m == "FindPartOnRayWithIgnoreList" and method == m)
                    or (m == "FindPartOnRayWithWhitelist" and method == m)
                    or ((m == "FindPartOnRay" or m == "findPartOnRay") and string.lower(method) == string.lower(m))
                    or (m == "Raycast" and method == m) then
                    local spec = SILENT_EXPECTED[m == "findPartOnRay" and "FindPartOnRay" or m]
                    if spec and silentArgsOK(args, spec) then
                        local cam = Workspace.CurrentCamera
                        local hit = cam and silentClosestPart(cam)
                        if hit then
                            if m == "Raycast" then
                                args[3] = silentDir(args[2], hit.Position + hubSilentJitter())
                            else
                                local ray = args[2]
                                args[2] = Ray.new(ray.Origin, silentDir(ray.Origin, hit.Position + hubSilentJitter()))
                            end
                            return oldNc(unpack(args))
                        end
                    end
                end
            end
            return oldNc(self, ...)
        end))
        getgenv()._HubSilentOldNc = oldNc
        local oldIdx
        oldIdx = hookmetamethod(game, "__index", newcclosure(function(self, k)
            if Cfg.SilentEnabled and not checkcaller()
                and (Cfg.SilentMethod or "") == "Mouse.Hit/Target" then
                local okM, mouse = pcall(function() return LP and LP:GetMouse() end)
                if okM and self == mouse then
                    local cam = Workspace.CurrentCamera
                    local hit = cam and silentClosestPart(cam)
                    if hit then
                        if k == "Target" or k == "target" then return hit end
                        if k == "Hit" or k == "hit" then
                            local jp = hit.Position + hubSilentJitter()
                            if Cfg.SilentPrediction then
                                local vel = Vector3.zero
                                pcall(function()
                                    local hm = hit.Parent
                                    local hrp = hm and hm:FindFirstChild("HumanoidRootPart")
                                    vel = (hrp or hit).AssemblyLinearVelocity
                                end)
                                return CFrame.new(jp + vel * (Cfg.SilentPredAmount or 0.165))
                            end
                            return CFrame.new(jp)
                        end
                    end
                end
            end
            return oldIdx(self, k)
        end))
        getgenv()._HubSilentOldIdx = oldIdx
    end)
    -- per-frame marker on the current silent target
    task.spawn(function()
        while getgenv()._HubSilentHooked do
            task.wait(0.05)
            pcall(function()
                local box = aimDraw("silBox", "Square")
                if not box then return end
                local cam = Workspace.CurrentCamera
                local show = Cfg.SilentEnabled and Cfg.SilentShowTarget and cam
                    and not hubMenuOpen()
                local hit = show and silentClosestPart(cam) or nil
