        getgenv()._HubEquipCur = cur
        local w = (Cfg.WeaponSkipMode == "This Weapon") and tostring(Cfg.WeaponTabWeapon or "") or ""
        if cur and cur ~= "" and (w == "" or string.lower(cur) == string.lower(w)) then
