-- ?"??"? v15 SECRET INSPECT: fires the equipped weapon's own inspect path
-- (item method first, then a game inspect remote scan, shops excluded),
-- then rides matching animation tracks at your 0-100% speed scale.
function hubSecretInspect()
    local fc = getFC()
    local lf = fc and fc.LocalFighter
    local it = lf and lf.EquippedItem
    if not it then hubNotify("Inspect: no weapon equipped", 2, "miss") return end
    local fired = false
    for _, m in ipairs({ "Inspect", "StartInspect", "TryInspect", "PlayInspect", "BeginInspect" }) do
        if type(it[m]) == "function" then
            if pcall(function() return it[m](it) end) then fired = true break end
        end
    end
    if not fired then
        pcall(function()
            for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
                local okE = false
                pcall(function() okE = d:IsA("RemoteEvent") end)
                if okE then
                    local nm = string.lower(d.Name or "")
                    if string.find(nm, "nspect", 1, true)
                        and not string.find(nm, "buy", 1, true)
                        and not string.find(nm, "shop", 1, true)
                        and not string.find(nm, "price", 1, true) then
                        d:FireServer()
                        fired = true
                    end
                end
            end
        end)
    end
    if not fired then
        -- v18: play the game's own inspect animation straight onto your rig:
        -- first Animation object with inspect in the name, client-side visual
        pcall(function()
            local foundA = nil
            for _, root in ipairs({ ReplicatedStorage, LP.PlayerScripts, LP.PlayerGui }) do
                if foundA then break end
                if root then
                    for _, d in ipairs(root:GetDescendants()) do
                        local okA = false
                        pcall(function() okA = d:IsA("Animation") end)
                        if okA and string.find(string.lower(d.Name or ""), "nspect", 1, true) then
                            foundA = d
                            break
                        end
                    end
                end
            end
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local an = hum and hum:FindFirstChildOfClass("Animator")
            if foundA and an then
                local tr = an:LoadAnimation(foundA)
                tr.Priority = Enum.AnimationPriority.Action
                tr:Play(0.15, 1, (Cfg.InspectSpeed or 100) / 100)
                fired = true
            end
        end)
    end
    if fired then
        getgenv()._HubInspectAt = tick()
        hubNotify("Inspecting " .. tostring(it.Name or ""), 2, "hit")
    else
        hubNotify("Inspect: no inspect path on this weapon", 3, "miss")
    end
end


