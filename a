    -- auto-bone: whichever hittable part sits closest to the crosshair wins
    if Cfg.AimAutoBone and cam then
        local cx = cam.ViewportSize.X / 2
        local cy = cam.ViewportSize.Y / 2
        local bestP, bestD = nil, math.huge
        for _, n in ipairs({ "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Torso" }) do
            if aimBlacklisted(n) then continue end
            local p = model:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                local sp, on = cam:WorldToViewportPoint(p.Position)
                if on then
                    local d = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
                    if d < bestD then bestD, bestP = d, p end
                end
            end
        end
        if bestP then return bestP end
    end
    if Cfg.AimBoneAuto then
        local root = model:FindFirstChild("HumanoidRootPart")
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local d = (root and myRoot) and (root.Position - myRoot.Position).Magnitude or 0
        if d >= (Cfg.AimBoneDistSwitch or 40) then return torsoOf(model) end
        return headOf(model)
    end
    return aimBoneOf(model, cam)
end


