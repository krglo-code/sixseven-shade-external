function patchItem(item, nowTick, slotNum)
    if type(item) ~= "table" or item._destroyed then return end
    if Cfg.WeaponNoSpread then hubZeroSpread(item) end
    -- v9 No Recoil: runs before + independent of the cooldown weapon scope
    if Cfg.WeaponNoRecoil or Cfg.WeaponNoRecoilThis then
        local doRec = Cfg.WeaponNoRecoil and true or false
        if not doRec and type(Cfg.WeaponNoRecoilList) == "table" and item.Name then
            doRec = Cfg.WeaponNoRecoilList[tostring(item.Name)] and true or false
        end
        if doRec then hubZeroRecoil(item) end
    end
    -- weapon scope: No Cooldown Weapon dropdown limits the patch to one
    -- weapon by name ("All" = every weapon). Slot limits were removed.
    local onlyW = Cfg.WeaponNoCDWeaponName or "All"
    if onlyW ~= "" and onlyW ~= "All" then
        local wn = ""
        pcall(function() wn = tostring(item.Name or "") end)
        if string.lower(wn) ~= string.lower(tostring(onlyW)) then return end
    end


    local doSweep = (nowTick - _lastInfoSweep) > INFO_SWEEP_INTERVAL
    if doSweep then _lastInfoSweep = nowTick end


    if item.Info and type(item.Info) == "table" and doSweep then
        for _, k in ipairs(INFO_ZERO_FIELDS) do
            if type(item.Info[k]) == "number" and item.Info[k] ~= 0 then
                item.Info[k] = 0
            end
        end
    end


    for _, k in ipairs(LIVE_ZERO_FIELDS) do
        if item[k] ~= nil and item[k] ~= 0 then item[k] = 0 end
    end


    -- Generic sweep: ANY numeric field with "cooldown" in the name. This is what
    -- covers utility + right-click abilities without a per-weapon list:
    -- War Horn _use_cooldown, Flamethrower _airblast_cooldown, etc.
    -- (verified live ??" these are tick() timestamps, so 0 = ready.)
    -- _reload_cooldown deliberately excluded: the reload guard below owns it.
    -- Cached: key names never change, only values do ??" the string scan runs
    -- once per item shape (weak-keyed, auto-freed with dead items) instead of
    -- every frame, then each frame is pure direct writes.
    do
        local reg = getgenv()._HubCooldownKeys
        if type(reg) ~= "table" then
            reg = setmetatable({}, { __mode = "k" })
            getgenv()._HubCooldownKeys = reg
        end
        local e = reg[item]
        local n = 0
        for _ in pairs(item) do n += 1 end
        if (not e) or e.n ~= n or (nowTick - (e.t or 0)) > 5 then
            local keys = {}
            for k, v in pairs(item) do
                if type(v) == "number" and v ~= 0 and k ~= "_reload_cooldown" then
                    local kl = string.lower(tostring(k))
                    if string.find(kl, "cooldown", 1, true) then
                        table.insert(keys, k)
                    end
                end
            end
            e = { n = n, t = nowTick, keys = keys }
            reg[item] = e
        end
        for _, k in ipairs(e.keys) do
            if item[k] ~= nil and item[k] ~= 0 then item[k] = 0 end
        end
    end


    -- Weapons-tab per-cooldown removal (scope / ability / rightclick).
    if Cfg.WeaponNoScopeCD then
        if item._scope_cooldown ~= nil then item._scope_cooldown = 0 end
        if item._zoom_cooldown ~= nil then item._zoom_cooldown = 0 end
    end
    if Cfg.WeaponNoAbilityCD then
        if item._ability_cooldown ~= nil then item._ability_cooldown = 0 end
        if item._use_cooldown ~= nil then item._use_cooldown = 0 end
    end
    if Cfg.WeaponNoRightClickCD then
        if item._secondary_fire_cooldown ~= nil then item._secondary_fire_cooldown = 0 end
    end
    -- Per-weapon no-cooldown list (Weapons tab): same treatment as All.
    if type(Cfg.WeaponNoCDList) == "table" and item.Name
        and Cfg.WeaponNoCDList[tostring(item.Name)] then
        for _, k in ipairs({ "_scope_cooldown", "_zoom_cooldown", "_ability_cooldown",
            "_use_cooldown", "_secondary_fire_cooldown", "_parry_cooldown" }) do
            if item[k] ~= nil then item[k] = 0 end
        end
    end


    -- Reload-aware: while the game is mid-reload, leave its reload state alone
    -- (zeroing cooldowns + force-filling ammo here is what broke manual reload:
    -- the reload cycle never completes and the weapon gets stuck).
    local reloading = (item._reload_cooldown ~= nil and item._reload_cooldown > nowTick)
        or item._reloading == true


    if reloading then return end


    -- Ammo untouched: no reserve top-ups, no mag fills. Reloads run vanilla.
end


