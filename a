-- Key name ??' Enum.KeyCode or Enum.UserInputType
function parseAimKey(keyName)
    if keyName == "MB2" then return Enum.UserInputType.MouseButton2 end
    if keyName == "MB1" then return Enum.UserInputType.MouseButton1 end
    local ok, e = pcall(function() return Enum.KeyCode[keyName] end)
    if ok and e then return e end
    return nil
end


function aimHeld()
    if Cfg.AimAlwaysOn then return true end
    if (Cfg.AimKeyMode or "Hold") == "Always" then return true end
    if Cfg.AimToggle and getgenv()._HubAimToggled then return true end
    if getgenv()._HubMobileAimHeld then return true end
    -- input APIs throw on some executors/devices: never let a key read kill
    -- the render loop (one throw here used to abort the whole frame)
    local ok, held = pcall(function()
        local parsed = parseAimKey(Cfg.AimKey)
        local h = false
        if parsed and typeof(parsed) == "EnumItem" then
            if parsed.EnumType == Enum.KeyCode then
                h = UserInputService:IsKeyDown(parsed)
            elseif parsed.EnumType == Enum.UserInputType then
                h = UserInputService:IsMouseButtonPressed(parsed)
            end
        end
        if not h and (Cfg.AimKey2 or "") ~= "" then
            local p2 = parseAimKey(Cfg.AimKey2)
            if p2 and typeof(p2) == "EnumItem" then
                if p2.EnumType == Enum.KeyCode then
                    h = UserInputService:IsKeyDown(p2)
                elseif p2.EnumType == Enum.UserInputType then
                    h = UserInputService:IsMouseButtonPressed(p2)
                end
            end
        end
        return h
    end)
    return ok and held or false
end


function aimKeyActive()
    if Cfg.AimAlwaysOn then return true end
    if (Cfg.AimKeyMode or "Hold") == "Always" then return true end
    if Cfg.AimToggle and getgenv()._HubAimToggled then return true end
    if getgenv()._HubMobileAimHeld then return true end
    return aimHeld()
end


