end


function hideESP(d)
    d.box.Visible       = false
    pcall(function() d.outline.Visible = false end)
    for i = 1, 8 do pcall(function() d["corner" .. i].Visible = false end) end
    for i = 1, 6 do pcall(function() d["skel" .. i].Visible = false end) end
    pcall(function() d.hpText.Visible = false end)
    pcall(function() d.weaponTag.Visible = false end)
    pcall(function() d.flagTag.Visible = false end)
    pcall(function() d.cham.Visible = false end)
    pcall(function() d.ring.Visible = false end)
    pcall(function() d.glow.Visible = false end)
    pcall(function() d.headDot.Visible = false end)
    d.boxFill.Visible   = false
