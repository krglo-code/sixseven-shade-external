local _okAimKp, _errAimKp = pcall(function()
AimGroup:AddLabel("Aim Keybind"):AddKeyPicker("AimKeybind", {
    Default = "MB2",
    Mode = "Toggle",
    Text = "Aim key",
    Callback = function() end,
    ChangedCallback = function(new)
        local mapped = nil
        if typeof(new) == "EnumItem" then
            if new.EnumType == Enum.UserInputType then
                if new == Enum.UserInputType.MouseButton1 then mapped = "MB1"
                elseif new == Enum.UserInputType.MouseButton2 then mapped = "MB2" end
            elseif new.EnumType == Enum.KeyCode then
                mapped = new.Name
            end
        end
        if mapped then
            Cfg.AimKey = mapped
            pcall(function() Library:Notify("Aim key: " .. mapped, 2) end)
        end
    end,
})
end)
if not _okAimKp then bootWarn("Aim keybind", _errAimKp) end


