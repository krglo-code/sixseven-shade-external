-- Fly-follow: hover in front of the enemy at head height, strafing
-- left/right + forward drift on a loop, face locked onto their head.
-- Persistent (no per-shot restore); rageFlyRestore parks you back on
-- target loss, toggle-off, or duel end.
local function rageFlyTick(targetPlayer, targetRoot, targetHead)
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not (myRoot and targetRoot and targetHead) then return false end
    local t = tick()
    local orbit = Vector3.new(math.sin(t * 2.1) * 6, 0, math.cos(t * 1.3) * 3)
    local want = targetHead.Position
        + Vector3.new(targetRoot.CFrame.LookVector.X, 0, targetRoot.CFrame.LookVector.Z).Unit * 7
        + Vector3.new(0, 1.5, 0) + orbit
    if want.Y < rageKillFloor() + 6 then want = Vector3.new(want.X, rageKillFloor() + 6, want.Z) end
    if not getgenv()._HubFlyHome then
        getgenv()._HubFlyHome = myRoot.CFrame
    end
    myRoot.CFrame = CFrame.lookAt(want, targetHead.Position)
    myRoot.Velocity = Vector3.zero
    myRoot.RotVelocity = Vector3.zero
    return true
end


