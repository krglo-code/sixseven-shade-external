                for _, c in ipairs(slot:GetDescendants()) do
                    if c:IsA("TextLabel") and c.Name == "Title" and isOwnName(c.Text) then
                        ownSlot = true
                        break
                    end
                end
                if ownSlot then
                    for _, c in ipairs(slot:GetDescendants()) do
                        local isIcon = false
                        pcall(function()
                            isIcon = (c:IsA("ImageLabel") or c:IsA("ImageButton"))
                                and string.find(string.lower(c.Name or ""), "icon", 1, true) ~= nil
                        end)
                        if isIcon then
                            pcall(function()
                                if c.Image ~= img then c.Image = img end
                            end)
                        end
                    end
                end
            end
        end
    end)
end


function spoofPlayerSlot()
