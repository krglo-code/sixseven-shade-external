            local bc = t.back or { 20, 20, 20 }
            grad.BackgroundColor3 = Color3.fromRGB(bc[1], bc[2], bc[3])
            grad.BackgroundTransparency = Cfg.BgTransparency or 0
            for _, ch in ipairs(grad:GetChildren()) do
                if ch:IsA("UIGradient") then ch:Destroy() end
            end
        end)
    end
    -- layer 2: your own picture on top (file or asset id), if you set one.
    local img = resolveMenuBG()
    local old = host:FindFirstChild("_HubBG")
    if not img then
