function hubSetFeature(def, v)
    v = v and true or false
    local opts = getgenv().Options
    if opts then
        for _, flag in ipairs(def.opts or {}) do
            local o = opts[flag]
            if o and o.SetValue then
                pcall(function() o:SetValue(v) end)
            end
        end
    end
    cfgSave()
end


function hubKeyName(e)
    if typeof(e) == "EnumItem" then
        if e.EnumType == Enum.KeyCode then return e.Name end
        if e.EnumType == Enum.UserInputType then
            if e == Enum.UserInputType.MouseButton1 then return "MB1" end
            if e == Enum.UserInputType.MouseButton2 then return "MB2" end
            if e == Enum.UserInputType.MouseButton3 then return "MB3" end
            return e.Name
        end
    end
    return tostring(e)
end


function hubHotkeyRow(group, def)
    group:AddLabel(def.label):AddKeyPicker(def.id, {
        Default = tostring(Cfg[def.cfg] or "?"),
        Mode = "Toggle",
        Text = def.label,
        Callback = function(s) hubSetFeature(def, s) end,
        ChangedCallback = function(e)
            Cfg[def.cfg] = hubKeyName(e)
            cfgSave()
        end,
    })
end


