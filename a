-- hubScrollTop: resets the column scroll frame(s) after a tab switch.
-- Finds the ScrollingFrame by climbing from the tab's BoxOuter, so hidden
-- tabs / dragged windows can never mis-identify left vs right.
function hubScrollTop(side)
    pcall(function()
        local tL = getgenv()._HubTabL
        local tR = getgenv()._HubTabR
        local tabs = {}
        if side == "Left" then
            local pg = getgenv()._HubMainPageL or "Rage"
            if tL and tL[pg] then table.insert(tabs, tL[pg]) end
        elseif side == "Right" then
            local pg = getgenv()._HubMainPageR or "Aimbot"
            if tR and tR[pg] then table.insert(tabs, tR[pg]) end
        else
            local pl = getgenv()._HubMainPageL or "Rage"
            local pr = getgenv()._HubMainPageR or "Aimbot"
            if tL and tL[pl] then table.insert(tabs, tL[pl]) end
            if tR and tR[pr] then table.insert(tabs, tR[pr]) end
        end
        local seen = {}
        for _, tab in ipairs(tabs) do
            local boxOuter = tab.Container and tab.Container.Parent
                and tab.Container.Parent.Parent or nil
            local cur = boxOuter and boxOuter.Parent or nil
            local guard = 0
            while cur and guard < 6 do
                guard += 1
                local isScroll = false
                pcall(function() isScroll = cur:IsA("ScrollingFrame") end)
                if isScroll then
                    if not seen[cur] then
                        seen[cur] = true
                        pcall(function() cur.CanvasPosition = Vector2.zero end)
                    end
                    break
                end
                pcall(function() cur = cur.Parent end)
            end
        end
    end)
end


