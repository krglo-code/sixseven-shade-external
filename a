            grad = Instance.new("Frame")
            grad.Name = "_HubBGGrad"
            grad.BorderSizePixel = 0
            grad.Size = UDim2.new(1, 0, 1, 0)
            grad.Position = UDim2.new(0, 0, 0, 0)
            grad.ZIndex = 0
            grad.Parent = host
        end
