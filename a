-- Slider fill rescale: Linoria hardcodes fill to 232px, but this window is
-- wider (real tracks ~353px), so every slider maxed out mid-track. Measure
-- the live window and rescale ALL sliders to the true track width.
function hubFixSliderScale()
    pcall(function()
        local win = findHubWindow()
        if not win then return end
        local w = win.AbsoluteSize.X
        if w < 100 then return end
        local maxSize = math.floor(w * 0.5 - 37)
        if maxSize < 50 then return end
        if getgenv()._HubSliderFixed == maxSize then return end
        getgenv()._HubSliderFixed = maxSize
        local opts = getgenv().Options
        if type(opts) ~= "table" then return end
        for _, o in pairs(opts) do
            if type(o) == "table" and o.Type == "Slider" and o.Display then
                o.MaxSize = maxSize
                pcall(function() o:Display() end)
            end
        end
    end)
end


