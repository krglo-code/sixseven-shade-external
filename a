-- Chevrons: groups with 5+ controls get a More/Less collapse pill.
function autoMainChevrons()
    if Cfg.ChevronEnabled == false then return end
    local reg = getgenv()._HubMainGroups or {}
    local done = getgenv()._HubChev or {}
    getgenv()._HubChev = done
    for _, set in pairs(reg) do
        for _, g in ipairs(set) do
            pcall(function()
                if done[g] then return end
                done[g] = true
                local c = g.Container
                if not c then return end
                local kids = {}
                for _, ch in ipairs(c:GetChildren()) do
                    if ch:IsA("GuiObject") and ch.Visible then
                        table.insert(kids, ch)
                    end
                end
                if #kids <= 5 then return end
                local collapsed = false
                local btnHolder = {}
                local btn = g:AddButton({ Text = "More +", Func = function()
                    collapsed = not collapsed
                    local bo = btnHolder[1] and btnHolder[1].Outer or nil
                    local n = 0
                    for _, ch in ipairs(c:GetChildren()) do
                        if ch:IsA("GuiObject") and ch ~= bo then
                            n += 1
                            if n > 5 then
                                pcall(function() ch.Visible = not collapsed end)
                            end
                        end
                    end
                    local b = btnHolder[1]
                    pcall(function()
                        if b and b.Label then
                            b.Label.Text = collapsed and "More +" or "Less -"
                        end
                    end)
                    -- Shrink/grow the frame to the rows actually shown.
                    -- Without this the box keeps its full height and the tab
                    -- shows a huge empty gap with broken scrolling.
                    if type(g.Resize) == "function" then pcall(function() g:Resize() end) end
                    pcall(function()
                        if type(hubResizeAimTabs) == "function" then hubResizeAimTabs() end
                    end)
                end })
                btnHolder[1] = btn
                local outer = btn and btn.Outer or nil
                -- start collapsed: click More to expand (button never hides)
                pcall(function()
                    local n = 0
                    for _, ch in ipairs(c:GetChildren()) do
                        if ch:IsA("GuiObject") and ch ~= outer then
                            n += 1
                            if n > 5 then ch.Visible = false end
                        end
                    end
                end)
                collapsed = true
                if type(g.Resize) == "function" then pcall(function() g:Resize() end) end
                pcall(function()
                    if type(hubResizeAimTabs) == "function" then hubResizeAimTabs() end
                end)
            end)
        end
    end
end


-- NATIVE TABBOX: move every Aim groupbox INSIDE its Tab.Container.
-- Before this, tabs were empty and groupboxes sat loose in the column with
-- custom Visible paging (the source of one-side-works gaps + scroll breaks).
-- After this, Linoria owns visibility: Show/Hide flips Container.Visible and
-- Tab:Resize() sizes the tabbox. All four pages behave identically.
pcall(function()
    local tL = getgenv()._HubTabL
    local tR = getgenv()._HubTabR
    local reg = getgenv()._HubMainGroups or {}
    local function moveInto(tab, groups)
        if type(tab) ~= "table" or not tab.Container then return end
        for i, g in ipairs(groups or {}) do
            pcall(function()
                local boxOut = hubGroupBoxOuter(g)
                if boxOut then
                    boxOut.Parent = tab.Container
                    boxOut.LayoutOrder = i
                    boxOut.Visible = true
                    if type(g.Resize) == "function" then g:Resize() end
                end
            end)
        end
        pcall(function() tab:Resize() end)
    end
    if tL then
        moveInto(tL.Rage, reg.Rage)
        moveInto(tL.Trigger, reg.Trigger)
    end
    if tR then
        moveInto(tR.Aimbot, reg.Aimbot)
        moveInto(tR.Silent, reg.Silent)
    end
end)
