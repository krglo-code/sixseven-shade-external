-- Deflect/parry hold map, shared by aimbot + triggerbot + ragebot.
-- Filled by updateDeflectionMap (?22); values are timestamps (tick-based),
-- so a katana parry stays dangerous briefly past its own window.
_deflecting = {}
_lastDeflSweep = 0


function isDeflecting(pl)
    local untilT = pl and _deflecting[pl]
    return untilT ~= nil and type(untilT) == "number" and untilT > tick()
end


function updateDeflectionMap()
    if tick() - (_lastDeflSweep or 0) < 0.25 then return end
    _lastDeflSweep = tick()
    local fc = getFC()
    if not fc or type(fc.Objects) ~= "table" then return end
    local now = tick()
    for _, fObj in pairs(fc.Objects) do
        if type(fObj) ~= "table" then continue end
        local pl = fObj.Player
        if not pl or pl == LP then continue end
        -- IsAlive shape varies per build (fn vs bool vs missing): never let
        -- one odd fighter object throw and abort the whole target sweep
        if type(fObj.Entity) == "table" and type(fObj.Entity.IsAlive) == "function" then
            local okA, alive = pcall(function() return fObj.Entity:IsAlive() end)
            if okA and not alive then
                _deflecting[pl] = nil
                continue
            end
        end
        local eq = fObj.EquippedItem
        if type(eq) ~= "table" then
            if _deflecting[pl] and _deflecting[pl] <= now then _deflecting[pl] = nil end
            continue
        end
        -- katana in hand? (ViewModel name or item name, case-insensitive)
        local vm = ""
        pcall(function()
            vm = tostring((eq.ViewModel and eq.ViewModel.Name) or eq.Name or "")
        end)
        if not string.find(string.lower(vm), "katana", 1, true) then
            if _deflecting[pl] and _deflecting[pl] <= now then _deflecting[pl] = nil end
            continue
        end
        -- v2 anti-katana: right-click sets _deflect_cooldown = tick()+1.0,
        -- post-deflect swing lockout sets _attack_cooldown = tick()+0.7.
        -- Hold fire while either is live + KatanaBuffer grace. Katana only.
        local latest = 0
        local buf = Cfg.RageKatanaBuffer or 0.35
        local dc = rawget(eq, "_deflect_cooldown")
        if dc and type(dc) == "number" and dc + buf > now and dc > latest then latest = dc end
        local ac = rawget(eq, "_attack_cooldown")
        if ac and type(ac) == "number" and ac + buf > now and ac > latest then latest = ac end
        if latest <= 0 then
            for k, v in pairs(eq) do
                if type(v) == "number" and v > now then
                    local kl = string.lower(tostring(k))
                    if (string.find(kl, "deflect", 1, true) or string.find(kl, "parry", 1, true))
                        and v + buf > now and v > latest then latest = v end
                end
            end
        end
        if latest > 0 then
            _deflecting[pl] = latest + buf
        elseif _deflecting[pl] and _deflecting[pl] <= now then
            _deflecting[pl] = nil
        end
    end
end


-- Persistent locked target across frames
_lockedModel = nil
_lockedPart  = nil
_lockedPlayer = nil


function clearLock()
    _lockedModel = nil
    _lockedPart  = nil
    _lockedPlayer = nil
    getgenv()._HubAimSmPos = nil -- reset smoothing, no drag to ghost --
    getgenv()._HubAimLockPart = nil -- v4: force steering re-latch on next lock --
    getgenv()._HubAimPathLatched = nil
    getgenv()._HubAimLastSp = nil
    getgenv()._HubAimOffAt = 0
    getgenv()._HubAimLostAt = 0
    getgenv()._HubAimFracX = 0
    getgenv()._HubAimFracY = 0
end


function findAimTarget(cam)
    updateDeflectionMap()
    if aimFlashActive() then clearLock() return nil, nil end
    if aimFlashSeverity() > (Cfg.AimFlashThreshold or 50) then clearLock() return nil, nil end
    if not aimLocalGates() then clearLock() return nil, nil end
    local cx, cy = hubAimAnchor(cam) -- v4 single anchor: selection == circle == movement --


    -- If we have a locked target, verify it's still valid
    if _lockedModel and _lockedPart then
        -- parrying katana: drop the lock the instant they start deflecting
        if _lockedPlayer and isDeflecting(_lockedPlayer) then
            clearLock()
            return nil, nil
        end
        -- lock duration: hold this target before any swap is allowed
        local held = tick() - _aimLockAt
        local minHold = ((Cfg.AimTargetPartTime or 1) * 0.12) + ((Cfg.AimLockDuration or 0) / 60)
            + (Cfg.AimSwitchDelay or 0)
        -- sticky: brief off-screen grace keeps the lock while flicking past cover
        local stickyGrace = (Cfg.AimSticky and (Cfg.AimStickyTime or 0.6)) or 0
        local stickyUntil = getgenv()._HubAimStickyUntil or 0
        -- stale lock (respawned/despawned part) stuck the aimbot on a ghost:
        -- drop it the moment the part leaves the game world
        if modelAlive(_lockedModel) and _lockedPart:IsDescendantOf(Workspace) then
            if Cfg.AimIgnoreKnocked and modelKnocked(_lockedModel) then clearLock() return nil, nil end
            local sp, onScreen = cam:WorldToViewportPoint(_lockedPart.Position)
            if onScreen then
                getgenv()._HubAimStickyUntil = tick() + stickyGrace
                local px = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
                if px <= Cfg.AimFOV * 1.4 then  -- 1.4x hysteresis: enough grace for natural movement, not enough to thrash on edge drift
                    if held < minHold then return _lockedModel, _lockedPart end
                    if (Cfg.AimLockDuration or 0) > 0 then return _lockedModel, _lockedPart end
                    if Cfg.AimSticky then
                        -- retention: still inside 2x, so hold and refresh keep-alive
                        -- instead of dropping into a strict re-search that can't re-grab
                        getgenv()._HubAimMemAt = tick()
                        getgenv()._HubAimMemKey = _lockedPart
                        return _lockedModel, _lockedPart
                    end
                    -- sticky off: fall through to the strict re-search below
                end
            elseif stickyGrace > 0 and tick() < stickyUntil then
                return _lockedModel, _lockedPart
            end
        end
        -- target memory: brief grace keeps returning the ghost while it lives
        if (Cfg.AimTargetMemory or 0) > 0 and modelAlive(_lockedModel)
            and _lockedPart:IsDescendantOf(Workspace) then
            local memAt = getgenv()._HubAimMemAt or 0
            if getgenv()._HubAimMemKey == _lockedPart and (tick() - memAt) < Cfg.AimTargetMemory then
                return _lockedModel, _lockedPart
            end
        end
        clearLock()
    end


    -- Search for a new target
    local best, bestPart = nil, nil
    local bestScore = math.huge
    local bestPx = Cfg.AimFOV
    local usePriority = (Cfg.AimPriority or "ClosestToCenter") ~= "ClosestToCenter" or Cfg.AimMostDangerous


    local selfChar  = LP.Character
    local ignoreLOS = { selfChar, cam }
    local function consider(model, pl)
        local relaxed = getgenv()._HubAimRelax and true or false
        if not relaxed and Cfg.AimIgnoreKnocked and modelKnocked(model) then return end
        if pl and aimFriendListed(pl) then return end
        local part = aimPickBone(model, cam)
        if not part then return end
        if Cfg.AimClosestPart and aimBlacklisted(part.Name) then return end
        local myRoot = selfChar and selfChar:FindFirstChild("HumanoidRootPart")
        local eroot = model:FindFirstChild("HumanoidRootPart")
        local dist = (myRoot and eroot) and (myRoot.Position - eroot.Position).Magnitude or 0
        if Cfg.AimLimitDistance and dist > Cfg.AimMaxDist then return end
        -- raw position for scoring: prediction/history runs once on the
        -- WINNER (render loop), not per candidate per frame
        local worldPos = part.Position
        if Cfg.AimTrig then worldPos = trigLeadPosition(cam, part) end
        local sp, onScreen = cam:WorldToViewportPoint(worldPos)
        if not onScreen then return end
        local px = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
        if not usePriority and px > bestPx then return end
        if (Cfg.AimWallCheck or Cfg.AimVisibleOnly) then
            if not losClearMulti(cam, worldPos, model, ignoreLOS) then return end
        end
        local effPx = px
        if Cfg.AimClosestPart and (Cfg.AimPartSizeBias or 0) > 0 and part:IsA("BasePart") then
            effPx = px - part.Size.Magnitude * Cfg.AimPartSizeBias
        end
        if usePriority then
            local s = aimPriorityScore(model, part, effPx, dist)
            if s < bestScore then best, bestPart, bestScore, bestPx = model, part, s, px end
        else
            if effPx < bestPx then best, bestPart, bestPx = model, part, effPx end
        end
    end


    -- Pass 1: FighterController. Pass 2: Players fallback.
    -- FFA guard: if team check wipes the ENTIRE lobby (shared TeamID attrs
    -- in FFA modes), the second sweep runs with it relaxed so the bot
    -- actually shoots instead of holding fire forever.
    local skippedTeam = false
    local function teamSkipFC(fObj, myTeam, strict)
        if strict and Cfg.AimTeamCheck and myTeam ~= nil then
            if type(fObj.Data) == "table" and fObj.Data.TeamID == myTeam then
                skippedTeam = true
                return true
            end
        end
        return false
    end
    local function teamSkipP(p, strict)
        if strict and Cfg.AimTeamCheck then
            local pA = p:GetAttribute("TeamID")
            local lA = LP:GetAttribute("TeamID")
            if pA and lA and pA == lA then skippedTeam = true return true end
            if p.Team and LP.Team and p.Team == LP.Team then skippedTeam = true return true end
        end
        return false
    end
    local function runPasses(strict)
        -- Pass 1: FighterController
        local fc = getFC()
    if fc and type(fc.Objects) == "table" then
        local myTeam = localTeamID()
        for _, fObj in pairs(fc.Objects) do
            if type(fObj) ~= "table" then continue end
            if fObj.IsLocalPlayer or fObj._destroyed then continue end
            if fObj.Player and isDeflecting(fObj.Player) then continue end
            if fObj.Player and aimFriendListed(fObj.Player) then continue end
            if teamSkipFC(fObj, myTeam, strict) then continue end
            local entity = fObj.Entity
            if not entity then continue end
            local model = type(entity) == "table"
                and typeof(entity.Model) == "Instance" and entity.Model
            if not (model and modelAlive(model)) then continue end
            if not getgenv()._HubAimRelax and Cfg.AimIgnoreProtected and model:FindFirstChildOfClass("ForceField") then continue end
            consider(model, fObj.Player)
        end
    end


    -- Pass 2: Players service fallback
    if not best then
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if isDeflecting(p) then continue end
            if teamSkipP(p, strict) then continue end
            local model = p.Character
            if not (model and modelAlive(model)) then continue end
            if not getgenv()._HubAimRelax and Cfg.AimIgnoreProtected and model:FindFirstChildOfClass("ForceField") then continue end
            consider(model, p)
        end
    end
    end -- runPasses
    runPasses(true)
    if not best and skippedTeam and Cfg.AimTeamCheck then
        runPasses(false) -- FFA fallback: everybody skipped = nobody is "team"
    end
    -- duel relax: strict + FFA both whiffed mid-duel (stale team attrs,
    -- lingering spawn shields, knocked flags) ??" one sweep with all three
    -- ignored so the bot still shoots instead of holding fire forever.
    -- throttled to ~1Hz while targetless: this is a second full player
    -- sweep and running it at scan rate doubled finder cost (frame lag).
    -- tick-based (the loop frame counter isn't in scope this far up)
    if not best and inDuel() and (getgenv()._HubRelaxAt or 0) + 1.0 < tick() then
        getgenv()._HubRelaxAt = tick()
        getgenv()._HubAimRelax = true
        pcall(function() runPasses(false) end)
        getgenv()._HubAimRelax = nil
    end
    -- shooting range fallback (out of duel only): dummies compete only when
    -- no player locked, so lobby fights never snap to a dummy instead
    if not best and Cfg.AimDummies and not inDuel() then
        pcall(function() hubDummyScan() end)
        local D = getgenv()._HubDummies
        if type(D) == "table" then
            for model in pairs(D) do
                if modelAlive(model) then consider(model, nil) end
            end
        end
    end


    if best and bestPart then
        if _lockedPart ~= bestPart then getgenv()._HubAimSmPos = bestPart.Position end -- snap smoothing on swap, no sweep flicker --
        _lockedModel = best
        _lockedPart  = bestPart
        _aimLockAt = tick()
        getgenv()._HubHitRoll = math.random(1, 100)
        getgenv()._HubAimMemAt = tick()
        getgenv()._HubAimMemKey = bestPart
        getgenv()._HubAimOver = 0
        _lockedPlayer = nil
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character == best then _lockedPlayer = p break end
            end
        end)
    end


    return best, bestPart
end


