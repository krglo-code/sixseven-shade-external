-- Live catalog: Finishers folder + CosmeticLibrary Type=="Finisher".
function hubFinisherNames()
    local out, seen = {}, {}
    local function push(nm)
        nm = tostring(nm or "")
        if nm ~= "" and nm ~= "MISSING_FINISHER" and not seen[nm] then
            seen[nm] = true
            table.insert(out, nm)
        end
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local f = mods and mods:FindFirstChild("Finishers")
        if f then
            for _, c in ipairs(f:GetChildren()) do push(c.Name) end
        end
    end)
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            if type(info) == "table" and tostring(info.Type or "") == "Finisher" then
                push(name)
            end
        end
    end)
    pcall(function()
        local spec = getgenv()._HubFinSpec
        if type(spec) == "table" then
            for nm in pairs(spec) do
                if string.sub(nm, 1, 1) ~= "@" then push(nm) end
            end
        end
    end)
    -- pool merge: substring-matched + folder entries the checks above miss
    pcall(function()
        for _, nm in ipairs(hubFinisherPool()) do push(nm) end
    end)
    table.sort(out)
    return out
end


-- Deep reader for the game's REAL finisher features (ReplicatedStorage >
-- Modules > Finishers): per-finisher duration, stages, ragdoll + fling
-- hints. Whatever shape each entry has (ModuleScript table, folder of
-- values, attributes), the spec normalizes it. Cached for the session.
function hubFinisherInspect()
    local spec = getgenv()._HubFinSpec
    if type(spec) ~= "table" then spec = {} getgenv()._HubFinSpec = spec end
    local function put(name)
        name = tostring(name or "")
        if name == "" or name == "MISSING_FINISHER" then return nil end
        spec[name] = spec[name] or {}
        return spec[name]
    end
    local function grabNum(t, keys)
        for _, k in ipairs(keys) do
            local v = t[k]
            if type(v) == "number" then return v end
            if type(v) == "string" then
                local n = tonumber(v:match("([%d%.]+)"))
                if n then return n end
            end
        end
        return nil
    end
    local function learn(name, tbl, rawKeys)
        local s = put(name)
        if not s then return end
        if type(tbl) == "table" then
            local d = grabNum(tbl, { "Duration", "duration", "Length", "length", "Time", "time", "TotalTime", "SequenceTime" })
            if d and d > 0 and d < 60 then s.duration = d end
            for _, k in ipairs({ "Ragdoll", "ragdoll", "RagdollEnabled", "UseRagdoll", "Physics", "physics" }) do
                if tbl[k] ~= nil then s.ragdoll = (tbl[k] and true or false) break end
            end
            for _, k in ipairs({ "Fling", "fling", "Launch", "launch", "Knockback", "knockback", "Velocity", "velocity", "Force", "force", "Power", "power" }) do
                local fv = tbl[k]
                if typeof(fv) == "Vector3" then s.fling = fv break end
                if type(fv) == "number" and fv ~= 0 then s.flingPower = fv break end
            end
            for _, k in ipairs({ "Stages", "stages", "Steps", "steps", "Phases", "phases", "Parts", "parts" }) do
                if type(tbl[k]) == "table" then
                    local c = 0
                    for _ in pairs(tbl[k]) do c += 1 end
                    s.stages = c
                    break
                end
            end
        end
        if type(rawKeys) == "table" then
            s.keys = table.concat(rawKeys, ","):sub(1, 220)
        end
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        if not mods then return end
        local f = mods:FindFirstChild("Finishers")
        if f then
            for _, c in ipairs(f:GetChildren()) do
                local keys = {}
                local okIsMod, isMod = pcall(function() return c:IsA("ModuleScript") end)
                if okIsMod and isMod then
                    local okM, lib = pcall(require, c)
                    if okM and type(lib) == "table" then
                        for k in pairs(lib) do
                            if #keys < 40 then table.insert(keys, tostring(k)) end
                        end
                        learn(c.Name, lib, keys)
                    else
                        learn(c.Name, nil, keys)
                    end
                else
                    local vals = {}
                    pcall(function()
                        for _, d in ipairs(c:GetDescendants()) do
                            if #keys < 40 then table.insert(keys, d.ClassName .. ":" .. tostring(d.Name)) end
                            if d:IsA("NumberValue") or d:IsA("IntValue") then vals[d.Name] = d.Value
                            elseif d:IsA("StringValue") then vals[d.Name] = d.Value
                            elseif d:IsA("BoolValue") then vals[d.Name] = d.Value end
                        end
                        for a, v in pairs(c:GetAttributes()) do vals[a] = v end
                    end)
                    learn(c.Name, vals, keys)
                end
            end
        end
        -- a Ragdoll driver module rides next to Finishers on some builds
        for _, c in ipairs(mods:GetChildren()) do
            local nm = ""
            pcall(function() nm = string.lower(c.Name or "") end)
            if string.find(nm, "ragdoll", 1, true) then
                local okM, lib = pcall(require, c)
                if okM and type(lib) == "table" then
                    local keys = {}
                    for k in pairs(lib) do if #keys < 40 then table.insert(keys, tostring(k)) end end
                    getgenv()._HubRagdollKeys = table.concat(keys, ","):sub(1, 220)
                end
            end
        end
    end)
    return spec
end


-- Canonical finisher name: exact folder hit first, then case-insensitive,
-- then the inspected spec. Returns nil when the game doesn't know it, so
-- overrides never rename your finisher into something ignored.
function hubFinisherCanonical(name)
    local want = tostring(name or "")
    if want == "" then return nil end
    local hit = nil
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local f = mods and mods:FindFirstChild("Finishers")
        if f then
            local exact = f:FindFirstChild(want)
            if exact then hit = exact.Name
            else
                local wl = string.lower(want)
                for _, c in ipairs(f:GetChildren()) do
                    if string.lower(c.Name) == wl then hit = c.Name break end
                end
            end
        end
    end)
    if not hit then
        pcall(function()
            local spec = getgenv()._HubFinSpec
            if type(spec) == "table" then
                if spec[want] then hit = want
                else
                    local wl = string.lower(want)
                    for nm in pairs(spec) do
                        if string.lower(nm) == wl then hit = nm break end
                    end
                end
            end
        end)
    end
    return hit
end


