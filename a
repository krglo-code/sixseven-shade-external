-- Rise greeting on every tab switch: visible columns start 44px down and
-- glide to top. ONLY CanvasPosition is touched (never frame positions), so
-- an interrupted tween can never strand content or break scrolling.
function hubTabRise()
    -- NOLAG: at most one rise tween per 0.4s.
    if (getgenv()._HubRiseAt or 0) + 0.4 > tick() then return end
    getgenv()._HubRiseAt = tick()
    pcall(function() hubFixSliderScale() end)
    pcall(function() hubGhostCorners() end) -- v14: corners ride every tab switch
    pcall(function()
        local win = findHubWindow()
        if not win then return end
        for _, d in ipairs(win:GetDescendants()) do
            if d:IsA("ScrollingFrame") and d.Visible then
                d.CanvasPosition = d.CanvasPosition + Vector2.new(0, 44)
                TweenService:Create(d, TweenInfo.new(0.22,
                    Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { CanvasPosition = Vector2.zero }):Play()
            end
        end
    end)
end
-- hook every main tab through the same rise (native highlight untouched).
-- First visit of Weapons/Players/ESP also lazily builds their heavy
-- catalogs (weapons, emotes, tripmines) staggered, so execute stays fast.
function hubLazyTab(name)
    local done = getgenv()._HubLazyDone
    if type(done) ~= "table" then done = {} getgenv()._HubLazyDone = done end
    if done[name] then return end
    done[name] = true
    task.spawn(function()
        if name == "Weapons" then
            pcall(function() hubRefreshWeapons() end)
            task.wait(0.4)
            pcall(function() hubRefreshShared() end)
            task.wait(0.4)
            pcall(function() hubFinisherInspect() end)
            pcall(function() hubRefreshFinishers() end)
        elseif name == "Char" then
            pcall(function() hubEmoteScan() end)
        elseif name == "ESP" and Cfg.ESPTrip then
            pcall(function() hubTripmineWatch() end)
        end
    end)
end
