            lset("GlobalShadows", true)
        end
        -- restore every post-effect we switched off (stuck-shadows fix)
        pcall(function()
            for _, d in ipairs(_perfSaved.fx or {}) do
                if d and d.Parent then d.Enabled = true end
            end
        end)
        pcall(function() applyPerfDetails(false) end) -- restore eye candy --
        pcall(function()
            game:GetService("UserSettings").Rendering.QualityLevel = Enum.QualityLevel.Automatic
        end)
        _perfSaved = nil
    end
end


