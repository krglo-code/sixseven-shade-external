        end
        lset("GlobalShadows", false)
        pcall(function()
            local function killFx(list)
                for _, d in ipairs(list) do
                    if d:IsA("PostEffect") and d.Enabled then
                        d.Enabled = false
                        local dup = false
                        for _, e in ipairs(_perfSaved.fx) do
                            if e == d then dup = true break end
