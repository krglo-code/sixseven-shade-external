local function fetchUrl(u)
    if type(HttpGet) == "function" then
        local ok, res = pcall(HttpGet, game, u)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    if type(request) == "function" then
        local ok, res = pcall(request, { Url = u, Method = "GET" })
        if ok then
            if type(res) == "string" and #res > 0 then return res end
            if type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then
                return res.Body
            end
        end
    end
    if game and type(game.HttpGet) == "function" then
        local ok, res = pcall(function() return game:HttpGet(u) end)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    if game and type(game.HttpGetAsync) == "function" then
        local ok, res = pcall(function() return game:HttpGetAsync(u) end)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    return nil
end


local function tryUrls(urls)
    local lastErr = nil
    for _, u in ipairs(urls) do
        local res = fetchUrl(u)
        if type(res) == "string" and #res > 1000 then
            local fn, lerr = loadstring(res)
            if fn then
                local rok, mod = pcall(fn)
                if rok and mod then return mod, u end
                lastErr = mod
            else
                lastErr = lerr
            end
        else
            lastErr = "fetch failed: " .. tostring(u)
        end
    end
    return nil, lastErr
end


