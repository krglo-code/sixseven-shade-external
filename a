-- hubGroupBoxOuter: returns the BoxOuter frame for a Linoria groupbox.
-- From the Linoria source: Groupbox.Container is the inner content frame.
-- Container.Parent = BoxInner, BoxInner.Parent = BoxOuter.
-- BoxOuter is the frame directly under LeftSide/RightSide that the
-- UIListLayout stacks ??" hiding it collapses the entire groupbox.
function hubGroupBoxOuter(g)
    if type(g) ~= "table" then return nil end
    local ok, c = pcall(function() return g.Container end)
    if ok and typeof(c) == "Instance" and c:IsA("GuiObject") then
        local boxInner = c.Parent
        if boxInner and boxInner:IsA("GuiObject") then
            local boxOuter = boxInner.Parent
            if boxOuter and boxOuter:IsA("GuiObject") then
