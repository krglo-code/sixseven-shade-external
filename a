-- Speed lock: RIVALS stomps Humanoid.WalkSpeed/JumpPower on duel entry,
-- weapon equip and respawn ??" re-assert until it sticks, then hold it.
-- Runs even when the value equals default so any external stomp loses.
function hubSpeedTick()
    if not Cfg.SpeedLock then return end
    pcall(function()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local ws = Cfg.MiscWalkSpeed or Cfg.MiscSpeed or 16
        local jp = Cfg.MiscJumpPower or 50
        if Cfg.WarhornV2 then
            -- v2: buff window raises the floor; never stomp a higher game value
            local buff = (getgenv()._HubHornBuffUntil or 0) > tick()
            local target = ws + (buff and (Cfg.WarhornExtra or 8) or 0)
            if hum.WalkSpeed < target - 0.5 then hum.WalkSpeed = target end
        else
            if hum.WalkSpeed ~= ws then hum.WalkSpeed = ws end
        end
        if hum.JumpPower ~= jp then hum.JumpPower = jp end
    end)
end


-- Enforcement: RIVALS re-forces first-person on spawn, duel entry and
-- weapon zoom. Mode + subject are re-asserted; the zoom clamp is ONLY
-- touched when the game clamped it (first-person lock) ??" otherwise your
-- scroll wheel owns the distance.
function hubThirdTick(cam)
    if not (Cfg.CharThirdPerson or Cfg.VisThirdPerson) then return end
    pcall(function()
        local dist = Cfg.CharThirdDist or Cfg.VisThirdDist or 10
        if LP.CameraMode ~= Enum.CameraMode.Classic then
            LP.CameraMode = Enum.CameraMode.Classic
        end
        local mn, mx = LP.CameraMinZoomDistance, LP.CameraMaxZoomDistance
        if mn > 1 or mx < 6 then
            -- game clamped us (or fresh kick): force out to distance...
            LP.CameraMinZoomDistance = dist
            LP.CameraMaxZoomDistance = dist
            getgenv()._HubThirdKick = tick()
        elseif (getgenv()._HubThirdKick or 0) ~= 0 and tick() - getgenv()._HubThirdKick > 0.5 then
            -- ...then let go so zoom scrolls freely like desktop
            LP.CameraMinZoomDistance = 0.5
            LP.CameraMaxZoomDistance = 400
            getgenv()._HubThirdKick = 0
        end
        if cam and cam.CameraType ~= Enum.CameraType.Custom then
            cam.CameraType = Enum.CameraType.Custom
        end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and cam and cam.CameraSubject ~= hum then
            cam.CameraSubject = hum
        end
    end)
end


