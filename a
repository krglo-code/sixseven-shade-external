-- ?"??"? Crosshair (screen center) + custom cursor (follows mouse). One function,
-- pools in getgenv, 10 styles each: Cross Dot Circle CircleDot Square X Plus
-- Diamond TShape CrossGap.
function drawOverlays(cam)
    local vp = cam.ViewportSize
    local cx, cy = vp.X * 0.5, vp.Y * 0.5
    local G = getgenv()._HubXH
    if type(G) ~= "table" then G = {} getgenv()._HubXH = G end
    local function ens(key, className)
        local o = G[key]
        if o == nil then
            local ok, inst = pcall(function() return Drawing.new(className) end)
            o = ok and inst or false
            G[key] = o
        end
        return o or nil
    end
    local function hideSys(sys)
        for _, k in ipairs({ "l1", "l2", "l3", "l4", "c", "s", "d" }) do
            local o = G[sys .. k]
            if o then pcall(function() o.Visible = false end) end
        end
    end
    local function paint(sys, px, py, style, size, col)
        hideSys(sys)
        local gap = math.max(2, size * 0.35)
        local L = {}
        for i = 1, 4 do L[i] = ens(sys .. "l" .. i, "Line") end
        local C = ens(sys .. "c", "Circle")
        local S = ens(sys .. "s", "Square")
        local D = ens(sys .. "d", "Circle")
        local function line(o, x1, y1, x2, y2)
            if not o then return end
            o.From = Vector2.new(x1, y1)
            o.To = Vector2.new(x2, y2)
            o.Color = col
            o.Thickness = 1.5
            o.Transparency = 1
            o.Visible = true
        end
        if style == "Dot" then
            if D then D.Position = Vector2.new(px, py) D.Radius = 3 D.Filled = true D.Color = col D.Transparency = 1 D.Visible = true end
        elseif style == "Circle" or style == "CircleDot" then
            if C then C.Position = Vector2.new(px, py) C.Radius = size C.Filled = false C.Thickness = 1.5 C.Color = col C.Transparency = 1 C.Visible = true end
            if style == "CircleDot" and D then D.Position = Vector2.new(px, py) D.Radius = 2.5 D.Filled = true D.Color = col D.Transparency = 1 D.Visible = true end
        elseif style == "Square" then
            if S then S.Position = Vector2.new(px - size, py - size) S.Size = Vector2.new(size * 2, size * 2) S.Filled = false S.Thickness = 1.5 S.Color = col S.Transparency = 1 S.Visible = true end
        elseif style == "X" then
            line(L[1], px - size, py - size, px - gap, py - gap)
            line(L[2], px + gap, py - gap, px + size, py - size)
            line(L[3], px - size, py + size, px - gap, py + gap)
            line(L[4], px + gap, py + gap, px + size, py + size)
        elseif style == "Plus" then
            line(L[1], px - size, py, px + size, py)
            line(L[2], px, py - size, px, py + size)
        elseif style == "Diamond" then
            line(L[1], px, py - size, px + size, py)
            line(L[2], px + size, py, px, py + size)
            line(L[3], px, py + size, px - size, py)
            line(L[4], px - size, py, px, py - size)
        elseif style == "TShape" then
            line(L[1], px - size, py, px + size, py)
            line(L[2], px, py, px, py + size)
        else
            local g = (style == "CrossGap") and size or gap
            line(L[1], px, py - g - size, px, py - g)
            line(L[2], px, py + g, px, py + g + size)
            line(L[3], px - g - size, py, px - g, py)
            line(L[4], px + g, py, px + g + size, py)
        end
    end
    -- hide the game's own per-weapon crosshair frames while ours draws
    -- (restored from the recorded set when ours turns off)
    local xhT = getgenv()._HubXHTime or 0
    if tick() - xhT > 0.5 then
        getgenv()._HubXHTime = tick()
        pcall(function()
            if Cfg.CrossEnabled then
                local mg2 = LP.PlayerGui:FindFirstChild("MainGui")
                local hid = getgenv()._HubXHid
                if type(hid) ~= "table" then hid = {} getgenv()._HubXHid = hid end
                if mg2 then
                    for _, d in ipairs(mg2:GetDescendants()) do
                        if d:IsA("Frame") and d.Name == "Crosshair" and d.Visible then
                            d.Visible = false
                            hid[d] = true
                        end
                    end
                end
            else
                local hid = getgenv()._HubXHid
                if type(hid) == "table" then
                    for d in pairs(hid) do
                        pcall(function() d.Visible = true end)
                    end
                    getgenv()._HubXHid = nil
                end
            end
        end)
    end
    if Cfg.CrossEnabled then
        paint("xh", cx, cy, Cfg.CrossStyle, Cfg.CrossSize,
            Color3.fromRGB(Cfg.CrossColorR, Cfg.CrossColorG, Cfg.CrossColorB))
    else
        hideSys("xh")
    end
    local wantCursor = Cfg.CursorEnabled
    if wantCursor then
        local mx, my = cx, cy
        pcall(function()
            local ml = UserInputService:GetMouseLocation()
            mx, my = ml.X, ml.Y
        end)
        paint("cu", mx, my, Cfg.CursorStyle, 10, Color3.new(1, 1, 1))
    else
        hideSys("cu")
    end
    if getgenv()._HubCursorHidden ~= wantCursor then
        getgenv()._HubCursorHidden = wantCursor
        pcall(function() UserInputService.MouseIconEnabled = not wantCursor end)
        pcall(function()
            local m = LP and LP:GetMouse()
            if m then
                if wantCursor then
                    getgenv()._HubSavedCursor = m.Icon
                    m.Icon = ""
                elseif getgenv()._HubSavedCursor ~= nil then
                    m.Icon = getgenv()._HubSavedCursor
                end
            end
        end)
    end
end


