-- equip ONE kind right now (wrap carries the Inverted flag through).
function hubCatalogEquipOne(kind, id, weapon)
    if id == "__clear" or id == "" then return false end
    local w = weapon or hubCatalogState().weapon
    if w == "" or w == "All Weapons" then return false end
    if id == "__random" then
        local pool = (kind == "Skin") and hubWeaponSkins(w)
            or (kind == "Finisher") and hubFinisherPool()
            or hubCosmeticPool(kind)
        if #pool == 0 then return false end
        id = pool[math.random(1, #pool)]
    end
    local flag = kind == "Skin" and "WeaponSkin" or kind == "Wrap" and "WeaponWrap"
        or kind == "Charm" and "WeaponCharm" or "WeaponFinisher"
    Cfg[flag] = id
    hubCatalogSyncOpt(flag, id)
    if kind == "Skin" then
        local sk = getgenv()._HubWepSkins
        if type(sk) ~= "table" then sk = {} getgenv()._HubWepSkins = sk end
        sk[w] = sk[w] or {}
        sk[w].skin = id
    end
    cfgSave()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local data = remotes and remotes:FindFirstChild("Data")
        local rem = data and data:FindFirstChild("EquipCosmetic")
        if rem then
            local opts = {}
            if kind == "Wrap" and Cfg.WeaponWrapInverted then opts = { IsInverted = true } end
            rem:FireServer(w, kind, id, opts)
        end
    end)
    return true
end


