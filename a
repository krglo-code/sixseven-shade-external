--[[
  Fires LMB when an enemy hitbox is within TrigFOV pixels of screen centre.
  Uses mouse1press/mouse1release simulation.
  Delay simulates human hold timing.
]]


_trigActive      = false
_trigReleaseTask = nil
_trigDelayTask   = nil


function trigRelease()
    if not _trigActive then return end
    if _trigReleaseTask then
        task.cancel(_trigReleaseTask)
        _trigReleaseTask = nil
    end
    _trigReleaseTask = task.delay(Cfg.TrigReleaseDelay, function()
        pcall(mouse1release)
        _trigActive      = false
        _trigReleaseTask = nil
    end)
end


function trigPress()
    if _trigActive then return end
    _trigActive = true
    pcall(mouse1press)
end


function trigKeyActive()
    if Cfg.TrigToggle and getgenv()._HubTrigToggled then return true end
    if (Cfg.TrigKey or "") == "" then return true end
    local parsed = parseAimKey(Cfg.TrigKey)
    if not parsed or typeof(parsed) ~= "EnumItem" then return false end
    if parsed.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(parsed)
    else
        return UserInputService:IsMouseButtonPressed(parsed)
    end
end


function trigLocalGates()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if (Cfg.TrigLocalMinHP or 0) > 0 and hum.Health < Cfg.TrigLocalMinHP then return false end
    if Cfg.TrigRequireGrounded or Cfg.TrigRequireAirborne then
        local grounded = hum.FloorMaterial ~= Enum.Material.Air
        if Cfg.TrigRequireGrounded and not grounded then return false end
        if Cfg.TrigRequireAirborne and grounded then return false end
    end
    if (Cfg.TrigWeapons or "") ~= "" then
        local fc = getFC()
        local lf = fc and fc.LocalFighter
        local it = lf and lf.EquippedItem
        local nm = it and string.lower(tostring(it.Name or "")) or ""
        local okW = false
        for token in string.gmatch(string.lower(Cfg.TrigWeapons), "([^,]+)") do
            token = token:gsub("%s+", "")
            if token ~= "" and string.find(nm, token, 1, true) then okW = true break end
        end
        if not okW then return false end
    end
    if Cfg.TrigSuppressOnAim and aimKeyActive() then return false end
    return true
end


function trigPartAllowed(name)
    local fl = tostring(Cfg.TrigPartFilter or "")
    if fl == "" then return true end
    for token in string.gmatch(fl, "([^,]+)") do
        token = token:gsub("^%s+", ""):gsub("%s+$", "")
        if token ~= "" and string.lower(token) == string.lower(tostring(name)) then return true end
    end
    return false
end


function trigShouldFire(cam)
    if not Cfg.TrigEnabled then return false end
    if not trigKeyActive() then return false end
    if not trigLocalGates() then return false end
    if Cfg.TrigRequireAimLock and not _lockedPart then return false end
    if Cfg.TrigDisableOnKill and getgenv()._HubTrigKillLatch then
        if (Cfg.TrigAutoRefire and (tick() - (getgenv()._HubTrigKillAt or 0)) >= (Cfg.TrigCooldown or 0)) then
            getgenv()._HubTrigKillLatch = nil
        else
            return false
        end
    end
    updateDeflectionMap()
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    local threshold = Cfg.TrigFOV
    local selfChar = LP.Character
    local ignoreLOS = { selfChar, cam }


    -- Wall check helper: only counts when you can actually SEE the part
    local function trigVisible(part, model)
        if not Cfg.TrigWallCheck then return true end
        if Cfg.TrigPenetration then
            if losClear(cam, part.Position, model, ignoreLOS) then return true end
            local thin = true
            pcall(function()
                local res = Workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, _rayParams)
                thin = res and (part.Position - res.Position).Magnitude < 6 or thin
            end)
            return thin
        end
        return losClear(cam, part.Position, model, ignoreLOS)
    end


    local mode = Cfg.TrigMode or "CenterRay"
    local function partHit(part, model)
        local hum = model:FindFirstChildOfClass("Humanoid")
        if Cfg.TrigTargetMaxHP and Cfg.TrigTargetMaxHP > 0 and hum
            and hum.Health > Cfg.TrigTargetMaxHP then return false end
        if (Cfg.TrigMaxDist or 0) > 0 then
            local dd = (cam.CFrame.Position - part.Position).Magnitude
            if dd > Cfg.TrigMaxDist then return false end
        end
        if (Cfg.TrigMaxTargetVelocity or 0) > 0 then
            local v = Vector3.zero
            pcall(function() v = part.AssemblyLinearVelocity end)
            if v.Magnitude > Cfg.TrigMaxTargetVelocity then return false end
        end
        if mode == "CircleSweep" then
            for a = 0, 5 do
                local ang = a * math.pi / 3
                local ox, oy = math.cos(ang) * threshold * 0.7, math.sin(ang) * threshold * 0.7
                local sp, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local px = math.sqrt((sp.X - cx - ox)^2 + (sp.Y - cy - oy)^2)
                    if px <= threshold * 0.45 and trigVisible(part, model) then return true end
                end
            end
            return false
        end
        local sp, on = cam:WorldToViewportPoint(part.Position)
        if not on then return false end
        local px = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
        if px <= threshold and trigVisible(part, model) then return true end
        if mode == "MultiRay" then
            for _, off in ipairs({ 6, -6 }) do
                local px2 = math.sqrt((sp.X - cx + off)^2 + (sp.Y - cy)^2)
                if px2 <= threshold and trigVisible(part, model) then return true end
            end
        end
        return false
    end


    -- FighterController path
    local fc = getFC()
    if fc and type(fc.Objects) == "table" then
        local myTeam = localTeamID()
        for _, fObj in pairs(fc.Objects) do
            if type(fObj) ~= "table" or fObj.IsLocalPlayer or fObj._destroyed then continue end
            if fObj.Player and isDeflecting(fObj.Player) then continue end
            if Cfg.TrigTeamCheck and myTeam and type(fObj.Data) == "table"
                and fObj.Data.TeamID == myTeam then continue end
            local entity = fObj.Entity
            local model  = entity and type(entity) == "table"
                and typeof(entity.Model) == "Instance" and entity.Model
            if not (model and modelAlive(model)) then continue end
            if Cfg.RageWaitImmune and model:FindFirstChildOfClass("ForceField") then continue end


            -- Check filtered hitbox parts for screen-space hits
            for _, pname in ipairs(HEAD_NAMES) do
                if not trigPartAllowed(pname) then continue end
                local part = model:FindFirstChild(pname)
                if part and part:IsA("BasePart") and partHit(part, model) then
                    return trigConfirm(true)
                end
            end
            local torso = torsoOf(model)
            if torso and trigPartAllowed(torso.Name) and partHit(torso, model) then
                return trigConfirm(true)
            end
        end
    end


    -- Players fallback
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if isDeflecting(p) then continue end
        if Cfg.TrigTeamCheck and not isEnemy(p) then continue end
        local model = p.Character
        if not (model and modelAlive(model)) then continue end
        if Cfg.RageWaitImmune and model:FindFirstChildOfClass("ForceField") then continue end
        local part = headOf(model)
        if part and trigPartAllowed(part.Name) and partHit(part, model) then
            return trigConfirm(true)
        end
    end
    trigConfirm(false)
    return false
end


-- Confidence: target must read hot N straight frames before true.
function trigConfirm(hot)
    local need = math.max(1, Cfg.TrigConfidence or 1)
    local n = getgenv()._HubTrigConf or 0
    n = hot and (n + 1) or 0
    getgenv()._HubTrigConf = n
    return hot and n >= need
end


