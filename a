-- Spec drawings live in getgenv (zero chunk registers): FOV square/fill,
-- lock box/circle/info, snap origin line.
function aimDraw(key, className)
    local G = getgenv()._HubAimDraw
    if type(G) ~= "table" then G = {} getgenv()._HubAimDraw = G end
    local o = G[key]
    if o == nil then
        local ok, inst = pcall(function() return Drawing.new(className) end)
        o = ok and inst or false
        G[key] = o
    end
    return o or nil
end


function hideAimDraw()
    local G = getgenv()._HubAimDraw
    if type(G) ~= "table" then return end
    for _, o in pairs(G) do
        if o then pcall(function() o.Visible = false end) end
    end
end


-- Duel diag: aim engaged + key held + 3s no lock = say WHY on screen.
-- Instant self-test: reports every gate in the chain so a dead bot names
-- its killer immediately (run it mid-duel, key held or Always mode on).
function hubAimSelfTest()
    local rep = {}
    local function add(s) table.insert(rep, s) end
    pcall(function()
        local cam = Workspace.CurrentCamera
        add("enabled=" .. tostring(Cfg.AimEnabled))
        local key = false
        pcall(function() key = aimKeyActive() end)
        add("key=" .. tostring(key) .. "(" .. tostring(Cfg.AimKey) .. "/" .. tostring(Cfg.AimKeyMode) .. ")")
        add("menuOpen=" .. tostring(hubMenuOpen()))
        local lg = false
        pcall(function() lg = aimLocalGates() end)
        add("localGates=" .. tostring(lg))
        add("duel=" .. tostring(inDuel()))
        if cam then
            add("FP=" .. tostring(hubFirstPerson(cam)))
            add("fov=" .. tostring(math.floor(cam.FieldOfView + 0.5)))
        end
        local nFc, nAlive, nFF, nKnock = 0, 0, 0, 0
        pcall(function()
            local fc = getFC()
            if fc and type(fc.Objects) == "table" then
                for _, f in pairs(fc.Objects) do
                    if type(f) == "table" and not f.IsLocalPlayer and not f._destroyed then
                        nFc += 1
                    end
                end
            end
        end)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    nAlive += 1
                    if p.Character:FindFirstChildOfClass("ForceField") then nFF += 1 end
                    if modelKnocked(p.Character) then nKnock += 1 end
                end
            end
        end
        add("fighters=" .. nFc .. " aliveChars=" .. nAlive .. " shield=" .. nFF .. " knocked=" .. nKnock)
        add("teamCheck=" .. tostring(Cfg.AimTeamCheck) .. " visibleOnly=" .. tostring(Cfg.AimVisibleOnly)
            .. " wallCheck=" .. tostring(Cfg.AimWallCheck) .. " FOV=" .. tostring(Cfg.AimFOV))
        local mm = false
        pcall(function() mm = mousemoverel ~= nil end)
        add("mousemoverel=" .. tostring(mm) .. " mode=" .. tostring(Cfg.AimMode))
        local tgt, part = nil, nil
        pcall(function() tgt, part = findAimTarget(cam) end)
        add("target=" .. tostring(tgt ~= nil) .. (part and (" part=" .. tostring(part.Name)) or ""))
    end)
    local txt = "Aim test: " .. table.concat(rep, " ")
    warn("[Hub] " .. txt)
    pcall(function() Library:Notify(txt, 6) end)
end


function hubAimDiagTick(cam, aimPart, wantAim)
    if not (Cfg.AimEnabled and wantAim) then
        getgenv()._HubAimNoT = nil
        return
    end
    if aimPart then
        getgenv()._HubAimNoT = nil
        return
    end
    local t0 = getgenv()._HubAimNoT or tick()
    getgenv()._HubAimNoT = t0
    if tick() - t0 < 3 then return end
    getgenv()._HubAimNoT = tick()
    local nP, nAlive, nTeamSkip, nShield, nF, nKnocked, nDefl = 0, 0, 0, 0, 0, 0, 0
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                nP += 1
                local m = p.Character
                local h = m:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    nAlive += 1
                    if Cfg.AimTeamCheck and not isEnemy(p) then nTeamSkip += 1 end
                    if m:FindFirstChildOfClass("ForceField") then nShield += 1 end
                    if Cfg.AimIgnoreKnocked and modelKnocked(m) then nKnocked += 1 end
                    if isDeflecting(p) then nDefl += 1 end
                end
            end
        end
        local fc = getFC()
        if fc and type(fc.Objects) == "table" then
            for _ in pairs(fc.Objects) do nF += 1 end
        end
    end)
    local msg = nil
    pcall(function()
        local camMode, camFov, camSubj = "?", 0, "?"
        if cam then
            camFov = math.floor(cam.FieldOfView + 0.5)
            local cs = cam.CameraSubject
            camSubj = cs and (cs.ClassName .. ":" .. tostring(cs.Name or "")) or "nil"
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = hrp and hrp.Parent and (hrp.Parent:FindFirstChild("HitboxHead") or hrp.Parent:FindFirstChild("Head") or hrp)
            if head then
                camMode = ((cam.CFrame.Position - head.Position).Magnitude < 2.5) and "FP" or "TP"
            end
        end
        msg = string.format("Aim: no lock (%s fov=%d subj=%s duel=%s fighters=%d chars=%d alive=%d teamskip=%d shield=%d knocked=%d deflect=%d)",
            camMode, camFov, camSubj, tostring(inDuel()), nF, nP, nAlive, nTeamSkip, nShield, nKnocked, nDefl)
    end)
    if not msg then
        msg = string.format("Aim: no lock (duel=%s fighters=%d chars=%d alive=%d teamskip=%d shield=%d knocked=%d deflect=%d)",
            tostring(inDuel()), nF, nP, nAlive, nTeamSkip, nShield, nKnocked, nDefl)
    end
    warn("[Hub] " .. msg)
    pcall(function() Library:Notify(msg, 4) end)
end


-- Drawings render above ALL gui, so the white FOV ring arcs straight
-- through the semi-transparent menu. Park aim visuals while open.
function hubMenuOpen()
    local t = getgenv()._HubMenuVisAt or 0
    local v = getgenv()._HubMenuVis
    if tick() - t < 1.0 and v ~= nil then return v end
    local open = false
    pcall(function()
        local win = findHubWindow()
        if win then open = win.Visible end
    end)
    getgenv()._HubMenuVis = open
    getgenv()._HubMenuVisAt = tick()
    return open
end


-- ESP parking while the menu is open (drawings render above all gui).
-- Idempotent: parks once, next live update redraws everything.
function paintAimOverlays(cam, cx, cy, aimPart, sp, on)
    if hubMenuOpen() then
        -- menu open: aim math keeps running, only the drawings park
        fovCircle.Visible = false
        snapLine.Visible = false
        snapDot.Visible = false
        hideAimDraw()
        return
    end
    local shape = Cfg.AimFOVShape or "Circle"
    local radius = Cfg.AimFOV
    if Cfg.AimDynamicFOV and aimPart then
        local d = (cam.CFrame.Position - aimPart.Position).Magnitude
        radius = math.max(20, Cfg.AimFOV * math.clamp(d / 300, 0.3, 1))
    end
    -- FOV follows the mouse when toggled (aim math stays crosshair-anchored)
    if Cfg.AimFOVFollowMouse then
        pcall(function()
            local ml = UserInputService:GetMouseLocation()
            cx, cy = ml.X, ml.Y
        end)
    end
    local showFov = Cfg.AimShowFOV
    if Cfg.AimFOVKeyOnly then showFov = showFov and aimKeyActive() end
    local thick = math.clamp(Cfg.AimFOVThickness or 2, 1, 3)
    local fcol = aimPart
        and Color3.fromRGB(Cfg.AimLockColorR, Cfg.AimLockColorG, Cfg.AimLockColorB)
        or  Color3.fromRGB(Cfg.AimFOVColorR,  Cfg.AimFOVColorG,  Cfg.AimFOVColorB)
    fovCircle.Visible = false
    local fsq = aimDraw("fovSq", "Square")
    local ffl = aimDraw("fovFill", "Circle")
    if fsq then fsq.Visible = false end
    if ffl then ffl.Visible = false end
    if showFov then
        if shape == "Square" and fsq then
            fsq.Position = Vector2.new(cx - radius, cy - radius)
            fsq.Size     = Vector2.new(radius * 2, radius * 2)
            fsq.Color, fsq.Thickness, fsq.Filled, fsq.Visible = fcol, thick, false, true
        elseif shape == "Ellipse" then
            fovCircle.Position = Vector2.new(cx, cy)
            fovCircle.Radius   = radius
            fovCircle.Color, fovCircle.Thickness, fovCircle.Filled, fovCircle.Visible = fcol, thick, false, true
            if fsq then
                fsq.Position = Vector2.new(cx - radius * 1.4, cy - radius * 0.7)
                fsq.Size     = Vector2.new(radius * 2.8, radius * 1.4)
                fsq.Color, fsq.Thickness, fsq.Filled, fsq.Visible = fcol, 1, false, true
            end
        else
            fovCircle.Position = Vector2.new(cx, cy)
            fovCircle.Radius   = radius
            fovCircle.Color, fovCircle.Thickness, fovCircle.Filled, fovCircle.Visible = fcol, thick, false, true
        end
        if Cfg.AimFOVFilled and ffl then
            ffl.Position = Vector2.new(cx, cy)
            ffl.Radius   = radius
            ffl.Color, ffl.Filled, ffl.Transparency, ffl.Visible = fcol, true, 0.85, true
        end
    end
    -- snap origin: crosshair / bottom-center / own character
    local ox, oy = cx, cy
    if Cfg.AimSnapOrigin == "BottomCenter" then
        ox, oy = cx, cam.ViewportSize.Y
    elseif Cfg.AimSnapOrigin == "Character" then
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local rp, ron = cam:WorldToViewportPoint(root.Position)
            if ron then ox, oy = rp.X, rp.Y end
        end
    end
    if false then -- v5: snap line removed from aimbot
        snapLine.From    = Vector2.new(ox, oy)
        snapLine.To      = Vector2.new(sp.X, sp.Y)
        snapLine.Color   = Color3.fromRGB(Cfg.AimSnapColorR, Cfg.AimSnapColorG, Cfg.AimSnapColorB)
        snapLine.Thickness = thick
        snapLine.Visible = true
    else
        snapLine.Visible = false
    end
    -- lock indicator styles + pulse + target info
    local lk1 = aimDraw("lk1", "Line")
    local lk2 = aimDraw("lk2", "Line")
    local lkb = aimDraw("lkb", "Square")
    local lkc = aimDraw("lkc", "Circle")
    local lki = aimDraw("lki", "Text")
    for _, o in ipairs({ lk1, lk2, lkb, lkc }) do if o then o.Visible = false end end
    if lki then lki.Visible = false end
    snapDot.Visible = false
    if false then -- v5: lock cross/dot removed from aimbot
        local style = Cfg.AimLockStyle or "Dot"
        local pulse = 1
        if Cfg.AimLockPulse then pulse = 0.8 + 0.4 * math.abs(math.sin(tick() * 10.5)) end
        local lc = Color3.fromRGB(Cfg.AimLockColorR, Cfg.AimLockColorG, Cfg.AimLockColorB)
        local r = 5 * pulse
        if style == "Cross" and lk1 and lk2 then
            lk1.From, lk1.To = Vector2.new(sp.X - r - 3, sp.Y), Vector2.new(sp.X + r + 3, sp.Y)
            lk2.From, lk2.To = Vector2.new(sp.X, sp.Y - r - 3), Vector2.new(sp.X, sp.Y + r + 3)
            lk1.Color, lk2.Color = lc, lc
            lk1.Visible, lk2.Visible = true, true
        elseif style == "Box" and lkb then
            lkb.Position, lkb.Size = Vector2.new(sp.X - r, sp.Y - r), Vector2.new(r * 2, r * 2)
            lkb.Color, lkb.Filled, lkb.Visible = lc, false, true
        elseif style == "Circle" and lkc then
            lkc.Position, lkc.Radius = Vector2.new(sp.X, sp.Y), r + 2
            lkc.Color, lkc.Filled, lkc.Visible = lc, false, true
        else
            snapDot.Position = Vector2.new(sp.X, sp.Y)
            snapDot.Radius = math.max(2, math.floor(r))
            snapDot.Color = lc
            snapDot.Visible = true
        end
        if Cfg.AimShowTargetInfo and lki and _lockedModel then
            local nm = _lockedPlayer and _lockedPlayer.DisplayName or "?"
