-- Repair pass: pill labels are rebuilt from their registry page names,
-- so a bad paint can never rename Silent/Trigger/Ragebot into clones.
function hubRepairPills()
    for _, key in ipairs({ "_HubPillsL", "_HubPillsR" }) do
        local set = getgenv()[key]
        if type(set) == "table" then
            for _, e in ipairs(set) do
