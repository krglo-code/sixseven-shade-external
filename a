-- Sky/sound id normalizer: accepts bare digits OR a pasted
-- rbxassetid:// link ??" pasting the full link used to double-prefix
-- into rbxassetid://rbxassetid://??? and the sky silently never painted.
function hubAssetId(raw)
    local s = tostring(raw or ""):gsub("%s+", "")
    if s == "" then return nil end
    local id = s:match("(%d+)")
    if not id then return nil end
    return "rbxassetid://" .. id
end


-- Paint faces onto the LIVE Sky (create only if missing), preload first.
-- Destroy/recreate cycles miss frames and lose to the game's own lighting
-- resets; patching the live instance renders instantly and survives.
function hubPaintSky(want)
    if not want then
        local old = Lighting:FindFirstChildOfClass("Sky")
        if old then pcall(function() old:Destroy() end) end
        return
    end
    pcall(function()
        game:GetService("ContentProvider"):PreloadAsync({ want })
    end)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Lighting
    end
    pcall(function()
        sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = want, want, want
        sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = want, want, want
        sky.CelestialBodiesShown = true
        sky.StarCount = Cfg.WorldStars == false and 0 or 3000
        sky.MoonAngularSize = 11
        sky.SunAngularSize = 21
    end)
end


-- Sky source: your file wins (Shade External/skybox/ via getcustomasset),
-- otherwise the asset id box. Same picture paints all six sky faces.
function hubSkyWant()
    if Cfg.WorldSkyboxFile ~= nil and Cfg.WorldSkyboxFile ~= "" and type(getcustomasset) == "function" then
        local ok, a = pcall(getcustomasset, Cfg.WorldSkyboxFile)
        if ok and type(a) == "string" and a ~= "" then return a end
    end
    return hubAssetId(Cfg.WorldSkyboxId)
end
function hubTextureWant() -- custom texture: file wins, else asset id, else nil --
    if Cfg.WorldTextureFile ~= nil and Cfg.WorldTextureFile ~= "" and type(getcustomasset) == "function" then local ok, a = pcall(getcustomasset, Cfg.WorldTextureFile) if ok and type(a) == "string" and a ~= "" then return a end end
    return hubAssetId(Cfg.WorldTextureId)
end
function hubTextureProtected(inst) -- never texture vitals / hub parts --
    if not inst then return true end
    local nm = "" pcall(function() nm = tostring(inst.Name or "") end)
    if nm == "_HubHitboxExpander" or nm == "_HubSkyPlat" or nm == "_HubUnderPlat" then return true end
    if string.find(nm, "_Hub", 1, true) then return true end
    local okP, prot = pcall(function()
        if inst:IsA("Humanoid") or inst:IsA("ForceField") then return true end
        if inst.Name == "HumanoidRootPart" or inst.Name == "Head" or inst.Name == "HitboxHead" or inst.Name == "HitboxBody" then return true end
        return false
    end)
    if okP and prot then return true end
    return false
end
function applyWorldTexture() -- map + you, reversible, never destroys --
    pcall(function()
        local tex = hubTextureWant()
        local mat = Enum.Material.SmoothPlastic
        pcall(function() mat = Enum.Material[Cfg.WorldTextureMat or "SmoothPlastic"] end)
        local saved = getgenv()._HubTexSaved
        if type(saved) ~= "table" then saved = {} getgenv()._HubTexSaved = saved end
        if not tex and not Cfg.WorldTextureMat then return end
        local function save(inst, prop, val) if saved[inst] == nil then saved[inst] = {} end if saved[inst][prop] == nil then saved[inst][prop] = val end end
        if Cfg.WorldTextureMap ~= false then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if hubTextureProtected(d) then continue end
                local ch = LP.Character
                if ch and d:IsDescendantOf(ch) and not Cfg.WorldTextureMe then continue end
                if d:IsA("BasePart") then
                    save(d, "Material", d.Material)
                    pcall(function() d.Material = mat end)
                    if tex and d:IsA("MeshPart") then
                        save(d, "TextureID", d.TextureID)
                        pcall(function() d.TextureID = tex end)
                    end
                end
            end
        end
        if Cfg.WorldTextureMe ~= false then
            local ch = LP.Character
            if ch then
                for _, d in ipairs(ch:GetDescendants()) do
                    if hubTextureProtected(d) then continue end
                    if d:IsA("BasePart") then
                        save(d, "Material", d.Material)
                        pcall(function() d.Material = mat end)
                    end
                    if tex and (d:IsA("Decal") or d:IsA("Texture")) then
                        save(d, "Texture", d.Texture)
                        pcall(function() d.Texture = tex end)
                    end
                end
            end
        end
    end)
end
function resetWorldTexture() -- restore all textured parts --
    pcall(function()
        local saved = getgenv()._HubTexSaved
        if type(saved) ~= "table" then return end
        for inst, props in pairs(saved) do
            pcall(function()
                if inst and inst.Parent then
                    for k, v in pairs(props) do
                        pcall(function() inst[k] = v end)
                    end
                end
            end)
        end
        getgenv()._HubTexSaved = nil
    end)
end


