            b.Size = UDim2.fromOffset(64, 64)
            b.Position = pos
            b.AutoButtonColor = true
            b.Parent = sg
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = b
            return b
        end
        local function makeDraggable(btn, keyX, keyY)
            local dragging = false
            local dragStart, startPos = nil, nil
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    dragStart = input.Position
                    startPos = btn.Position
                end
            end)
            btn.InputChanged:Connect(function(input)
                if dragging and dragStart and startPos
                    and (input.UserInputType == Enum.UserInputType.Touch
                        or input.UserInputType == Enum.UserInputType.MouseMovement) then
                    local d = input.Position - dragStart
                    btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end)
            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    dragStart = nil
                    local ok, vp = pcall(function()
                        local c = Workspace.CurrentCamera
                        if c then return c.ViewportSize end
                        return nil
                    end)
                    if ok and vp and vp.X > 0 and vp.Y > 0 then
                        Cfg[keyX] = math.clamp(btn.Position.X.Scale + btn.Position.X.Offset / vp.X, 0, 0.95)
                        Cfg[keyY] = math.clamp(btn.Position.Y.Scale + btn.Position.Y.Offset / vp.Y, 0, 0.95)
                        cfgSave()
                    end
                end
            end)
        end
        if Cfg.MobileMenuBtn then
            local mb = mkBtn("MenuBtn", "👻",
                UDim2.new(Cfg.MobileMenuX or 0.06, 0, Cfg.MobileMenuY or 0.30, 0),
                Color3.fromRGB(120, 60, 200))
            local mStart, mMoved = nil, 0
            mb.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    mStart = input.Position
                    mMoved = 0
                end
            end)
            mb.InputChanged:Connect(function(input)
                if mStart and (input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseMovement) then
                    mMoved = (input.Position - mStart).Magnitude
                end
            end)
            mb.InputEnded:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Touch
                    and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                local tap = mStart and mMoved < 12
                mStart = nil
                if tap then hubToggleUI() end
            end)
            makeDraggable(mb, "MobileMenuX", "MobileMenuY")
        end
        if Cfg.MobileAimBtn then
            local ab = mkBtn("AimBtn", "🎯",
                UDim2.new(Cfg.MobileAimX or 0.88, 0, Cfg.MobileAimY or 0.62, 0),
                Color3.fromRGB(200, 60, 60))
            ab.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    getgenv()._HubMobileAimHeld = true
                    ab.BackgroundTransparency = 0
                end
            end)
            ab.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    getgenv()._HubMobileAimHeld = false
                    ab.BackgroundTransparency = 0.25
                end
            end)
            makeDraggable(ab, "MobileAimX", "MobileAimY")
        end
    end)
end


function hubToggleUI()
    _menuOpen = not _menuOpen
    ensureDimOverlay(_menuOpen)
    local function syncPreview()
        local pv = getgenv()._HubSkinPreview
        if pv then pcall(function() pv.Enabled = _menuOpen end) end
    end
    if not Cfg.MenuAnim then
        pcall(function() Library:ToggleUI() end)
        syncPreview()
        return
    end
    local dur = (11 - math.clamp(Cfg.MenuAnimSpeed or 6, 1, 10)) * 0.1
    if _menuOpen then
        pcall(function() Library:ToggleUI() end)
        syncPreview()
        local win = findHubWindow()
        if win then
            local sc = win:FindFirstChild("_HubUIScale")
            if not sc then
                sc = Instance.new("UIScale")
                sc.Name = "_HubUIScale"
                sc.Parent = win
            end
            pcall(function()
                sc.Scale = 0.85
                TweenService:Create(sc, TweenInfo.new(dur,
                    Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { Scale = hubMenuRestScale() }):Play()
            end)
        end
    else
        local win = findHubWindow()
        local done = false
        local function hideNow()
            if done then return end
            done = true
            pcall(function() Library:ToggleUI() end)
            syncPreview()
        end
        if win then
            local sc = win:FindFirstChild("_HubUIScale")
            if not sc then
                sc = Instance.new("UIScale")
                sc.Name = "_HubUIScale"
                sc.Parent = win
            end
            local okTw = pcall(function()
                sc.Scale = hubMenuRestScale()
                local tw = TweenService:Create(sc, TweenInfo.new(dur,
                    Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    { Scale = 0.85 })
                tw.Completed:Connect(hideNow)
                tw:Play()
            end)
            if not okTw then hideNow() end
            task.delay(dur + 0.3, hideNow)
        else
            hideNow()
        end
    end
end


