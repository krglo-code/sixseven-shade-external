-- Window-wide button skins: every real Linoria button wears the theme IMAGE.
-- Linoria buttons are NOT TextButtons (the lib has exactly one, an
-- invisible modal) ??" a button is Outer Frame > Inner Frame > TextLabel, and
-- Inner always carries a UIGradient. Dropdowns share the gradient look but
-- carry an arrow ImageLabel next to their label, so they are excluded: their
-- displayed value must stay exact. Tiny "..." buttons keep text only (an
-- icon would swallow them). Display-only: values live on the option
-- objects, clicks unaffected. Base text is keyed by label instance (weak),
-- so repaints never stack glyphs and rebuilds never leak.
function hubSkinAllButtons()
    -- NOLAG: full-window sweep, at most once per 2s.
    if (getgenv()._HubSkinAt or 0) + 2 > tick() then return end
    getgenv()._HubSkinAt = tick()
    local icon = hubCurrentIcon()
    local win = findHubWindow()
    if not win then return end
    for _, d in ipairs(win:GetDescendants()) do
        if d:IsA("TextLabel") then
            local par = nil
            pcall(function() par = d.Parent end)
            if par and typeof(par) == "Instance" and par:IsA("Frame") then
                local hasGrad, hasArrow = false, false
                pcall(function()
                    for _, ch in ipairs(par:GetChildren()) do
                        if ch:IsA("UIGradient") then hasGrad = true end
                        if ch:IsA("ImageLabel") and ch.Name ~= "_HubIcon" then hasArrow = true end
                    end
                end)
                if hasGrad and not hasArrow then
                    if _hubBtnBase[d] == nil then _hubBtnBase[d] = hubGlyphOf(d.Text) end
                    local base = hubGlyphOf(_hubBtnBase[d])
                    _hubBtnBase[d] = base
                    if base ~= "" then
                        pcall(function() d.Text = base end)
                        local showIcon = icon ~= nil and #base > 3
                        pcall(function()
                            local ic = par:FindFirstChild("_HubIcon")
                            if showIcon then
                                if not ic then
                                    ic = Instance.new("ImageLabel")
                                    ic.Name = "_HubIcon"
                                    ic.BackgroundTransparency = 1
                                    ic.Active = false
                                    ic.Size = UDim2.new(0, 14, 0, 14)
                                    ic.Position = UDim2.new(0, 4, 0.5, -7)
                                    ic.ZIndex = 7
                                    ic.Parent = par
                                end
                                if ic.Image ~= icon then ic.Image = icon end
                                ic.Visible = true
                                d.Position = UDim2.new(0, 20, 0, 0)
                                d.Size = UDim2.new(1, -20, 1, 0)
                            else
                                if ic then ic.Visible = false end
                                d.Position = UDim2.new(0, 0, 0, 0)
                                d.Size = UDim2.new(1, 0, 1, 0)
                            end
                        end)
                    end
                end
            end
        end
    end
end


