-- Victim-body control after YOUR finisher lands. Modes:
-- "Finisher Default" = hands off, the finisher owns the body.
-- Ragdoll / Stiff / Freeze / Fling = hub holds the body that way.
function hubFinishRagdoll(victimModel, finisherName)
    local mode = Cfg.FinishRagdoll or "Finisher Default"
    if mode == "Finisher Default" or not victimModel then return end
    getgenv()._HubLastFinish = { name = tostring(finisherName or "?"), t = tick() }
    task.spawn(function()
        pcall(function()
            local hum = victimModel:FindFirstChildOfClass("Humanoid")
            local root = victimModel:FindFirstChild("HumanoidRootPart")
            local holdT = math.clamp(Cfg.FinishRagdollTime or 2.5, 0.5, 10)
            -- start the hold as the game's own sequence winds down (read off
            -- the inspected finisher length), so hub control never fights
            -- the finisher's opening
            pcall(function()
                local spec = getgenv()._HubFinSpec or {}
                local s = spec[tostring(finisherName or "")]
                local d = s and tonumber(s.duration) or 0
                if d and d > 0 then task.wait(math.clamp(d * 0.6, 0.25, 3)) end
            end)
            if mode == "Freeze" then
                for _, d in ipairs(victimModel:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = true
                    end
                end
                task.wait(holdT)
                for _, d in ipairs(victimModel:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                        d.Anchored = false
                    end
                end
                if root then root.Anchored = false end
            elseif mode == "Stiff" then
                if hum then hum.PlatformStand = true end
                task.wait(holdT)
                if hum and hum.Health > 0 then hum.PlatformStand = false end
            else -- Ragdoll / Fling: physics state + optional launch
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                end
                if mode == "Fling" and root then
                    local pwr = Cfg.FinishFling or 40
