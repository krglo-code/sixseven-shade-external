-- Scoped search: a wrap search only ever returns wraps, etc.
function hubSearchKind(kind, query, labelKey, plural, dropFlag, cfgKey)
    local q = string.lower(tostring(query or ""))
    local lbl = getgenv()[labelKey]
    local function show(t)
        if lbl then pcall(function() lbl:SetText(t) end) end
    end
    if q == "" then show("Type to search " .. plural .. ".") if dropFlag == "WeaponSkin" then pcall(function() hubRefreshSkins() end) elseif kind ~= "Skin" then pcall(function() hubRefreshShared() end) end return end
    local hits = {}
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            local t = type(info) == "table" and string.lower(tostring(info.Type or "")) or ""
            local kl2 = string.lower(kind)
            if t ~= "" and (t == kl2 or string.find(t, kl2, 1, true) or string.find(kl2, t, 1, true))
                and string.find(string.lower(tostring(name)), q, 1, true) then
                table.insert(hits, tostring(name))
                if #hits >= 30 then break end
            end
        end
    end)
    table.sort(hits) if #hits == 0 then show("No " .. plural .. " match '" .. tostring(query) .. "'") return end
    if dropFlag then hubSetDropdown(dropFlag, hits) end if cfgKey and hits[1] then Cfg[cfgKey] = hits[1] local o = getgenv().Options and getgenv().Options[dropFlag] if o then pcall(function() o:SetValue(hits[1]) end) end end show("> " .. tostring(hits[1]) .. ((#hits > 1) and ("\n" .. table.concat(hits, "\n", 2, math.min(#hits, 8))) or ""))
end


function hubWeaponApply()
    local w = tostring(Cfg.WeaponTabWeapon or "")
    if w == "" then
        pcall(function() Library:Notify("Weapons: pick a weapon first", 3) end)
        return
    end
    local types = { Skin = Cfg.WeaponSkin, Wrap = Cfg.WeaponWrap,
        Finisher = Cfg.WeaponFinisher, Charm = Cfg.WeaponCharm }
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local data = remotes and remotes:FindFirstChild("Data")
    local rem = data and data:FindFirstChild("EquipCosmetic")
    local n = 0
    for typ, cname in pairs(types) do
        cname = tostring(cname or "")
        if cname ~= "" and cname ~= "..." and rem then
            -- v9: resolve canonical name from the live pool first
            local want = cname
            pcall(function()
                local pool = nil
                if typ == "Skin" then pool = hubWeaponSkins(w)
                else pool = hubCosmeticPool(typ) end
                if type(pool) == "table" then
                    local cl = string.lower(cname)
                    for _, e in ipairs(pool) do
                        if string.lower(tostring(e)) == cl then want = tostring(e) break end
                    end
                end
            end)
            pcall(function()
                local opts = {}
                if typ == "Wrap" and Cfg.WeaponWrapInverted then opts = { IsInverted = true } end
                rem:FireServer(w, typ, want, opts)
                n += 1
            end)
        end
    end
    local sk = getgenv()._HubWepSkins
    if type(sk) ~= "table" then sk = {} getgenv()._HubWepSkins = sk end
    sk[w] = { skin = Cfg.WeaponSkin, wrap = Cfg.WeaponWrap,
        finisher = Cfg.WeaponFinisher, charm = Cfg.WeaponCharm }
    cfgSave()
    pcall(function() Library:Notify("Weapons: applied " .. n .. " to " .. w .. " (saved)", 3) end)
end


function hubWeaponClear()
    local w = tostring(Cfg.WeaponTabWeapon or "")
    if w == "" then return end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
