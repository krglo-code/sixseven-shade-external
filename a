function isEnemy(player)
    if player == LP then return false end
    local sc   = getSpectate()
    local duel = sc and sc.CurrentDuelSubject
    local myT  = localTeamID()
    if duel and duel.Duelers then
        for _, d in pairs(duel.Duelers) do
            if d.Player == player then
                if myT ~= nil then
                    local ok, t = pcall(function() return d:Get("TeamID") end)
                    if ok and t ~= nil then return t ~= myT end
                end
                -- dueling you with unknown teams: enemy (lobby FFA also lands here)
                return true
            end
        end
        -- in a duel but not a dueler (spectator/outsider): not a target
        local meDueling = false
        for _, d in pairs(duel.Duelers) do
            if d.Player == LP then meDueling = true break end
        end
        if meDueling then return false end
    end
    local pAttr = player:GetAttribute("TeamID")
    local lAttr = LP:GetAttribute("TeamID")
    if pAttr and lAttr then return pAttr ~= lAttr end
    if player.Team and LP.Team then return player.Team ~= LP.Team end
    return true
