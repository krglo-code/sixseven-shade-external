-- Extra emotes: game-scanned animations + your custom id. Same shape as
-- HUB_EMOTES (name -> asset-id pool, first rig-compatible id wins through
-- the same hubLoadEmoteTrack path), so everything plays uniformly.
getgenv()._HubEmoteExtra = getgenv()._HubEmoteExtra or {}


function hubEmoteIdsFor(name)
    if HUB_EMOTES[name] then return HUB_EMOTES[name] end
    local ex = getgenv()._HubEmoteExtra
    if type(ex) == "table" and ex[name] then return ex[name] end
    return nil
end


function hubEmoteNames()
    local out, seen = {}, {}
    local function push(nm)
        nm = tostring(nm or "")
        if nm ~= "" and nm ~= "..." and not seen[nm] then seen[nm] = true table.insert(out, nm) end
    end
    for nm in pairs(HUB_EMOTES) do push(nm) end
    local ex = getgenv()._HubEmoteExtra
    if type(ex) == "table" then
        for nm in pairs(ex) do push(nm) end
    end
    table.sort(out)
    return out
end


function hubEmoteCleanName(s)
    s = tostring(s or ""):gsub("[%c%z]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #s > 40 then s = s:sub(1, 40) end
    return s
end


-- Deep emote-library reader: ReplicatedStorage.Modules.*Emote* ??" the file
-- with ALL the emotes. Handles a ModuleScript table (required and dumped
-- exactly like the skins code already does for CosmeticLibrary), folders of
-- Animation instances, and value objects. Caps everywhere so a weirdly
-- shaped library can never hang the scan.
function hubEmoteScanModules()
    local added = 0
    local ex = getgenv()._HubEmoteExtra
    if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
    local function add(name, id)
        name = hubEmoteCleanName(name)
        local digits = tostring(id or ""):match("(%d+)")
        if name == "" or not digits or #digits < 5 then return end
        if HUB_EMOTES[name] then return end
        ex[name] = ex[name] or {}
        local asset = "rbxassetid://" .. digits
        for _, e in ipairs(ex[name]) do if e == asset then return end end
        if #ex[name] == 0 then added += 1 end
        table.insert(ex[name], asset)
        if #ex[name] > 4 then table.remove(ex[name], 1) end
    end
    local function dumpTable(t, depth, seen)
        if depth > 4 or type(t) ~= "table" then return end
        if seen[t] then return end
        seen[t] = true
        local n = 0
        for k, v in pairs(t) do
            n += 1
            if n > 500 then break end
            if type(v) == "string" then
                if type(k) == "string" and v:match("%d+") then add(k, v) end
            elseif type(v) == "number" then
                if type(k) == "string" then
                    local digits = tostring(math.floor(v)):match("(%d+)")
                    if digits and #digits >= 8 then add(k, v) end
                end
            elseif type(v) == "table" then
                local nm, id = nil, nil
                pcall(function()
                    if type(v.Name) == "string" then nm = v.Name end
                    for _, fk in ipairs({ "AnimationId", "Id", "ID", "AssetId", "AssetID" }) do
                        local fv = v[fk]
                        if type(fv) == "string" and fv:match("%d+") then id = fv break end
                        if type(fv) == "number" then id = tostring(fv) break end
                    end
                end)
                if nm and id then add(nm, id)
                else dumpTable(v, depth + 1, seen) end
            elseif typeof(v) == "Instance" then
                local okIsAn, isAn = pcall(function() return v:IsA("Animation") end)
                if okIsAn and isAn then
                    local aid = ""
                    pcall(function() aid = v.AnimationId end)
                    add((type(k) == "string" and k) or v.Name, aid)
                end
            end
        end
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cands = {}
        if mods then
            for _, c in ipairs(mods:GetChildren()) do
                local nm = ""
                pcall(function() nm = string.lower(c.Name or "") end)
                local kind = nil
                if nm == "emotes" or string.find(nm, "emote", 1, true) then kind = "full"
                elseif string.find(nm, "dance", 1, true) then kind = "full"
                elseif string.find(nm, "animation", 1, true) then kind = "walk" end
                if kind then table.insert(cands, { inst = c, kind = kind }) end
            end
        end
        local top = ReplicatedStorage:FindFirstChild("Emotes")
        if top then table.insert(cands, { inst = top, kind = "full" }) end
        for _, e in ipairs(cands) do
            local c, kind = e.inst, e.kind
            local isMod = false
            pcall(function() isMod = c:IsA("ModuleScript") end)
            if isMod and kind == "full" then
                local okM, lib = pcall(require, c)
                if okM and type(lib) == "table" then dumpTable(lib, 1, {}) end
            else
                pcall(function()
                    local scanned = 0
                    for _, d in ipairs(c:GetDescendants()) do
                        scanned += 1
                        if scanned > 600 then break end
                        if d:IsA("Animation") then
                            local aid = ""
                            pcall(function() aid = d.AnimationId end)
                            add(d.Name, aid)
                        elseif d:IsA("StringValue") then
                            local sv = ""
                            pcall(function() sv = d.Value end)
                            if tostring(sv):match("%d+") then add(d.Name, sv) end
                        elseif d:IsA("ModuleScript") then
                            local okM, lib = pcall(require, d)
                            if okM and type(lib) == "table" then dumpTable(lib, 1, {}) end
                        end
                    end
                end)
            end
        end
    end)
    return added
end


-- Cosmetic emotes: the same library that holds skins/finishers/charms often
-- holds Type=="Emote" entries too. Names always list (that's the catalog);
-- ids ride along when the entry carries one, otherwise playback falls back
-- to the engine pipe by raw name.
function hubEmoteScanCosmetics()
    local added = 0
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        local ex = getgenv()._HubEmoteExtra
        if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
        for name, info in pairs(all) do
            if type(info) == "table" and string.lower(tostring(info.Type or "")) == "emote" then
                if not HUB_EMOTES[name] and not ex[name] then
                    local ids = {}
                    for _, fk in ipairs({ "AnimationId", "Id", "ID", "AssetId", "AssetID", "EmoteId" }) do
                        local fv = info[fk]
                        local digits = type(fv) == "string" and fv:match("(%d+)")
                            or (type(fv) == "number" and tostring(fv):match("(%d+)"))
                        if digits and #digits >= 5 then table.insert(ids, "rbxassetid://" .. digits) end
                    end
                    ex[name] = ids
                    added += 1
                end
            end
        end
    end)
    return added
end


-- Scan the game for emote animations (emote folders, Animation instances,
-- emote shop UI) and merge them into the dropdown. Read-only, re-runnable.
function hubEmoteScan()
    local found = {}
    getgenv()._HubEmoteRemotes = nil
    local function addId(name, id)
        name = hubEmoteCleanName(name)
        local digits = tostring(id or ""):match("(%d+)")
        if name == "" or not digits then return end
        if HUB_EMOTES[name] then return end
        found[name] = found[name] or {}
        local asset = "rbxassetid://" .. digits
        for _, e in ipairs(found[name]) do if e == asset then return end end
        table.insert(found[name], asset)
        if #found[name] > 4 then table.remove(found[name], 1) end
    end
    pcall(function()
        local roots = {}
        if ReplicatedStorage then table.insert(roots, ReplicatedStorage) end
        local ps = LP:FindFirstChildOfClass("PlayerScripts")
        if ps then table.insert(roots, ps) end
        if LP.PlayerGui then table.insert(roots, LP.PlayerGui) end
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                local isEmoteBin = false
                pcall(function()
                    if string.find(string.lower(d.Name or ""), "emote", 1, true) then
                        isEmoteBin = true
                    end
                end)
                if isEmoteBin then
                    if d:IsA("Animation") then
                        pcall(function() addId(d.Name, d.AnimationId) end)
                    end
                    pcall(function()
                        for _, c in ipairs(d:GetDescendants()) do
                            if c:IsA("Animation") then addId(c.Name, c.AnimationId) end
                        end
                    end)
                elseif d:IsA("Animation") then
                    local dn = ""
                    pcall(function() dn = string.lower(d.Name or "") end)
                    if string.find(dn, "dance", 1, true) or string.find(dn, "floss", 1, true)
                        or string.find(dn, "wave", 1, true) or string.find(dn, "cheer", 1, true)
                        or string.find(dn, "dab", 1, true) or string.find(dn, "shuffle", 1, true)
                        or string.find(dn, "groove", 1, true) or string.find(dn, "party", 1, true) then
                        pcall(function() addId(d.Name, d.AnimationId) end)
                    end
                end
            end
        end
    end)
    local ex = getgenv()._HubEmoteExtra
    if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
    local n = 0
    for nm, ids in pairs(found) do
        if not HUB_EMOTES[nm] then ex[nm] = ids n += 1 end
    end
    -- the Modules emote library itself (all the emotes in one file)
    pcall(function() n += hubEmoteScanModules() end)
    -- cosmetic emotes riding in CosmeticLibrary next to the finishers
    pcall(function() n += hubEmoteScanCosmetics() end)
    if Cfg.EmoteCustomId ~= "" then
        local digits = tostring(Cfg.EmoteCustomId):match("(%d+)")
        if digits then ex["Custom"] = { "rbxassetid://" .. digits } end
    end
    hubRefreshEmotes()
    return n
end


function hubRefreshEmotes()
    local names = hubEmoteNames()
    if #names == 0 then return end
    hubSetDropdown("EmoteName", names)
    local cur = tostring(Cfg.EmoteName or "")
    if cur == "" or cur == "..." then
        Cfg.EmoteName = names[1]
        local o = getgenv().Options and getgenv().Options.EmoteName
        if o then pcall(function() o:SetValue(names[1]) end) end
