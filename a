-- Weather atmosphere: our own instance so the look survives without the
-- missing FogEnabled switch and survives duel Lighting wipes (recreated).
function hubWeatherAtmo(preset)
    pcall(function()
        local at = Lighting:FindFirstChild("_HubWeatherAtmo")
        if preset == nil or preset.atmoD == nil then
            if at then at:Destroy() end
            return
        end
        if not at then
            at = Instance.new("Atmosphere")
            at.Name = "_HubWeatherAtmo"
            at.Parent = Lighting
        end
        at.Density = preset.atmoD or 0.3
        at.Offset = preset.atmoO or 0.2
        local c = preset.atmoC or preset.fogC or preset.amb
        if c then at.Color = Color3.fromRGB(c[1], c[2], c[3]) end
    end)
end


function hubWeatherEnforce()
    local w = Cfg.WorldWeather or "None"
    if w == "None" then return end
    local ok = false
