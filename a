function predictedPosition(cam, part, speed)
    speed = speed or 250
    local dist      = (cam.CFrame.Position - part.Position).Magnitude
    local tOfFlight = dist / speed
    local vel       = Vector3.zero
    pcall(function() vel = part.AssemblyLinearVelocity end)
    return part.Position + vel * tOfFlight * Cfg.AimPredFactor
end


-- ?"??"? Trigonometry solver: angle-based lead + circular smoothing.
function trigLeadPosition(cam, part, speed)
    speed = speed or 250
    local cp = cam.CFrame.Position
    local tp = part.Position
    local dx, dy, dz = tp.X - cp.X, tp.Y - cp.Y, tp.Z - cp.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    local t = dist / speed
    local vel = Vector3.zero
    pcall(function() vel = part.AssemblyLinearVelocity end)
    local lead = Cfg.AimTrigLead or 1.0
    return tp + vel * t * lead
end


function trigAngleLerp(cam, targetPos, smooth)
    smooth = math.max(1, smooth or Cfg.AimTrigSmooth or 8)
    local cp = cam.CFrame.Position
    local cur = cam.CFrame.LookVector
    local curYaw = math.atan2(-cur.X, -cur.Z)
    local curPitch = math.asin(math.clamp(cur.Y, -1, 1))
    local dx, dy, dz = targetPos.X - cp.X, targetPos.Y - cp.Y, targetPos.Z - cp.Z
    local flat = math.sqrt(dx * dx + dz * dz)
    local wantYaw = math.atan2(-dx, -dz)
    local wantPitch = math.atan2(dy, flat)
    local dYaw = (wantYaw - curYaw + math.pi) % (math.pi * 2) - math.pi
    local dPitch = wantPitch - curPitch
    local ny = curYaw + dYaw / smooth
    local np = curPitch + dPitch / smooth
    local cp2 = math.cos(np)
    return Vector3.new(-math.sin(ny) * cp2, math.sin(np), -math.cos(ny) * cp2)
end


-- ?"??"? Smoothing modes + human layer. Returns scaled mouse delta.
-- ?"??"? AIMBOT CORE v4 ??" single coherent engine (flicker rebuild).
-- One master rate (Speed) drives mouse + camera + gameplay feel together.
-- Response shapes the curve. Every step is dt-correct so 60/120/240Hz
-- feel identical. Deadzone is soft (feathered, never a hard stop/start).
-- Steering path (mouse vs camera) latches per lock: no mid-lock FP/TP flips.
function hubAimRate()
    local sp = math.clamp(tonumber(Cfg.AimbotSpeed) or 50, 1, 100)
    -- floor: rate 2 feels dead (reads as "aimbot broken"), 5 stays alive
    return math.max(5, 2 + (sp / 100) ^ 1.5 * 38)
end

