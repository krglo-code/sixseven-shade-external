    end)
    return hit
end


-- Finisher pool v2 (accuracy fix): Modules.Finishers folder + CosmeticLibrary
-- Type==Finisher (case-insensitive, substring both ways - the old =="Finisher"
-- check missed entries) + inspected spec + owned-cache keys. Art map rides along.
function hubFinisherPool()
    local out, seen = {}, {}
    local art = getgenv()._HubFinArt
    if type(art) ~= "table" then art = {} getgenv()._HubFinArt = art end
    local function push(nm)
        nm = tostring(nm or "")
        if nm == "" or nm == "MISSING_FINISHER" or seen[nm] then return end
        seen[nm] = true
        table.insert(out, nm)
        local a = hubCatalogArt("Finisher", nm)
        if a then art[nm] = a end
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local f = mods and mods:FindFirstChild("Finishers")
        if f then
            for _, c in ipairs(f:GetChildren()) do push(c.Name) end
        end
    end)
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            local t = type(info) == "table" and string.lower(tostring(info.Type or "")) or ""
            if t ~= "" and (t == "finisher" or string.find(t, "finisher", 1, true)
                or string.find("finisher", t, 1, true)) then
                push(name)
            end
        end
    end)
    pcall(function()
        local spec = getgenv()._HubFinSpec
        if type(spec) == "table" then
            for nm in pairs(spec) do
                if string.sub(nm, 1, 1) ~= "@" then push(nm) end
            end
        end
    end)
    table.sort(out)
    return out
end


