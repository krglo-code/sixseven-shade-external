function hubWeaponItems()
    local fc = getFC()
    local lf = fc and fc.LocalFighter
    if lf and type(lf.Items) == "table" then return lf.Items end
    return {}
end


function hubFindWeapon(name)
    if not name or name == "" then return nil end
    for _, it in pairs(hubWeaponItems()) do
        local ok, nm = pcall(function() return tostring(it.Name) end)
        if ok and string.lower(nm) == string.lower(tostring(name)) then return it end
    end
    return nil
end


-- Slot catalogs (mirror the loadout lists): slot truth even out-of-game.
HUB_SLOT_WEAPONS = {
    Primary = { "Assault Rifle", "Bow", "Burst Rifle", "Crossbow", "Distortion", "Energy Rifle", "Flamethrower", "Grenade Launcher", "Gunblade", "Minigun", "Paintball Gun", "Permafrost", "RPG", "Shotgun", "Sniper", "Wildcat" },
    Secondary = { "Daggers", "Energy Pistols", "Exogun", "Flare Gun", "Glass Cannon", "Handgun", "Revolver", "Scepter", "Shorty", "Slingshot", "Spray", "Uzi", "Warper" },
    Melee = { "Battle Axe", "Chainsaw", "Fists", "Glast Shard", "Katana", "Knife", "Maul", "Riot Shield", "Scythe", "Spear", "Trowel" },
    Utility = { "Elixir", "Flashbang", "Freeze Ray", "Grappler", "Grenade", "Jump Pad", "Medkit", "Molotov", "RNG Dice", "Satchel", "Smoke Grenade", "Subspace Tripmine", "War Horn", "Warpstone" },
}


-- Full weapon catalog, NO slot split: one list with every weapon.
-- Sources: equipped fighter items + truly-owned data + ItemLibrary + static
-- catalog fallback. Used by the single Weapon dropdown (no Slot dropdown).
function hubAllWeapons()
    local out = {}
    local seen = {}
    local function push(nm)
        nm = tostring(nm or "")
        if nm ~= "" and nm ~= "..." and not seen[nm] then seen[nm] = true table.insert(out, nm) end
    end
    for _, it in pairs(hubWeaponItems()) do
        pcall(function() push(it.Name) end)
    end
    pcall(function()
        local ps = LP:FindFirstChildOfClass("PlayerScripts")
        local ct = ps and ps:FindFirstChild("Controllers")
        local dc = ct and (ct:FindFirstChild("PlayerDataController") or ct:FindFirstChild("DataController"))
        local mod = dc and require(dc)
        if mod and mod.GetUnlockedWeapons then
            local un = mod:GetUnlockedWeapons()
            if type(un) == "table" then
                for name in pairs(un) do push(name) end
            end
        end
    end)
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local im = mods and mods:FindFirstChild("ItemLibrary")
        local lib = im and require(im)
        local items = lib and lib.Items or {}
        for name in pairs(items) do
            if type(name) == "string" then push(name) end
        end
    end)
    -- static catalog fills whatever detection missed so the list is never empty
    for _, slot in ipairs({ "Primary", "Secondary", "Melee", "Utility" }) do
        for _, known in ipairs(HUB_SLOT_WEAPONS[slot] or {}) do push(known) end
    end
    table.sort(out)
    while #out > 120 do table.remove(out) end
    return out
end


function hubSlotWeapons(slot)
    -- Slot filtering removed: one unified list (kept as wrapper so old
    -- callers keep working).
    return hubAllWeapons()
end


