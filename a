                    end)
                    if string.find(nm, "equip", 1, true) or string.find(nm, "deploy", 1, true)
                        or string.find(nm, "draw", 1, true) or string.find(nm, "holster", 1, true)
                        or string.find(nm, "unequip", 1, true) then
