-- -- CARD CATALOG: game-style tile grid (Skins / Wraps / Charms / Finishers).
-- Custom overlay (Linoria has no grids): category tabs, search, Apply-To
-- weapon cycler, red-underline selection + check badge, Apply+Save.
-- Art is always the game's own ViewModel/cosmetic images, never custom files.
-- GUI scraper: the game's own weapon-customizer cards (the Skins / Wraps /
-- Charms / Finishers catalog UI ingame) carry the true art. Walk likely
-- panels, pair each Image with the TextLabel card name next to it.
-- Throttled: one PlayerGui sweep per 5s max, ~400 entries cap.
function hubCatalogScrapeGUI()
    local map = getgenv()._HubCatGUI
    if type(map) ~= "table" then map = {} getgenv()._HubCatGUI = map end
    if (getgenv()._HubCatScanAt or 0) + 5 > tick() then return map end
    getgenv()._HubCatScanAt = tick()
    pcall(function()
        local pg = LP.PlayerGui
        if not pg then return end
        local panels = {}
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("GuiObject") then
                local nm = ""
                pcall(function() nm = string.lower(d.Name or "") end)
                if string.find(nm, "custom", 1, true) or string.find(nm, "loadout", 1, true)
                    or string.find(nm, "locker", 1, true) or string.find(nm, "catalog", 1, true)
                    or string.find(nm, "skin", 1, true) or string.find(nm, "wrap", 1, true)
                    or string.find(nm, "charm", 1, true) or string.find(nm, "finisher", 1, true)
                    or string.find(nm, "weapon", 1, true) or string.find(nm, "equip", 1, true)
                    or string.find(nm, "inventory", 1, true) then
                    table.insert(panels, d)
                    if #panels > 12 then break end
                end
            end
        end
        if #panels == 0 then
            local mg = pg:FindFirstChild("MainGui")
            if mg then table.insert(panels, mg) end
        end
        local n = 0
        for _, panel in ipairs(panels) do
            for _, img in ipairs(panel:GetDescendants()) do
                local isImg = false
                pcall(function() isImg = img:IsA("ImageLabel") or img:IsA("ImageButton") end)
                if isImg then
                    local src = ""
                    pcall(function() src = img.Image end)
                    if type(src) == "string" and src ~= "" then
                        local sz = Vector2.zero
                        pcall(function() sz = img.AbsoluteSize end)
                        if sz.X >= 20 and sz.Y >= 20 then
                            -- the image's own name is often the item name
                            local inm = ""
                            pcall(function() inm = tostring(img.Name or "") end)
                            if inm ~= "" and inm ~= "ImageLabel" and inm ~= "ImageButton"
                                and inm ~= "Art" and #inm <= 40 and map[inm] == nil then
                                map[inm] = src
                                n += 1
                            end
                            -- else: nearest TextLabel under the same card
                            local card = img.Parent
                            for depth = 1, 2 do
                                if not card then break end
                                local found = nil
                                pcall(function()
                                    for _, t in ipairs(card:GetDescendants()) do
                                        if t:IsA("TextLabel") then
                                            local tx = tostring(t.Text or "")
                                            if #tx >= 2 and #tx <= 40 then found = tx break end
                                        end
                                    end
                                end)
                                if found and map[found] == nil then
                                    map[found] = src
                                    n += 1
                                    break
                                end
                                card = card.Parent
                            end
                        end
                    end
                end
                if n >= 400 then return end
            end
        end
    end)
    return map
end


