HEAD_NAMES  = { "HitboxHead", "PhysicalHitboxHead", "HitboxHeadSmall", "Head" }
TORSO_NAMES = { "HitboxBody", "PhysicalHitboxBody", "UpperTorso", "LowerTorso", "Torso" }


BOX_PART_NAMES = {
    "Head","HumanoidRootPart",
    "UpperTorso","LowerTorso","Torso",
    "LeftUpperArm","RightUpperArm",
    "LeftLowerArm","RightLowerArm",
    "LeftUpperLeg","RightUpperLeg",
    "LeftLowerLeg","RightLowerLeg",
    "Left Arm","Right Arm","Left Leg","Right Leg",
}


function findPartByNames(model, names)
    for _, n in ipairs(names) do
        local p = model:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return nil
end


function headOf(model)
    return findPartByNames(model, HEAD_NAMES)
        or model:FindFirstChild("HumanoidRootPart")
end


function torsoOf(model)
    return findPartByNames(model, TORSO_NAMES)
        or headOf(model)
end


function aimBoneOf(model, cam, mode)
    mode = mode or Cfg.AimBone
    if mode == "Closest" then mode = "Nearest" end
    if mode == "Head"   then return headOf(model) end
    if mode == "Torso"  then return torsoOf(model) end
    if mode == "Random" then
        return math.random() < 0.6 and headOf(model) or torsoOf(model)
    end
    if mode == "Nearest" then
        local cx = cam.ViewportSize.X / 2
        local cy = cam.ViewportSize.Y / 2
        local hd = headOf(model)
        local tr = torsoOf(model)
        if not hd then return tr end
        if not tr then return hd end
        local hs = cam:WorldToViewportPoint(hd.Position)
        local ts = cam:WorldToViewportPoint(tr.Position)
        local hd2 = (hs.X - cx)^2 + (hs.Y - cy)^2
        local td2 = (ts.X - cx)^2 + (ts.Y - cy)^2
        return hd2 <= td2 and hd or tr
    end
    return headOf(model)
end


function modelAlive(model)
    if not model then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end


function getHumanoid(model)
    return model and model:FindFirstChildOfClass("Humanoid")
end


function healthFraction(model)
    local h = getHumanoid(model)
    if not h or h.MaxHealth <= 0 then return 1 end
    return math.clamp(h.Health / h.MaxHealth, 0, 1)
end


