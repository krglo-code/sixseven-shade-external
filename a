    local t = HUB_THEMES[Cfg.HubTheme or "Default"] or HUB_THEMES.Default
    -- layer 1: flat theme color (no fade lines). Sits behind the picture so
    -- a dead image still leaves a clean themed backdrop, never blank.
    local grad = host:FindFirstChild("_HubBGGrad")
    if Cfg.BgNone then
        if grad then pcall(function() grad:Destroy() end) end
