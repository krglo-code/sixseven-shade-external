-- Generic preset applier: one table, one scale map, all widgets follow.
-- Every preset below (aim / trigger / rage / silent) runs through this,
-- so loading a config always moves the menu AND the engine together.
function hubApplyPresetTable(preset, scaled, label)
    if type(preset) ~= "table" then return end
    scaled = scaled or {}
    local opts = getgenv().Options
    for k, v in pairs(preset) do
        Cfg[k] = v
        if opts then
            local o = opts[k]
            if o then
                pcall(function()
                    if o.SetValue and (o.Type == "Toggle" or o.Type == "Dropdown") then
                        o:SetValue(v)
                    elseif o.SetValue and o.Type == "Slider" then
                        local mult = scaled[k] or 1
                        o:SetValue(math.floor(v * mult + 0.5))
                    end
                end)
            end
        end
    end
    cfgSave()
    if label then
        pcall(function() Library:Notify(label .. tostring(""), 2) end)
    end
end


-- Two-way widget sync for the unified aimbot front-end. Every control that
-- mirrors an engine key pushes here, guarded so widgets never ping-pong.
-- Call it after any config load and every preset: menu matches Cfg always.
function hubSyncAimUI()
    if getgenv()._HubSyncBusy then return end
    getgenv()._HubSyncBusy = true
    pcall(function()
        local opts = getgenv().Options
        if not opts then return end
        local function setT(flag, val)
            local o = opts[flag]
            if o and o.SetValue and o.Type == "Toggle" then
                pcall(function() o:SetValue(val and true or false) end)
            end
        end
        local function setD(flag, val)
            local o = opts[flag]
            if o and o.SetValue and o.Type == "Dropdown" then
                pcall(function() o:SetValue(val) end)
            end
        end
        local function setS(flag, val)
            local o = opts[flag]
            if o and o.SetValue and o.Type == "Slider" then
                pcall(function() o:SetValue(val) end)
            end
        end
        setT("AimbotToggle", Cfg.AimEnabled)
        setT("MiniAimEnabled", Cfg.AimEnabled)
        setT("AimEnabled", Cfg.AimEnabled)
        setD("AimbotMode", Cfg.AimbotMode or "Rage")
        local lockBone = (Cfg.AimBone == "Torso") and "Torso" or "Head"
        setD("AimbotLock", lockBone)
        setD("AimBone", Cfg.AimBone)
        setD("AimTargetPart", Cfg.AimTargetPart)
        setT("AimbotAutoFire", Cfg.AimbotAutoFire)
        setT("AimbotPrediction", Cfg.AimPrediction)
        setT("AimPrediction", Cfg.AimPrediction)
        setS("AimbotSensitivity", math.floor((Cfg.AimbotSensitivity or 1) * 10 + 0.5))
        setD("AimbotPriority", Cfg.AimbotPriority or "Distance")
        setD("AimPriority", Cfg.AimPriority)
        setS("AimbotMaxDistance", Cfg.AimbotMaxDistance or 0)
        setS("AimMaxDist", Cfg.AimMaxDist)
        setT("AimLimitDistance", Cfg.AimLimitDistance)
        setT("AimbotDeadCheck", Cfg.AimbotDeadCheck)
        setT("AimIgnoreKnocked", Cfg.AimIgnoreKnocked)
        setT("AimbotWallCheck", Cfg.AimbotWallCheck)
        setT("AimWallCheck", Cfg.AimWallCheck)
        setT("AimDuelOnly", Cfg.AimDuelOnly ~= false)
        setS("AimbotFOV", Cfg.AimFOV)
        setS("AimFOV", Cfg.AimFOV)
        setS("AimSmoothingLegacy", Cfg.AimSmoothing)
