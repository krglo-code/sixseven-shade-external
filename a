function normSoundId(s)
    s = tostring(s or ""):gsub("%s+", "")
    if s == "" then return nil end
    if s:find("rbxassetid://", 1, true) then return s end
    local id = s:match("(%d+)")
    if id then return "rbxassetid://" .. id end
    return nil
end


function getCustomSound(name)
    local s = Workspace:FindFirstChild(name)
    if not (s and s:IsA("Sound")) then
        s = Instance.new("Sound")
        s.Name   = name
        s.Looped = false
        s.Parent = Workspace
    end
    return s
end


-- Sound source: your file wins (Shade External/sounds/ via getcustomasset),
-- otherwise the asset id box. Same pattern as menu pictures.
function hubSoundWant(rawId, filePath)
    if filePath ~= nil and filePath ~= "" and type(getcustomasset) == "function" then
        local ok, a = pcall(getcustomasset, filePath)
        if ok and type(a) == "string" and a ~= "" then return a end
    end
    return normSoundId(rawId)
end


function playCustomSound(name, rawId, vol)
    local sid = normSoundId(rawId)
    if not sid then return end
    pcall(function()
        local s = getCustomSound(name)
        if s.SoundId ~= sid then s.SoundId = sid end
        s.Volume = vol or 0.7
        if s.IsPlaying then s:Stop() end
        s:Play()
    end)
end


-- Pre-resolved id (file path or asset link): never re-normalized, digits in
-- local paths must survive untouched.
function playCustomSoundResolved(name, sid, vol)
    if type(sid) ~= "string" or sid == "" then return end
    pcall(function()
        local s = getCustomSound(name)
        if s.SoundId ~= sid then s.SoundId = sid end
        s.Volume = vol or 0.7
        if s.IsPlaying then s:Stop() end
        s:Play()
    end)
end


function playHitSound()
    if Cfg.HitSoundEnabled then
        local sid = hubSoundWant(Cfg.HitSoundId, Cfg.HitSoundFile)
        if sid then playCustomSoundResolved("HubHitSound", sid, Cfg.HitSoundVol) end
    end
end


function playKillSound()
    if Cfg.KillSoundEnabled then
        local sid = hubSoundWant(Cfg.KillSoundId, Cfg.KillSoundFile)
        if sid then playCustomSoundResolved("HubKillSound", sid, Cfg.KillSoundVol) end
    end
end


-- Notification router: every hub popup flows through here so Settings >
