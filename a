-- File-list dropdowns: files dropped in the workspace folders appear as
-- options automatically (boot, Refresh List, and every ~5s in game).
-- Per-dropdown signatures skip no-op rebuilds so open lists never flicker.
function hubListFiles(folder, exts)
    local out = {}
    pcall(function()
        if type(listfiles) ~= "function" or type(isfolder) ~= "function" then return end
        if not isfolder(folder) then return end
        local okL, files = pcall(listfiles, folder)
        if not okL or type(files) ~= "table" then return end
        for _, f in ipairs(files) do
            local nm = tostring(f):match("([^/\\]+)$") or tostring(f)
            if exts then
                local ext = nm:match("%.([%w]+)$")
                local good = false
                if ext then
                    ext = string.lower(ext)
                    for _, e in ipairs(exts) do
                        if ext == e then good = true break end
                    end
                end
                if not good then continue end
            end
            table.insert(out, nm)
        end
    end)
    table.sort(out)
    return out
end


