                g.Parent = win
            end
            g.Position = rightSide and UDim2.new(1, -32, 0, 0) or UDim2.new(0, 2, 0, 0)
            g.Visible = true
            -- idle bob, started once per label
            if not g:GetAttribute("_HubBob") then
                g:SetAttribute("_HubBob", 1)
                task.spawn(function()
                    local up = true
                    while g.Parent do
                        local y = g.Position.Y.Offset + (up and 5 or -5)
