-- Chroma: hex-cycle render color when ESPChroma is on, else the set box color.
function hubEspColor(base)
    if not Cfg.ESPChroma then return base end
    local t = tick() * (Cfg.ESPChromaSpeed or 4) * 0.15
    return Color3.fromHSV(t % 1, 0.85, 1)
end


function paintESPCorners(d, bx, by, bw, bh, col)
    local L = math.min(bw, bh) * 0.28
    local pts = {
        { bx, by, bx + L, by }, { bx, by, bx, by + L },
        { bx + bw - L, by, bx + bw, by }, { bx + bw, by, bx + bw, by + L },
        { bx, by + bh - L, bx, by + bh }, { bx, by + bh, bx + L, by + bh },
        { bx + bw, by + bh - L, bx + bw, by + bh }, { bx + bw - L, by + bh, bx + bw, by + bh },
    }
    for i = 1, 8 do
        local c = d["corner" .. i]
        if c then
            c.From = Vector2.new(pts[i][1], pts[i][2])
            c.To = Vector2.new(pts[i][3], pts[i][4])
            c.Color = col
            c.Visible = true
        end
    end
end


function hideESPCorners(d)
    for i = 1, 8 do
        local c = d["corner" .. i]
        if c then pcall(function() c.Visible = false end) end
    end
    for i = 1, 6 do
        local s = d["skel" .. i]
        if s then pcall(function() s.Visible = false end) end
    end
end


function espWeaponName(model)
    local best, bestN = nil, 0
    pcall(function()
        for _, t in ipairs(model:GetChildren()) do
            if t:IsA("Tool") then
                local n = #t:GetDescendants()
                if n >= bestN then best, bestN = t.Name, n end
            end
        end
    end)
    if best then return best end
    local fc = getFC()
    pcall(function()
        if fc and type(fc.Objects) == "table" then
            for _, f in pairs(fc.Objects) do
                if type(f) == "table" and f.Entity and type(f.Entity) == "table" then
                    if f.Entity.Model == model and f.EquippedItem then
                        best = tostring(f.EquippedItem.Name or "")
                    end
                end
            end
        end
    end)
    return best or ""
end


function paintESPSkeleton(d, model, cam, col)
    local function sp(part)
        if not part then return nil end
        local s, on = cam:WorldToViewportPoint(part.Position)
        return on and Vector2.new(s.X, s.Y) or nil
    end
    local pairs = {
        { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
        { "UpperTorso", "LeftUpperArm" }, { "UpperTorso", "RightUpperArm" },
        { "LowerTorso", "LeftUpperLeg" }, { "LowerTorso", "RightUpperLeg" },
    }
    for i, pr in ipairs(pairs) do
        local a = model:FindFirstChild(pr[1])
        local b = model:FindFirstChild(pr[2])
        local pa, pb = sp(a), sp(b)
        local line = d["skel" .. i]
        if line and pa and pb then
            line.From, line.To, line.Color, line.Visible = pa, pb, col, true
        elseif line then
            line.Visible = false
        end
    end
end


