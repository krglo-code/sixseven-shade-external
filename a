function compute2DBox(model, cam)
    -- Lite mode: 2 projections (head-top + root-bottom) instead of ~128.
    -- Nearly free, slightly boxier. Full mode below for pretty boxes.
    if Cfg.ESPLite then
        local root = model:FindFirstChild("HumanoidRootPart")
        local head = headOf(model)
        if not (root and head) then return nil end
        local top = head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.6, 0)
        local bot = root.Position - Vector3.new(0, 3.1, 0)
        local tsp, ton = cam:WorldToViewportPoint(top)
        local bsp, bon = cam:WorldToViewportPoint(bot)
        if (not ton and not bon) or (tsp.Z <= 0 and bsp.Z <= 0) then return nil end
        local y1 = math.min(tsp.Y, bsp.Y)
        local y2 = math.max(tsp.Y, bsp.Y)
        local h = math.max(8, y2 - y1)
        local w = h * 0.62
        local x = (tsp.X + bsp.X) * 0.5 - w * 0.5
        return x, y1, w, h
    end
    local minX, minY =  math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false


    for _, name in ipairs(BOX_PART_NAMES) do
        local part = model:FindFirstChild(name)
        if not (part and part:IsA("BasePart")) then continue end
        -- Skip our own expander parts
        if name == "_HubHitboxExpander" then continue end
        local hx = part.Size.X * 0.5
        local hy = part.Size.Y * 0.5
        local hz = part.Size.Z * 0.5
        for sx = -1, 1, 2 do
            for sy = -1, 1, 2 do
                for sz = -1, 1, 2 do
                    local worldCorner = (part.CFrame * CFrame.new(sx*hx, sy*hy, sz*hz)).Position
                    local sp, on = cam:WorldToViewportPoint(worldCorner)
                    if on and sp.Z > 0 then
                        any = true
                        if sp.X < minX then minX = sp.X end
                        if sp.Y < minY then minY = sp.Y end
                        if sp.X > maxX then maxX = sp.X end
                        if sp.Y > maxY then maxY = sp.Y end
                    end
                end
            end
        end
    end


    if not any then return nil end
    return minX, minY, maxX - minX, maxY - minY
end


