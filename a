-- Per-frame easing factor from master rate + response curve.
function hubAimAlpha(dtF)
    local k = hubAimRate()
    local step = dtF
    if Cfg.AimFrameIndependent == false then step = 1 / 60 end
    step = math.clamp(step or (1 / 60), 0.005, 0.1)
    local a = 1 - math.exp(-step * k)
    local resp = Cfg.AimbotResponse or "Smooth"
    if resp == "Smooth" then
        a = a * a * (3 - 2 * a)
    elseif resp == "Snappy" then
        a = a ^ 0.7
    end
    return math.clamp(a, 0.01, 0.99)
end

-- Steering path with stability latch: FP flips need 0.5s to stick, and the
-- render loop re-latches only on a NEW lock, so the path can't flicker mid-fight.
function hubAimPath(cam)
    local steer = Cfg.AimbotSteer or "Auto"
    if steer == "Mouse" then return "mouse" end
    if steer == "Camera" then return "camera" end
    local now = tick()
    local fp = hubFirstPerson(cam)
    if fp ~= getgenv()._HubAimFP then
        if (getgenv()._HubAimFPAt or 0) + 0.5 < now then
            getgenv()._HubAimFP = fp
            getgenv()._HubAimFPAt = now
        else
            fp = getgenv()._HubAimFP
            if fp == nil then fp = hubFirstPerson(cam) end
        end
    else
        getgenv()._HubAimFPAt = now
    end
    if fp then return "mouse" else return "camera" end
end

-- Camera steering step: normalized-lerp slerp on the SAME alpha as mouse.
function hubAimCameraStep(cam, tPos, sp, ax, ay, alpha)
    pcall(function()
        if alpha <= 0 then return end
        local cp = cam.CFrame.Position
        if not hubFiniteVec(tPos) or not hubFiniteVec(cp) then return end
        if not hubFiniteNum(sp.X) or not hubFiniteNum(sp.Y) then return end
        local want = tPos - cp
        local wm = want.Magnitude
        if wm < 0.001 or not hubFiniteNum(wm) then return end
        want = want / wm
        local cur = cam.CFrame.LookVector
        local blended = cur + (want - cur) * alpha
        local bMag = blended.Magnitude
        if hubFiniteVec(blended) and bMag > 0.001 then
            cam.CFrame = CFrame.lookAt(cp, cp + blended / bMag)
        end
    end)
end

-- Mouse steering step: same alpha, soft deadzone, dt-scaled feel layers.
function aimSmoothDelta(dx, dy, dist)
    local dtF = getgenv()._HubFrameDt or (1 / 60)
    local alpha = hubAimAlpha(dtF)
    local err = math.sqrt(dx * dx + dy * dy)
    if err < 0.01 then return 0, 0 end
    -- soft deadzone: feather to zero instead of hard stop/start (edge buzz fix)
    local dz = Cfg.AimDeadzone or 0
    local scale = 1
    if dz > 0 then
        scale = math.clamp((err - dz * 0.5) / math.max(dz, 1), 0, 1)
        if scale <= 0 then return 0, 0 end
    end
    local sx, sy = dx * alpha * scale, dy * alpha * scale
    -- Aim Speed Override: scalar on the whole step (100 = normal, up to 500)
    if Cfg.AimSpeedOverride then
        local pct = math.clamp(tonumber(Cfg.AimSpeedPct) or 100, 10, 500) / 100
        sx, sy = sx * pct, sy * pct
    end
    -- bezier bend: perpendicular drift, dt-scaled smooth noise (no jumps)
    if Cfg.AimCurve and (Cfg.AimCurveStrength or 0) > 0 then
        local m = math.sqrt(sx * sx + sy * sy)
        if m > 0.01 then
            local bend = (Cfg.AimCurveStrength or 40) / 1000
            local tt = tick()
            local w = (math.sin(tt * 6.3) + math.sin(tt * 3.7 + 1.3) * 0.5)
                * bend * m * math.min(1, dtF * 60)
            sx, sy = sx + (-sy / m) * w, sy + (sx / m) * w
        end
    end
    if (Cfg.AimMaxTurnSpeed or 0) > 0 then
        local cap = Cfg.AimMaxTurnSpeed * math.max(dtF * 60, 0.25)
        local m = math.sqrt(sx * sx + sy * sy)
        if m > cap then sx, sy = sx / m * cap, sy / m * cap end
    end
    if (Cfg.AimJitterReduction or 0) > 0 then
        if math.abs(sx) < Cfg.AimJitterReduction then sx = 0 end
        if math.abs(sy) < Cfg.AimJitterReduction then sy = 0 end
    end
    if (Cfg.AimHumanStrength or 0) > 0 then
        local seed = Cfg.AimHumanSeed or 1
        local tt = tick() * (1 + (seed % 5) * 0.13)
        local hs = Cfg.AimHumanStrength * math.min(1, dtF * 60)
        sx = sx + (math.sin(tt * 12.9 + seed) * 0.7 + math.sin(tt * 5.3 + seed * 2.7) * 0.3) * hs * 1.5
        sy = sy + (math.cos(tt * 7.7 + seed * 2) * 0.7 + math.cos(tt * 4.1 + seed) * 0.3) * hs * 1.5
    end
    return sx, sy
end


-- ?"??"? Velocity-history prediction. Modes: Linear / Ballistic / Adaptive.
-- History keyed by the part INSTANCE (GetDebugId throws without Plugin
-- capability and errored every frame). Dead parts pruned on a timer.
function aimPredictHist(cam, part, speed)
    speed = speed or 250
    local hist = getgenv()._HubVelHist
    if type(hist) ~= "table" then hist = {} getgenv()._HubVelHist = hist end
    local now = tick()
    if (getgenv()._HubVelPrune or 0) + 5 < now then
        getgenv()._HubVelPrune = now
        for p in pairs(hist) do
            local dead = true
            pcall(function() dead = not p:IsDescendantOf(Workspace) end)
            if dead then hist[p] = nil end
        end
    end
    local vel = Vector3.zero
    pcall(function() vel = part.AssemblyLinearVelocity end)
    local h = hist[part] or {}
    table.insert(h, { t = now, v = vel })
    local frames = math.max(1, Cfg.AimPredFrames or 5)
    while #h > frames do table.remove(h, 1) end
    hist[part] = h
    local avg = vel
    if #h > 1 then
        local sx, sy, sz = 0, 0, 0
        for _, e in ipairs(h) do sx += e.v.X sy += e.v.Y sz += e.v.Z end
        avg = Vector3.new(sx / #h, sy / #h, sz / #h)
    end
    local dist = (cam.CFrame.Position - part.Position).Magnitude
    local tof = dist / speed
    local mode = Cfg.AimPredMode or "Linear"
    local lead = part.Position + avg * tof
    if mode == "Ballistic" then
        lead = lead + Vector3.new(0, -0.5 * 196.2 * tof * tof * 0.12, 0)
    elseif mode == "Adaptive" then
        local spd = avg.Magnitude
        local k = math.clamp(spd / 60, 0, 1)
        lead = part.Position + avg * tof * (0.5 + 0.5 * k)
    end
    if Cfg.AimPredLateralOnly then lead = Vector3.new(lead.X, part.Position.Y, lead.Z) end
    local conf = math.clamp(Cfg.AimPredConfidence or 1, 0, 1)
    return part.Position + (lead - part.Position) * conf
end


