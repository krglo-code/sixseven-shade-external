-- v13 STREAK-ENDED messenger: tracks the best-seen streak (real or spoofed,
-- the number matches what your profile shows), fires on death or value dip.
-- Local only by default through a cascade that works with NO chat at all:
-- TextChatService system message -> legacy ChatMakeSystemMessage -> hub popup.
function hubStreakMsg(text)
    local done = false
    pcall(function()
        local TCS = game:GetService("TextChatService")
        local folder = TCS and TCS:FindFirstChild("TextChannels")
        local ch = folder and folder:FindFirstChild("RBXGeneral")
        if ch then ch:DisplaySystemMessage(text) done = true end
    end)
    if not done then
        pcall(function()
            game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", { Text = tostring(text):gsub("<[^>]+>", "") })
            done = true
        end)
    end
    if not done then hubNotify(text, 4) end
    if Cfg.StreakMsgPublic then
        pcall(function()
            local rem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local req = rem and rem:FindFirstChild("SayMessageRequest")
            if req then req:FireServer(text, "All") end
        end)
    end
end


function hubComma(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(math.abs(n))
    local out = ""
    while #s > 3 do out = "," .. s:sub(-3) .. out s = s:sub(1, -4) end
    return ((n < 0) and "-" or "") .. s .. out
end


-- killer you: newest feed slot whose victim is you -> its eliminator
function hubStreakKiller()
    local killer = nil
    local myD = LP.DisplayName
    local fd = tostring(Cfg.SettingsDisplay or "")
    local fu = tostring(Cfg.SettingsUser or "")
    pcall(function()
        local mg = LP.PlayerGui:FindFirstChild("MainGui")
        local feed = mg and mg:FindFirstChild("EliminationFeed", true)
        if not feed then return end
        for _, slot in ipairs(feed:GetChildren()) do
            local elim, vict = nil, nil
            for _, d in ipairs(slot:GetDescendants()) do
                if d:IsA("TextLabel") and d.Parent then
                    if d.Parent.Name == "Eliminator" then elim = d.Text
                    elseif d.Parent.Name == "Victim" or d.Parent.Name == "Eliminated" then vict = d.Text end
                end
            end
            if vict and (vict == LP.Name or vict == myD or vict == "@" .. LP.Name or vict == "@" .. myD
                or (fd ~= "" and vict == fd) or (fu ~= "" and (vict == fu or vict == "@" .. fu))) then
                if elim and elim ~= "" then killer = elim end
            end
        end
    end)
    return killer
end


