-- Paint pass: recolors labels currently showing YOUR fake forms (exact
-- handle, exact display, display + rank badge). Runs at the end of every
-- spoof pass + instant rewrite, so game repaints never stick.
function hubSpoofPaintPass()
    if not hubSpoofColorCustom() then return end
    local fd = tostring(Cfg.SettingsDisplay or "")
    local fu = tostring(Cfg.SettingsUser or "")
    if fd == "" and fu == "" then return end
    local col = Color3.fromRGB(Cfg.SpoofNameColorR or 255, Cfg.SpoofNameColorG or 255, Cfg.SpoofNameColorB or 255)
    pcall(function()
        local roots = {}
        local mg = LP.PlayerGui and LP.PlayerGui:FindFirstChild("MainGui")
        if mg then table.insert(roots, mg) end
        if LP.Character then table.insert(roots, LP.Character) end
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local t = tostring(d.Text or "")
                    local hit = false
                    if fu ~= "" and t == "@" .. fu then hit = true end
                    if not hit and fd ~= "" then
                        if t == fd then hit = true end
                    end
                    if not hit and fd ~= "" then
                        local okM = false
                        pcall(function()
                            local esc = fd:gsub("(%W)", "%%%1")
                            okM = string.match(t, "^" .. esc .. " ◆ ") ~= nil
                        end)
                        if okM then hit = true end
                    end
                    if hit then
                        pcall(function() d.TextColor3 = col end)
                    end
                end
            end
        end
    end)
end


-- Player icon, actually fixed: the attribute stomp alone never repainted
-- the slot image (the game resolves it once at build). We discover the real
-- icon art at runtime (exact name first, then contains) and repaint YOUR
-- slot's icon ImageLabel every pass.
function hubSpoofIconImage(key)
    key = tostring(key or "")
    if key == "" then return nil end
    local cache = getgenv()._HubIconCache
    if type(cache) ~= "table" then cache = {} getgenv()._HubIconCache = cache end
    if cache[key] ~= nil then return cache[key] or nil end
    if (getgenv()._HubIconScanAt or 0) + 5 > tick() then return nil end
    getgenv()._HubIconScanAt = tick()
    local hit = nil
    local kl = string.lower(key)
    pcall(function()
        for pass = 1, 2 do
            if hit then break end
            local scanned = 0
            for _, root in ipairs({ ReplicatedStorage, LP.PlayerGui }) do
                if hit then break end
                local okD, desc = pcall(function() return root:GetDescendants() end)
                if okD and type(desc) == "table" then
                    for _, d in ipairs(desc) do
                        scanned += 1
                        if scanned > 3000 then break end
                        if hit then break end
                        local okC, cls = pcall(function() return d.ClassName end)
                        if okC and (cls == "ImageLabel" or cls == "ImageButton" or cls == "Decal") then
                            local img = nil
                            pcall(function()
                                img = (cls == "Decal") and d.Texture or d.Image
                            end)
                            if type(img) == "string" and img ~= "" then
                                local nm = ""
                                pcall(function() nm = string.lower(d.Name or "") end)
                                if pass == 1 and nm == kl then hit = img end
                                if pass == 2 and nm ~= "" and string.find(nm, kl, 1, true) then hit = img end
                            end
                        end
                    end
                end
                if scanned > 3000 then break end
            end
        end
    end)
    if hit then cache[key] = hit end
    return hit
end


function spoofIconApply()
    if (Cfg.SpoofIcon or "") == "" then return end
    local img = hubSpoofIconImage(Cfg.SpoofIcon)
    if not img then return end
    pcall(function()
        local mg = LP.PlayerGui:FindFirstChild("MainGui")
        if not mg then return end
        for _, slot in ipairs(mg:GetDescendants()) do
            if slot.Name == "PlayerListSlot" and slot:IsA("Frame") then
