            "CANNONBALLLLL", "roblox_rtc",
            "COCONUTBONK", "RIVALSSUMMER",
        }
        local n = 0
        for _, code in ipairs(codes) do
            if redeemOneCode(code) then n += 1 end
            task.wait(0.6)
        end
        pcall(function()
            Library:Notify("Fired " .. tostring(n) .. " codes - check Rewards", 4)
        end)
    end)
end


_hubFrameTick = 0


function hubShouldEspTick()
    if _hubLagSkip then return false end
    local lvl = getgenv()._HubPerfLvl or 0
    if lvl >= 2 then return _hubFrameTick % 6 == 0 end
    if lvl == 1 then return _hubFrameTick % 4 == 0 end
    return _hubFrameTick % 2 == 0
end

-- NOLAG: frame-time guard. If the last frame overran, this frame runs
-- essentials only (no ESP scan / aim scan / overlays) so lag cannot spiral.
_hubLastFrameT = 0
_hubLagSkip = false
RunService:BindToRenderStep("RIVALS_HUB_MAIN_V3", Enum.RenderPriority.Input.Value + 1,
function(dt)
    local cam = Workspace.CurrentCamera
    if not cam then return end
    do
        local _prev = _hubLastFrameT
        _hubLastFrameT = tick()
        local _dt = (type(dt) == "number" and dt > 0) and dt or ((_prev > 0) and (_hubLastFrameT - _prev) or (1/60))
        _hubLagSkip = _dt > 0.055
        -- v7 auto performance guard: sustained low fps sheds load in steps,
        -- recovers by itself when frames are healthy again
        local _ema = getgenv()._HubFpsEma or (1 / 60)
        _ema = _ema * 0.95 + math.min(_dt, 0.25) * 0.05
        getgenv()._HubFpsEma = _ema
        local lvl = getgenv()._HubPerfLvl or 0
        if _ema > 0.04 and lvl < 2 then
            if (getgenv()._HubLvlAt or 0) + 2 < tick() then
                lvl += 1
                getgenv()._HubPerfLvl = lvl
                getgenv()._HubLvlAt = tick()
                if lvl == 1 then
                    hubNotify("Low FPS: ESP + aim scan halved to recover", 4)
                else
                    hubNotify("Low FPS: heavy visuals shed" .. (Cfg.PerfPotato and "" or " - turn on Potato Mode for more"), 4)
                end
            end
        elseif _ema < 0.022 and lvl > 0 and (getgenv()._HubLvlAt or 0) + 5 < tick() then
            lvl -= 1
            getgenv()._HubPerfLvl = lvl
            getgenv()._HubLvlAt = tick()
            hubNotify("FPS recovered", 2)
        end
    end
    local cx = cam.ViewportSize.X * 0.5
    local cy = cam.ViewportSize.Y * 0.5


    -- 1. Ragebot patch (gated: ragebot on OR No Cooldown switch on)
    if cooldownPatchActive() then
        local fc = getFC()
        local lf = fc and fc.LocalFighter
        if lf then patchLF(lf, tick()) end
    end


    -- 2. Ragebot v2 fire (desync plant + void spam live inside the step)
    -- fault-isolated: a rage throw must never abort the frame (aimbot,
    -- triggerbot and visuals run after this and would die with it)
    local okRage, errRage = pcall(function() rageFireStep(cam) end)
    if not okRage and (getgenv()._HubRageFaultAt or 0) + 5 < tick() then
        getgenv()._HubRageFaultAt = tick()
        warn("[Hub] rage fault: " .. tostring(errRage):sub(1, 160))
    end


    -- (v2: auto-dodge / rubberband / backstab / platform pruned)


    -- 2b. Hit notification: rage-target HP drops right after our shots draw
    -- a fading hitmarker + damage number at the crosshair. Kill feed stays
    -- the source of truth for actual eliminations.
    do
        local H = getgenv()._HubHit
        if type(H) ~= "table" then H = {} getgenv()._HubHit = H end
        local showM, showD = Cfg.HitNotify, Cfg.HitDamage
        local G = getgenv()._HubXH
        local function hhide(k)
            local o = type(G) == "table" and G[k]
            if o then pcall(function() o.Visible = false end) end
        end
        local function hens(key, className)
            if type(G) ~= "table" then G = {} getgenv()._HubXH = G end
            local o = G[key]
            if o == nil then
                local ok, inst = pcall(function() return Drawing.new(className) end)
                o = ok and inst or false
                G[key] = o
            end
            return o or nil
        end
        if showM or showD then
            -- full target scan is the frame hog: reuse this frame's rage
            -- target when fresh, else rescan right after OUR shots (when HP
            -- deltas matter) or at 10Hz, else reuse the cache
            local recent = (tick() - _lastRageFire) < 0.6
            local th = getgenv()._HubHitPart
            local rn = getgenv()._HubRageNow
            if rn and rn.head and (tick() - (rn.t or 0)) < 0.5 then
                th = rn.head
                getgenv()._HubHitPart = th
            elseif recent or _hubFrameTick % 6 == 0 then
                local _, _, nth = getRageTarget(cam)
                th = nth
                getgenv()._HubHitPart = th
            elseif th then
                local okLive = false
                pcall(function()
                    okLive = th:IsDescendantOf(Workspace)
                        and th.Parent
                        and th.Parent:FindFirstChildOfClass("Humanoid") ~= nil
                end)
                if not okLive then
                    th = nil
                    getgenv()._HubHitPart = nil
                end
            end
            local hum = th and th.Parent and th.Parent:FindFirstChildOfClass("Humanoid")
            local hp = hum and hum.Health or nil
            if hp and H.hp and hp < H.hp and recent then
                H.dmg = (H.dmg or 0) + (H.hp - hp)
                H.t = tick()
            end
            H.hp = hp
            local age = (H.t and (tick() - H.t)) or 99
            if age < 0.7 then
                local fade = 1 - age / 0.7
                local hitC = Color3.fromRGB(255, 70, 70)
                if showM then
                    local o = 8
                    local pts = {
                        { -o, -o, -4, -4 }, { 4, -4, o, -o },
                        { -o, o, -4, 4 }, { 4, 4, o, o },
                    }
                    for i = 1, 4 do
                        local L = hens("hm" .. i, "Line")
                        if L then
                            L.From = Vector2.new(cx + pts[i][1], cy + pts[i][2])
                            L.To = Vector2.new(cx + pts[i][3], cy + pts[i][4])
                            L.Color = hitC
                            L.Thickness = 2
                            L.Transparency = fade
                            L.Visible = true
                        end
                    end
                else
                    for i = 1, 4 do hhide("hm" .. i) end
                end
                if showD and H.dmg and H.dmg > 0 then
                    local T = hens("hmd", "Text")
                    if T then
                        T.Text = "-" .. tostring(math.floor(H.dmg + 0.5))
                        T.Size = 16
                        T.Center = true
                        T.Outline = true
                        T.Color = Color3.new(1, 1, 1)
                        T.Transparency = fade
                        T.Position = Vector2.new(cx, cy - 30)
                        T.Visible = true
                    end
                else
                    hhide("hmd")
                end
            else
                for _, k in ipairs({ "hm1", "hm2", "hm3", "hm4", "hmd" }) do hhide(k) end
                H.dmg = nil
            end
        else
            for _, k in ipairs({ "hm1", "hm2", "hm3", "hm4", "hmd" }) do hhide(k) end
        end
    end


    -- 3. ESP at ~30Hz (was full 2D-box recompute for every player every frame:
    -- ~16 parts x 8 corners of WorldToViewportPoint each ??" the biggest frame hog)
    _hubFrameTick += 1
    if hubShouldEspTick() then
        if hubMenuOpen() then
            pcall(function() hubEspPark() end)
        else
            getgenv()._HubEspParked = false
            updateESP(cam)
            pcall(function() hubTripmineTick(cam) end)
            pcall(function() hubTracerTick() end)
        end
    end


    -- 4 & 5. Aimbot visuals + smoothing (spec painter owns all shapes).
    fovCircle.Visible = false
    snapLine.Visible = false
    snapDot.Visible = false


    -- v7: execute ships sterile (AimEnabled=false) - say so, don't go silent
    if aimHeld() and not Cfg.AimEnabled and (getgenv()._HubAimOffHintAt or 0) + 10 < tick() then
        getgenv()._HubAimOffHintAt = tick()
        hubNotify("Aimbot toggle is OFF - enable Aimbot first", 4)
    end
    if Cfg.AimEnabled then
        -- Toggle key mode: flip lock on key-press edge
        if (Cfg.AimKeyMode or "Hold") == "Toggle" or Cfg.AimToggle then
            local prev = getgenv()._HubAimEdge
            getgenv()._HubAimEdge = aimHeld()
            if aimHeld() and not prev then
                getgenv()._HubAimToggled = not getgenv()._HubAimToggled
            end
        end
        -- don't burn a full target scan on frames where aim can't even engage.
        -- Seeking (no lock) scans at 30Hz; a live lock revalidates + tracks
        -- every frame, so smoothing never stutters and idle raycasts halve.
        local wantAim = aimKeyActive()
        -- v5: aimbot only breathes inside duels/matches
        -- FIX v21: AimAnywhere bypasses AimDuelOnly gate (lobby/FFA/testing)
        if wantAim and (Cfg.AimDuelOnly ~= false) and not Cfg.AimAnywhere then
            local dd = getgenv()._HubAimDuel
            if _hubFrameTick % 30 == 0 or dd == nil then dd = inDuel() getgenv()._HubAimDuel = dd end
            if not dd then
                wantAim = false
                -- v6: say WHY it holds fire (key held + enemies live + not in duel)
                if aimKeyActive() and (getgenv()._HubGateHintAt or 0) + 10 < tick() then
                    local foes = 0
                    pcall(function()
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LP and p.Character then
                                local h = p.Character:FindFirstChildOfClass("Humanoid")
                                if h and h.Health > 0 then foes += 1 end
                            end
                        end
                    end)
                    if foes > 0 then
                        getgenv()._HubGateHintAt = tick()
                        hubNotify("Aimbot held: Duel-Only gate, not in duel (" .. foes .. " alive) - Area=Everywhere for lobby/FFA", 4)
                    end
                end
            end
        end
        local aimPart = nil
        -- scan whenever the key is live: drawings park themselves inside
        -- paintAimOverlays when the menu is open, so the menu check must
        -- never gate target acquisition (a missed window lookup used to
        -- read "open" forever and the bot never scanned at all)
        if wantAim then
            if _hubLagSkip and not getgenv()._HubAimHadLock then
                aimPart = getgenv()._HubAimLast
            elseif getgenv()._HubAimHadLock or _hubFrameTick % ((getgenv()._HubPerfLvl or 0) >= 1 and 4 or 2) == 0 then
                -- finder touches live game objects every scan: any single
                -- throw used to silently kill the lock this frame (and a
                -- persistently odd object killed the bot outright). Fall
                -- back to the last live part and log the fault.
                local okF, fT, fP = pcall(function() return findAimTarget(cam) end)
                if okF then
                    _, aimPart = fT, fP
                else
                    aimPart = getgenv()._HubAimLast
                    if (getgenv()._HubAimFaultAt or 0) + 5 < tick() then
                        getgenv()._HubAimFaultAt = tick()
                        warn("[Hub] aim finder fault: " .. tostring(fT):sub(1, 160))
                    end
                end
                -- v5 lock grace: a lost scan keeps the last live part 0.35s
                -- (LOS edge flicker can't pop the lock anymore)
                if not aimPart then
                    local lp = getgenv()._HubAimLast
                    local lostAt = getgenv()._HubAimLostAt or 0
                    if lp then
                        local okG = false
                        pcall(function()
                            local m = lp.Parent
                            local h = m and m:FindFirstChildOfClass("Humanoid")
                            if h and h.Health > 0 and lp:IsDescendantOf(Workspace) then
                                local gp, gon = cam:WorldToViewportPoint(lp.Position)
                                if gon and hubFiniteNum(gp.X) and hubFiniteNum(gp.Y) then
                                    local ax0, ay0 = hubAimAnchor(cam)
                                    local dd2 = math.sqrt((gp.X - ax0) ^ 2 + (gp.Y - ay0) ^ 2)
                                    if dd2 <= Cfg.AimFOV * 1.5 then okG = true end
                                end
                            end
                        end)
                        if lostAt == 0 then getgenv()._HubAimLostAt = tick() end
                        if okG and tick() - getgenv()._HubAimLostAt < 0.35 then aimPart = lp end
                    else
                        getgenv()._HubAimLostAt = tick()
                    end
                else
                    getgenv()._HubAimLostAt = 0
                end
                getgenv()._HubAimHadLock = aimPart ~= nil
                if aimPart then getgenv()._HubAimLast = aimPart end
            else
                aimPart = getgenv()._HubAimLast
                if aimPart then
                    local okV, alive = pcall(function()
                        local m = aimPart.Parent
                        local h = m and m:FindFirstChildOfClass("Humanoid")
                        return h ~= nil and h.Health > 0
                    end)
                    if not (okV and alive) then
                        aimPart = nil
                        getgenv()._HubAimLast = nil
                    end
                end
            end
        else
            clearLock()
            getgenv()._HubAimHadLock = false
            getgenv()._HubAimLast = nil
        end
        pcall(function() hubAimDiagTick(cam, aimPart, wantAim) end)


        if aimPart then
            -- v4: predict ONCE per frame (was twice: history advanced 2x/frame = jitter)
            local tPos = aimPart.Position
            if Cfg.AimTrig then
                tPos = trigLeadPosition(cam, aimPart)
            elseif Cfg.AimPrediction then
                tPos = aimPredictHist(cam, aimPart)
            end
            if not hubFiniteVec(tPos) then tPos = aimPart.Position end
            -- v20: desync compensation ??" aimbot was locking ghost position when desync
            -- is active (root teleported), subtract offset to track the real server hitbox.
            if Cfg.AimDesyncCompensate ~= false then
                local off = getgenv()._HubDesyncOff
                if off and hubFiniteVec(off) and off.Magnitude > 0.01 then
                    tPos = tPos - off
                    if not hubFiniteVec(tPos) then tPos = aimPart.Position end
                end
            end
            if not hubFiniteVec(tPos) then
                clearLock()
                getgenv()._HubAimHadLock = false
                getgenv()._HubAimLast = nil
                aimPart = nil
            else
                -- latch steering path on NEW lock only: no mid-lock FP/TP flips
                if getgenv()._HubAimLockPart ~= aimPart then
                    getgenv()._HubAimLockPart = aimPart
                    getgenv()._HubAimPathLatched = hubAimPath(cam)
                    getgenv()._HubAimAcqT = tick()
                    getgenv()._HubAimOver = 1
                    getgenv()._HubAimSmPos = aimPart.Position
                end
                local dtF = math.clamp((type(dt) == "number" and dt > 0) and dt or (1 / 60), 0.005, 0.1)
                getgenv()._HubFrameDt = dtF
                local alpha = hubAimAlpha(dtF)
                -- acquire overshoot: one decaying boost, never a per-frame retrigger
                local over = getgenv()._HubAimOver or 0
                if over > 0.01 and (Cfg.AimOvershoot or 0) > 0 then
                    alpha = math.clamp(alpha * (1 + Cfg.AimOvershoot * over), 0.01, 0.99)
                end
                if over > 0 then
                    getgenv()._HubAimOver = over * math.exp(-dtF * 6)
                end
                -- smooth WORLD position once with the same alpha (no double ease)
                local sm = getgenv()._HubAimSmPos
                if sm and hubFiniteVec(sm) then
                    tPos = sm:Lerp(tPos, alpha)
                end
                getgenv()._HubAimSmPos = tPos
                -- ONE anchor shared by selection + circle + movement
                local ax, ay = hubAimAnchor(cam)
                local sp, on = cam:WorldToViewportPoint(tPos)
                if not hubFiniteNum(sp.X) or not hubFiniteNum(sp.Y) then on = false end
                -- off-screen grace 0.25s: one bad frame can't pop lock/visuals
                if not on then
                    if (getgenv()._HubAimOffAt or 0) == 0 then getgenv()._HubAimOffAt = tick() end
                    if tick() - getgenv()._HubAimOffAt < 0.25 and getgenv()._HubAimLastSp then
                        sp, on = getgenv()._HubAimLastSp, true
                    end
                else
                    getgenv()._HubAimOffAt = 0
                    getgenv()._HubAimLastSp = sp
                end
                paintAimOverlays(cam, ax, ay, aimPart, on and sp or nil, on)
                if on and aimKeyActive() and aimReactionReady() and hitChanceOK() then
                    local path = getgenv()._HubAimPathLatched or hubAimPath(cam)
                    if Cfg.AimTrig then
                        pcall(function()
                            local cp = cam.CFrame.Position
                            local dir = trigAngleLerp(cam, tPos, Cfg.AimTrigSmooth)
                            if hubFiniteVec(dir) and dir.Magnitude > 0.001 then
                                cam.CFrame = CFrame.lookAt(cp, cp + dir)
                            end
                        end)
                    elseif path == "camera" then
                        -- v19: your hand wins. Real mouse movement this frame
                        -- skips the camera drive (screen never feels locked).
                        local myield = false
                        pcall(function()
                            local ml = UserInputService:GetMouseLocation()
                            local lx, ly = getgenv()._HubMouseLX, getgenv()._HubMouseLY
                            if lx and (math.abs(ml.X - lx) + math.abs(ml.Y - ly)) > 3 then
                                myield = true
                            end
                            getgenv()._HubMouseLX, getgenv()._HubMouseLY = ml.X, ml.Y
                        end)
                        if myield then
                            getgenv()._HubAimSmPos = tPos
                        end
                        local ex = sp.X - ax
                        local ey = sp.Y - ay
                        local dz = Cfg.AimDeadzone or 0
                        local err = math.sqrt(ex * ex + ey * ey)
                        local sc = 1
                        if dz > 0 then sc = math.clamp((err - dz * 0.5) / math.max(dz, 1), 0, 1) end
                        if sc > 0 and not myield then hubAimCameraStep(cam, tPos, sp, ax, ay, alpha * sc) end
                    else
                        local dx = sp.X - ax
                        local dy = sp.Y - ay
                        if hubFiniteNum(dx) and hubFiniteNum(dy)
                            and math.abs(dx) < 5000 and math.abs(dy) < 5000
                            and dx * dx + dy * dy > 0.01 then
                            local dist = math.sqrt(dx * dx + dy * dy)
                            local stepx, stepy = aimSmoothDelta(dx, dy, dist)
                            local maxStep = math.max(60, Cfg.AimFOV * 0.35)
                            local m = math.sqrt(stepx * stepx + stepy * stepy)
                            if not hubFiniteNum(m) then stepx, stepy, m = 0, 0, 0 end
                            if m > maxStep then
                                stepx = stepx / m * maxStep
                                stepy = stepy / m * maxStep
                            end
                            -- v6: fractional accumulator. Sub-pixel steps add up
                            -- instead of truncating to 0 (low Speed felt dead),
                            -- and rounding kills the +-1px dither (the flicker).
                            local fx = (getgenv()._HubAimFracX or 0) + stepx
                            local fy = (getgenv()._HubAimFracY or 0) + stepy
                            if stepx == 0 and stepy == 0 then
                                fx, fy = fx * 0.5, fy * 0.5
                            end
                            local mx = math.floor(fx + 0.5)
                            local my = math.floor(fy + 0.5)
                            if hubFiniteNum(mx) and hubFiniteNum(my)
                                and math.abs(mx) < 5000 and math.abs(my) < 5000 then
                                if mx ~= 0 or my ~= 0 then
                                    pcall(mousemoverel, mx, my)
                                    fx, fy = fx - mx, fy - my
                                end
                                if math.abs(fx) > 1 then fx = (fx > 0) and 1 or -1 end
                                if math.abs(fy) > 1 then fy = (fy > 0) and 1 or -1 end
                                getgenv()._HubAimFracX = fx
                                getgenv()._HubAimFracY = fy
                            end
                        end
                    end
                end
            end
            -- unified auto-fire: holds trigger while locked, releases on drop --
            if Cfg.AimbotAutoFire and aimPart and on and aimKeyActive() then
                if not getgenv()._HubAimbotFiring then
                    getgenv()._HubAimbotFiring = true
                    pcall(mouse1press)
                end
            elseif getgenv()._HubAimbotFiring then
                getgenv()._HubAimbotFiring = false
                pcall(mouse1release)
            end
        else
            if getgenv()._HubAimbotFiring then
                getgenv()._HubAimbotFiring = false
                pcall(mouse1release)
            end
            paintAimOverlays(cam, cx, cy, nil, nil, false)
        end
    else
        if getgenv()._HubAimbotFiring then
            getgenv()._HubAimbotFiring = false
            pcall(mouse1release)
        end
        paintAimOverlays(cam, cx, cy, nil, nil, false)
        clearLock()
        getgenv()._HubAimHadLock = false
        getgenv()._HubAimLast = nil
    end


    -- 6. Triggerbot (spec state machine: variance / predelay / burst /
    -- max-duration / cooldown / release mode, all in getgenv state)
    if Cfg.TrigEnabled then
        local shouldFire = trigShouldFire(cam)
        local now = tick()
        local T = getgenv()._HubTrig
        if type(T) ~= "table" then T = {} getgenv()._HubTrig = T end
        if T.coolUntil and now < T.coolUntil then shouldFire = false end
        if shouldFire and not _trigActive then
            if not T.detectAt then T.detectAt = now end
            local pre = (Cfg.TrigPreDelay or 0)
                + ((Cfg.TrigDelayVariance or 0) > 0 and (math.random() * 2 - 1) * Cfg.TrigDelayVariance / 1000 or 0)
            if (now - T.detectAt) >= math.max(0, pre) then
                local delay = (Cfg.TrigDelay or 0)
                    + ((Cfg.TrigDelayVariance or 0) > 0 and (math.random() * 2 - 1) * Cfg.TrigDelayVariance / 1000 or 0)
                delay = math.max(0, delay)
                if not _trigDelayTask then
                    if delay > 0 then
                        _trigDelayTask = task.delay(delay, function()
                            _trigDelayTask = nil
                            if trigShouldFire(cam) then
                                trigPress()
                                T.fireAt = tick()
                                T.burstLeft = (Cfg.TrigBurstCount or 0)
                            end
                        end)
                    else
                        trigPress()
                        T.fireAt = tick()
                        T.burstLeft = (Cfg.TrigBurstCount or 0)
                    end
                end
            end
        elseif not shouldFire then
            T.detectAt = nil
            if _trigDelayTask then
                task.cancel(_trigDelayTask)
                _trigDelayTask = nil
            end
            if _trigActive then
                local rel = Cfg.TrigReleaseDelay or 0
                if Cfg.TrigReleaseMode == "Random" then
                    rel = rel * (0.5 + math.random())
                end
                if rel > 0 then
                    task.delay(rel, function()
                        pcall(mouse1release)
                        _trigActive = false
                    end)
                else
                    trigRelease()
                end
                if (Cfg.TrigCooldown or 0) > 0 then T.coolUntil = now + Cfg.TrigCooldown end
            end
        elseif _trigActive then
            -- sustained fire: burst count + max duration caps
            if (T.burstLeft or 0) > 0 and T.fireAt and (now - T.fireAt) >= (Cfg.TrigBurstDelay or 0.05) then
                pcall(mouse1release)
                pcall(mouse1press)
                T.fireAt = now
                T.burstLeft = T.burstLeft - 1
            end
            if (Cfg.TrigMaxDuration or 0) > 0 and T.fireAt and (now - T.fireAt) >= Cfg.TrigMaxDuration then
                pcall(mouse1release)
                _trigActive = false
                T.coolUntil = now + math.max(Cfg.TrigCooldown, 0.5)
            end
        end
    else
        if _trigActive then
            pcall(mouse1release)
            _trigActive = false
        end
    end


    -- 7. Camera FOV lock
    if Cfg.MiscCamFOVEnabled then
        pcall(function()
            if cam.FieldOfView ~= Cfg.MiscCamFOV then
                cam.FieldOfView = Cfg.MiscCamFOV
            end
        end)
    end


    -- 7b. Third person enforcement (game resets zoom; re-assert it).
    -- every 5th frame: spawn / duel-entry / weapon-zoom stomps lose.
    if _hubFrameTick % 5 == 0 and (Cfg.CharThirdPerson or Cfg.VisThirdPerson) then
        pcall(function() hubThirdTick(cam) end)
    end
    -- 7b2. Speed lock: duel-entry / equip stomps lose the same way.
    if _hubFrameTick % 5 == 0 then
        pcall(function() hubSpeedTick() end)
    end
    -- v15: equip-skip + inspect-speed ride the same cheap cadence
    if _hubFrameTick % 5 == 0 then
        pcall(function() hubSkipEquipTick() end)
        pcall(function() hubInspectSpeedTick() end)
    end
    -- v6: warhorn cycle (own 1s throttle inside; instant return when off)
    if Cfg.WarhornV2 then
        pcall(function() hubWarhornTick() end)
    end


    -- 7c. Veil sync (v9: hotkey gone, cheap 2s heartbeat only).
    if _hubFrameTick % 120 == 0 then
        pcall(function()
            local win = findHubWindow()
            if win then
                local vis = win.Visible
                if vis ~= _menuOpen then
                    _menuOpen = vis
