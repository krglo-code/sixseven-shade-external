-- Subspace Tripmine gadgets on the ground. Defensive by design: mines are
-- matched by name pattern only, owner/team is best-effort (attributes or
-- value objects when the game provides them, neutral gray otherwise).


_tripSet = {}
_tripConns = {}
getgenv()._HubTripPool = getgenv()._HubTripPool or {}
_tripPool = getgenv()._HubTripPool
_tripScanAt = 0


function tripIsMine(inst)
    if not inst then return false end
    local ok, hit = pcall(function()
        if inst:IsA("Tool") then return false end
        local function tagged(nm)
            nm = string.lower(tostring(nm or ""))
            if string.find(nm, "tripmine", 1, true) then return true end
            if string.find(nm, "subspace", 1, true) then return true end
            if string.find(nm, "mine", 1, true) then return true end
            return false
        end
        if inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Attachment") then
            if tagged(inst.Name) then return true end
        end
        -- deployed mines often sit in generically-named models: walk up —
        -- if any ancestor within 4 levels is tagged, this belongs to a mine.
        local cur, guard = inst.Parent, 0
        while cur and guard < 4 do
            guard += 1
            if tagged(cur.Name) then return true end
            cur = cur.Parent
        end
        return false
    end)
    return ok and hit or false
end


function tripAnchor(inst)
    local ok, pos = pcall(function()
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Attachment") then return inst.WorldPosition end
        if inst:IsA("Model") then
            local pp = inst.PrimaryPart
            if pp then return pp.Position end
            -- placed-mine models often lack PrimaryPart: first live part wins
            for _, d in ipairs(inst:GetDescendants()) do
                if d:IsA("BasePart") then return d.Position end
            end
            local cf = inst:GetBoundingBox()
            return cf.Position
        end
        return nil
    end)
    if ok and typeof(pos) == "Vector3" then return pos end
    return nil
end


function tripOwnerInfo(inst)
    local info = {}
    pcall(function()
        local cur = inst
        local guard = 0
        while cur and guard < 5 do
            guard += 1
            local a = cur:GetAttributes()
            if a then
                if info.team == nil and a.TeamID ~= nil then info.team = a.TeamID end
                if info.team == nil and a.Team ~= nil then info.team = a.Team end
                if info.userId == nil and a.OwnerUserId ~= nil then info.userId = a.OwnerUserId end
                if info.name == nil and a.Owner ~= nil then info.name = a.Owner end
                if info.name == nil and a.Placer ~= nil then info.name = a.Placer end
                if info.name == nil and a.Creator ~= nil then info.name = a.Creator end
            end
            for _, ch in ipairs(cur:GetChildren()) do
                if ch:IsA("ObjectValue") or ch:IsA("StringValue") or ch:IsA("IntValue") then
                    local n = string.lower(ch.Name)
                    local isOwner = string.find(n, "owner", 1, true) or string.find(n, "placer", 1, true)
                        or string.find(n, "creator", 1, true) or string.find(n, "player", 1, true)
                    if isOwner then
                        if ch:IsA("ObjectValue") and ch.Value and ch.Value:IsA("Player") then
                            if info.userId == nil then info.userId = ch.Value.UserId end
                            if info.name == nil then info.name = ch.Value.Name end
                        elseif info.name == nil and ch.Value ~= nil then
                            info.name = tostring(ch.Value)
                        end
                    end
                    if string.find(n, "team", 1, true) and info.team == nil and ch.Value ~= nil then
                        info.team = ch.Value
                    end
                end
            end
            cur = cur.Parent
        end
    end)
    return info
end


function tripIsFriendly(info)
    if info.userId ~= nil then return info.userId == LP.UserId end
    if info.name ~= nil then
        local nm = string.lower(tostring(info.name))
        if nm == string.lower(LP.Name) or nm == string.lower(LP.DisplayName) then return true end
    end
    if info.team ~= nil then
        local myT = localTeamID()
        if myT ~= nil then
            local ok, same = pcall(function() return tostring(info.team) == tostring(myT) end)
            if ok and same then return true end
        end
    end
    return false
end


function tripIsEnemy(info)
    if info.userId ~= nil then return info.userId ~= LP.UserId end
    if info.name ~= nil then
        local nm = string.lower(tostring(info.name))
        if nm == string.lower(LP.Name) or nm == string.lower(LP.DisplayName) then return false end
        return true
    end
    if info.team ~= nil then
        local myT = localTeamID()
        if myT ~= nil then
            local ok, same = pcall(function() return tostring(info.team) == tostring(myT) end)
            if ok then return not same end
        end
    end
    return nil
end


function hubTripmineWatch()
    for _, c in ipairs(_tripConns) do pcall(function() c:Disconnect() end) end
    table.clear(_tripConns)
    table.clear(_tripSet)
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if tripIsMine(d) then _tripSet[d] = true end
        end
    end)
    table.insert(_tripConns, Workspace.DescendantAdded:Connect(function(d)
        if tripIsMine(d) then _tripSet[d] = true end
    end))
    table.insert(_tripConns, Workspace.DescendantRemoving:Connect(function(d)
        _tripSet[d] = nil
    end))
end


function tripDraw(i, kind)
    local o = _tripPool[i]
    if o == nil then
        local ok, inst = pcall(function() return Drawing.new(kind) end)
        o = ok and inst or false
        _tripPool[i] = o
    end
    return o or nil
end


-- Shooting-range dummies: humanoid models that aren't any player's
-- character and aren't mines, matched by name. Cached set with a 2s
-- rescan + dead-prune. Only ever considered OUTSIDE duels, as a fallback
-- when no player target locks.
function hubDummyScan()
    pcall(function()
        local D = getgenv()._HubDummies
        if type(D) ~= "table" then D = {} getgenv()._HubDummies = D end
        for m in pairs(D) do
            local live = false
            pcall(function() live = m.Parent ~= nil and m:IsDescendantOf(Workspace) end)
            if not live then D[m] = nil end
        end
        if (getgenv()._HubDummyScanAt or 0) + 2 < tick() then
            getgenv()._HubDummyScanAt = tick()
            for _, d in ipairs(Workspace:GetDescendants()) do
                local okM = false
                pcall(function() okM = d:IsA("Model") end)
                if okM then
                    local nm = ""
                    pcall(function() nm = string.lower(d.Name or "") end)
                    if (string.find(nm, "dummy", 1, true) or string.find(nm, "target", 1, true)
                        or string.find(nm, "practice", 1, true) or string.find(nm, "range", 1, true)
                        or string.find(nm, "bot", 1, true))
                        and not string.find(nm, "tripmine", 1, true)
                        and not string.find(nm, "subspace", 1, true) then
                        local hum = nil
                        pcall(function() hum = d:FindFirstChildOfClass("Humanoid") end)
                        local isPl = false
                        pcall(function() isPl = Players:GetPlayerFromCharacter(d) ~= nil end)
                        if hum and not isPl then D[d] = true end
                    end
                end
            end
        end
    end)
end


function hubTripmineTick(cam)
    if not Cfg.ESPTrip then
        if not getgenv()._HubTripHid then
            getgenv()._HubTripHid = true
            for _, o in pairs(_tripPool) do
                if o then pcall(function() o.Visible = false end) end
            end
        end
        return
    end
    getgenv()._HubTripHid = false
    if tick() - _tripScanAt > 2 then
        _tripScanAt = tick()
        pcall(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if tripIsMine(d) then _tripSet[d] = true end
            end
        end)
    end
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local col = Color3.fromRGB(Cfg.ESPTripColorR, Cfg.ESPTripColorG, Cfg.ESPTripColorB)
    local gray = Color3.fromRGB(160, 160, 160)
    local n = 0
    for inst in pairs(_tripSet) do
        local pos = nil
        pcall(function()
            if inst and inst.Parent and inst:IsDescendantOf(Workspace) then
                pos = tripAnchor(inst)
            else
                _tripSet[inst] = nil
            end
        end)
        if pos then
            local dist = myRoot and (myRoot.Position - pos).Magnitude or 0
            if Cfg.ESPTripDist <= 0 or dist <= Cfg.ESPTripDist then
                local mark = "foe"
                pcall(function()
                    -- owner resolved once per mine (it never changes mid-life);
                    -- empty results keep retrying until data lands
                    local info = _tripSet[inst]
                    if info == true or (type(info) == "table" and next(info) == nil) then
                        info = tripOwnerInfo(inst)
                        _tripSet[inst] = info
                    end
                    if Cfg.ESPTripTeam and tripIsFriendly(info) then
                        mark = "skip"
                    else
                        local e = tripIsEnemy(info)
                        if e == false then mark = "own"
                        elseif e == nil then mark = "unk" end
                    end
                end)
                if mark ~= "skip" then
                    n += 1
                    if n > 24 then break end
                    local sp, on = cam:WorldToViewportPoint(pos)
                    local ring = tripDraw("r" .. n, "Circle")
                    local lbl = tripDraw("t" .. n, "Text")
                    local c = (mark == "foe") and col or gray
                    if on and ring then
                        ring.Position = Vector2.new(sp.X, sp.Y)
                        ring.Radius = math.clamp(1200 / math.max(8, dist), 4, 26)
                        ring.Color = c
                        ring.Filled = false
                        ring.Thickness = 1.5
                        ring.Transparency = 1
                        ring.Visible = true
                    elseif ring then
                        ring.Visible = false
                    end
                    if on and lbl and Cfg.ESPTripLabel then
                        lbl.Text = "MINE " .. math.floor(dist + 0.5) .. "m"
                        lbl.Size = 13
                        lbl.Center = true
                        lbl.Outline = true
                        lbl.Color = c
                        lbl.Position = Vector2.new(sp.X, sp.Y + 14)
                        lbl.Visible = true
                    elseif lbl then
                        lbl.Visible = false
                    end
                end
            end
        end
    end
    for i = n + 1, 24 do
        local r = _tripPool["r" .. i]
        local t = _tripPool["t" .. i]
        if r then pcall(function() r.Visible = false end) end
        if t then pcall(function() t.Visible = false end) end
    end
    -- live count readout (1s throttle): proves placed mines are seen
    if (getgenv()._HubTripLblAt or 0) + 1 < tick() then
        getgenv()._HubTripLblAt = tick()
        getgenv()._HubTripCount = n
        local lbl = getgenv()._HubTripCountLbl
        if lbl then pcall(function() lbl:SetText(tostring(n) .. " placed") end) end
    end
end


