function enableFly()
    if _flyConn then pcall(function() _flyConn:Disconnect() end) _flyConn = nil end
    if _flyBV   then pcall(function() _flyBV:Destroy() end)     _flyBV   = nil end
    if _flyBG   then pcall(function() _flyBG:Destroy() end)     _flyBG   = nil end
    if not Cfg.MiscFly then
        local char = LP.Character
        if char then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h.PlatformStand = false end) end
        end
        return
    end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end
    pcall(function() hum.PlatformStand = true end)


    _flyBV = Instance.new("BodyVelocity", root)
    _flyBV.Velocity = Vector3.zero
    _flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)


    _flyBG = Instance.new("BodyGyro", root)
    _flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    _flyBG.D         = 500
    _flyBG.CFrame    = root.CFrame


    _flyConn = RunService.RenderStepped:Connect(function()
        if not Cfg.MiscFly then enableFly() return end
        local camNow = Workspace.CurrentCamera
        if not (camNow and _flyBV and _flyBG) then return end
        local cf   = camNow.CFrame
        local spd  = Cfg.MiscFlySpeed
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move -= cf.LookVector  * spd end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += cf.LookVector  * spd end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cf.RightVector * spd end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cf.RightVector * spd end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)        then move += Vector3.new(0, spd, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)  then move += Vector3.new(0, -spd, 0) end
        _flyBV.Velocity = move
        _flyBG.CFrame   = cf
    end)
end


-- ?"??"? Morph: wear their clothes / face / colors / accessories on YOUR body.
-- No rig swap, so "incompatible body type" is gone ??" body type stays yours.
_morphBackup = nil   -- clones of your original appearance pieces
_morphPieces = {}    -- instances this morph added (for cleanup)


function morphTrack(inst)
    if inst then table.insert(_morphPieces, inst) end
    return inst
end


function clearMorphPieces()
    for _, inst in ipairs(_morphPieces) do
        pcall(function() inst:Destroy() end)
    end
    table.clear(_morphPieces)
end


function snapshotMorphBackup(char)
    if _morphBackup then return end
    local b = { shirts = {}, faces = {}, colors = nil, accs = {}, meshes = {} }
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("MeshPart") then
            b.meshes[d.Name] = { m = d.MeshId, t = d.TextureID }
        end
    end
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("Shirt") or d:IsA("ShirtGraphic") or d:IsA("Pants") then
            table.insert(b.shirts, d:Clone())
        elseif d:IsA("Accessory") then
            table.insert(b.accs, d:Clone())
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("Decal") then
                table.insert(b.faces, { inst = d, tex = d.Texture })
            end
        end
    end
    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        b.colors = {
            HeadColor = bc.HeadColor, TorsoColor = bc.TorsoColor,
            LeftArmColor = bc.LeftArmColor, RightArmColor = bc.RightArmColor,
            LeftLegColor = bc.LeftLegColor, RightLegColor = bc.RightLegColor,
        }
    end
    _morphBackup = b
end


function wearMorphAccessory(char, assetId, worn)
    if worn >= 10 then return worn end
    local ok, m = pcall(function()
        return game:GetService("InsertService"):LoadAsset(assetId)
    end)
    if not ok or not m then return worn end
    for _, d in ipairs(m:GetChildren()) do
        if d:IsA("Accessory") or d:IsA("Hat") then
            if worn >= 10 then break end
            pcall(function()
                d.Parent = char
                morphTrack(d)
                worn += 1
            end)
        end
    end
    pcall(function() m:Destroy() end)
    return worn
end


-- seats a cloned accessory properly: welds its Handle attachment to the
-- matching attachment on your rig (bare parenting leaves gear floating).
function weldMorphAccessory(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle then
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("BasePart") then handle = d break end
        end
    end
    if not handle then return end
    local hatAttach = nil
    for _, d in ipairs(handle:GetChildren()) do
        if d:IsA("Attachment") then hatAttach = d break end
    end
    if not hatAttach then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            local slot = part:FindFirstChild(hatAttach.Name)
            if slot and slot:IsA("Attachment") then
                local w = Instance.new("Weld")
                w.Name  = hatAttach.Name .. "_Weld"
                w.Part0 = part
                w.Part1 = handle
                w.C0    = slot.CFrame
                w.C1    = hatAttach.CFrame
                w.Parent = handle
                handle.CanCollide = false
                handle.CanQuery   = false
                handle.CanTouch   = false
                return
            end
        end
    end
end


function morphIntoAvatar(username, quiet)
    local loud = not quiet
    username = tostring(username or ""):gsub("@", ""):gsub("%s+", "")
    if username == "" then
        pcall(function() Library:Notify("Morph: enter a username first", 3) end)
        return
    end
    local okUid, uid = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if not okUid or not uid then
        if loud then
            pcall(function() Library:Notify("Morph: user not found (" .. username .. ")", 3) end)
        end
        return
    end
    local ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(uid)
    end)
    if not ok or not desc then
        if loud then
            pcall(function() Library:Notify("Morph: user not found (" .. username .. ")", 3) end)
        end
        return
    end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        if loud then
            pcall(function() Library:Notify("Morph: no character yet, try again", 3) end)
        end
        return
    end
    snapshotMorphBackup(char)
    clearMorphPieces()
    -- clothes on fresh instances (your meshes/scales untouched)
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("Shirt") or d:IsA("ShirtGraphic") or d:IsA("Pants") then
            pcall(function() d:Destroy() end)
        end
    end
    if tonumber(desc.Shirt) and tonumber(desc.Shirt) ~= 0 then
        pcall(function()
            local s = Instance.new("Shirt")
            s.ShirtTemplate = "rbxassetid://" .. tostring(desc.Shirt)
            s.Parent = char
            morphTrack(s)
        end)
    end
    if tonumber(desc.Pants) and tonumber(desc.Pants) ~= 0 then
        pcall(function()
            local p = Instance.new("Pants")
            p.PantsTemplate = "rbxassetid://" .. tostring(desc.Pants)
            p.Parent = char
            morphTrack(p)
        end)
    end
    -- face decal
    if tonumber(desc.Face) and tonumber(desc.Face) ~= 0 then
        local head = char:FindFirstChild("Head")
        local face = head and head:FindFirstChildOfClass("Decal")
        if face then
            pcall(function() face.Texture = "rbxassetid://" .. tostring(desc.Face) end)
        end
    end
    -- body colors
    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        pcall(function()
            bc.HeadColor      = desc.HeadColor
            bc.TorsoColor     = desc.TorsoColor
            bc.LeftArmColor   = desc.LeftArmColor
            bc.RightArmColor  = desc.RightArmColor
            bc.LeftLegColor   = desc.LeftLegColor
            bc.RightLegColor  = desc.RightLegColor
        end)
    end
    -- gear source: live character when they're in-server, otherwise their full
    -- appearance model (works for ANY user id, no asset loading needed).
    local worn = 0
    local targetPlayer = Players:FindFirstChild(username)
    if not targetPlayer then
        local want = username:lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower() == want then targetPlayer = p break end
        end
    end
    local tchar = targetPlayer and targetPlayer.Character
    local appModel = nil
    if not tchar then
        local okM, m = pcall(function()
            return Players:GetCharacterAppearanceAsync(uid)
        end)
        if okM and m and typeof(m) == "Instance" then
            appModel = m
            tchar = m
        end
    end
    if tchar then
        -- bundle body shapes: copy limb meshes by part name (rig untouched).
        -- appearance models nest parts deeper, so scan descendants for those.
        local srcParts = appModel and tchar:GetDescendants() or tchar:GetChildren()
        pcall(function()
            for _, tp in ipairs(srcParts) do
                if tp:IsA("MeshPart") then
                    local mine = char:FindFirstChild(tp.Name)
                    if mine and mine:IsA("MeshPart") then
                        if tp.MeshId ~= "" then mine.MeshId = tp.MeshId end
                        if tp.TextureID ~= "" then mine.TextureID = tp.TextureID end
                    end
                end
            end
        end)
        for _, d in ipairs(srcParts) do
            if (d:IsA("Accessory") or d:IsA("Hat")) and worn < 10 then
                pcall(function()
                    local c = d:Clone()
                    c.Parent = char
                    weldMorphAccessory(char, c)
                    morphTrack(c)
                    worn += 1
                end)
            end
        end
    else
        local okAcc, list = pcall(function() return desc:GetAccessories(false) end)
        if okAcc and type(list) == "table" then
            for _, a in ipairs(list) do
                local aid = a.AssetId or a.Id
                if aid then worn = wearMorphAccessory(char, aid, worn) end
                if worn >= 10 then break end
            end
        end
    end
    if appModel then
        pcall(function() appModel:Destroy() end)
    end
    Cfg.MorphUsername = username
    pcall(function() char:SetAttribute("_HubMorphed", username) end)
    if loud then
        local src = appModel and "avatar-db" or (targetPlayer and "live" or "basic")
        pcall(function() Library:Notify("Morphed @" .. username .. " (" .. tostring(worn) .. " gear, " .. src .. ")", 3) end)
    end
end


function resetAvatarMorph()
    Cfg.MorphUsername = ""
    clearMorphPieces()
    pcall(function()
        local rc = LP.Character
        if rc then rc:SetAttribute("_HubMorphed", "") end
    end)
    local char = LP.Character
    if char and _morphBackup then
        local b = _morphBackup
        for _, d in ipairs(char:GetChildren()) do
            if d:IsA("Shirt") or d:IsA("ShirtGraphic") or d:IsA("Pants") then
                pcall(function() d:Destroy() end)
            end
        end
        for _, s in ipairs(b.shirts) do pcall(function() s.Parent = char end) end
        for _, a in ipairs(b.accs) do pcall(function() a.Parent = char end) end
        if b.meshes then
            for name, mt in pairs(b.meshes) do
                local mine = char:FindFirstChild(name)
                if mine and mine:IsA("MeshPart") then
                    pcall(function()
                        mine.MeshId = mt.m
                        mine.TextureID = mt.t
                    end)
                end
            end
        end
        for _, f in ipairs(b.faces) do
            pcall(function() f.inst.Texture = f.tex end)
        end
        local bc = char:FindFirstChildOfClass("BodyColors")
        if bc and b.colors then
            pcall(function()
                bc.HeadColor      = b.colors.HeadColor
                bc.TorsoColor     = b.colors.TorsoColor
                bc.LeftArmColor   = b.colors.LeftArmColor
                bc.RightArmColor  = b.colors.RightArmColor
                bc.LeftLegColor   = b.colors.LeftLegColor
                bc.RightLegColor  = b.colors.RightLegColor
            end)
        end
        -- clones moved back into the char: drop the backup so the next morph
        -- re-snapshots whatever you wear then
        _morphBackup = nil
    end
