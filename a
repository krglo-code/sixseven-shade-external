-- base text per label instance (weak keys: rebuilds never leak, re-skins stay exact)
local _hubBtnBase = setmetatable({}, { __mode = "k" })


local function hubGlyphOf(str)
    -- strip any previously applied glyph prefix, return clean base
    local base = tostring(str or "")
    local changed = true
    while changed do
        changed = false
        for _, g in pairs(BUTTON_GLYPHS) do
            if type(g) == "string" and g ~= "" and base:sub(1, #g) == g then
                base = base:sub(#g + 1)
                changed = true
                break
            end
        end
        if not changed then
            for _, t in pairs(HUB_THEMES) do
                local tg = t.glyph
                if tg ~= "" and base:sub(1, #tg) == tg then
                    base = base:sub(#tg + 1)
                    changed = true
                    break
                end
            end
        end
        if not changed then
            for _, g in ipairs(HUB_LEGACY_GLYPHS) do
                if g ~= "" and base:sub(1, #g) == g then
                    base = base:sub(#g + 1)
                    changed = true
                    break
                end
            end
        end
    end
    return base
end


