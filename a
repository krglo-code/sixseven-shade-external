    cfgSave()
end


function hubWeaponCooldownReset(name)
    if not name or name == "" or name == "..." then name = nil end
    -- manual reset goes further than the per-frame patch (which deliberately
    -- never touches a live reload cycle): cancel any reload lock so the full
    -- zero pass runs, then ask the GAME to reload a dry mag through its own
    -- entrypoint. Ammo numbers are never written directly.
    local function resetOne(it)
        if type(it) ~= "table" then return false end
        local nowTick = tick()
        pcall(function()
            it._reloading = false
            it._reload_cooldown = 0
        end)
        patchItem(it, nowTick)
        local reloaded = false
        pcall(function() reloaded = hubTryReload(it, true) end)
        return reloaded
    end
    if not name then
        local n, r = 0, 0
        for _, it in pairs(hubWeaponItems()) do
            if type(it) == "table" then
                n += 1
                if resetOne(it) then r += 1 end
            end
        end
        getgenv()._HubCDResetUntil = tick() + 3
        if n == 0 then
            pcall(function() Library:Notify("Reset: no weapons detected (join a duel first)", 3) end)
        elseif r > 0 then
            pcall(function() Library:Notify("Cooldowns reset: all + reloading (" .. tostring(r) .. ")", 2) end)
        else
            pcall(function() Library:Notify("Cooldowns reset: all (3s)", 2) end)
        end
    else
        local it = hubFindWeapon(name)
        if it then
            local reloaded = resetOne(it)
            getgenv()._HubCDResetUntil = tick() + 3
            pcall(function()
                Library:Notify("Cooldowns reset: " .. name .. (reloaded and " + reloading" or " (3s)"), 2)
            end)
        else
            pcall(function() Library:Notify("Weapon not found: " .. name .. " (press Reload Lists)", 3) end)
        end
    end
end


