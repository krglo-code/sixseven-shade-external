-- Workspace home: Shade External/ with configs, backgrounds, themes, logs
-- and profiles. Auto-built on execute; old rivals-hub/ content migrates.
function hubWorkspaceInit()
    pcall(function()
        if type(makefolder) ~= "function" or type(isfolder) ~= "function" then return end
        for _, d in ipairs({ "Shade External", "Shade External/configs", "Shade External/backgrounds",
            "Shade External/themes", "Shade External/logs", "Shade External/profiles", "Shade External/skybox",
            "Shade External/sounds" }) do
            if not isfolder(d) then makefolder(d) end
        end
        if type(isfile) == "function" and type(readfile) == "function" and type(writefile) == "function" then
            if isfile("rivals-hub/config.json") and not isfile("Shade External/configs/config.json") then
                local okD, data = pcall(readfile, "rivals-hub/config.json")
                if okD and type(data) == "string" and #data > 0 then
                    pcall(writefile, "Shade External/configs/config.json", data)
                end
            end
            if type(listfiles) == "function" then
                local okL, files = pcall(listfiles, "rivals-hub/profiles")
                if okL and type(files) == "table" then
                    for _, f in ipairs(files) do
                        local nm = tostring(f):match("([^/\\]+)$")
                        if nm and not isfile("Shade External/profiles/" .. nm) then
                            local okR, dd = pcall(readfile, f)
                            if okR and type(dd) == "string" then
                                pcall(writefile, "Shade External/profiles/" .. nm, dd)
                            end
                        end
                    end
                end
            end
            if not isfile("Shade External/README.txt") then
                pcall(writefile, "Shade External/README.txt",
                    "Shade External - hub files\n\nconfigs/ - main config.json + SaveManager profiles/\nbackgrounds/ - drop menu pictures here (.png)\nskybox/ - drop a sky picture here, set it in World > Skybox File\nsounds/ - drop hit/kill sounds here (.mp3/.ogg)\nthemes/ - Linoria theme files\nlogs/ - bootlog.txt\n")
            end
            if not isfile("Shade External/backgrounds/put-pictures-here.txt") then
                pcall(writefile, "Shade External/backgrounds/put-pictures-here.txt",
                    "Drop a .png here, then type Shade External/backgrounds/<name>.png in Settings > Menu > Background File.\n")
            end
            if not isfile("Shade External/skybox/put-skybox-here.txt") then
                pcall(writefile, "Shade External/skybox/put-skybox-here.txt",
                    "Drop a sky picture here (.png/.jpg), then type Shade External/skybox/<name>.png in World > Skybox File.\nThe same picture paints all six sky faces.\n")
            end
            if not isfile("Shade External/sounds/put-sounds-here.txt") then
                pcall(writefile, "Shade External/sounds/put-sounds-here.txt",
                    "Drop .mp3/.ogg here, then type Shade External/sounds/<name>.mp3 in Misc > Custom Sounds > file box.\nFiles beat asset IDs.\n")
            end
        end
    end)
end


pcall(function()
    if not isfolder(CFG_FOLDER) then
        makefolder(CFG_FOLDER)
    end
end)
hubWorkspaceInit()


