        ok = at ~= nil and at.Parent ~= nil
    end)
    if not ok then pcall(function() applyWeather(w) end) end
end


_weatherSound = nil


function cleanWeather()
    if _weatherSound then
        pcall(function() _weatherSound:Destroy() end)
        _weatherSound = nil
    end
end


-- safe Lighting write: this client's Lighting build is missing props
-- (live-verified: no FogEnabled), so every write goes through pcall and a
-- missing prop skips instead of killing the whole function.
function lset(prop, val)
    pcall(function() Lighting[prop] = val end)
end


function applyWeather(name)
    local p = WEATHER_PRESETS[name]
    if not p then return end
    cleanWeather()
    if p.clear then
        lset("FogStart", 5000)
        lset("FogEnd", 100000)
    elseif p.fogC then
        lset("FogColor", Color3.fromRGB(table.unpack(p.fogC)))
        lset("FogStart", p.fogS)
        lset("FogEnd", p.fogE)
    end
    if p.amb then
        lset("Ambient", Color3.fromRGB(p.amb[1], p.amb[2], p.amb[3]))
        lset("OutdoorAmbient", Color3.fromRGB(p.amb[1], p.amb[2], p.amb[3]))
    end
    if p.bri then lset("Brightness", p.bri) end
    if p.sound and p.sound ~= "" then
        _weatherSound = Instance.new("Sound", Workspace)
        _weatherSound.SoundId = p.sound
        _weatherSound.Volume  = p.vol
        _weatherSound.Looped  = true
        _weatherSound:Play()
    end
    hubWeatherAtmo(p)
end


function timeStrToMinutes(s)
    local h, m = string.match(s, "(%d+):(%d+)")
    if h and m then return tonumber(h) * 60 + tonumber(m) end
    return 14 * 60
end


