        Acceleration   = 6.0,      -- ramp-up multiplier per second
        SettleRadius   = 8,        -- deg — decelerate inside this zone
        SettleLerp     = 0.18,     -- lerp factor at settle
        JitterStrength = 0.006,    -- radians/frame hand tremor
        JitterFadeTime = 0.25,     -- seconds jitter fades over
        PreAimEnabled  = true,
        PreAimSpeed    = 18,       -- deg/s passive drift
        PreAimFOV      = 85,       -- degrees
        TargetPart     = "Head",   -- "Head"|"HitboxHead"|"HitboxBody"|"RootPart"
        VerticalOffset = 0,
        FOVLimit       = 120,
        CamAnchorY     = 1.5,
        AimVariance    = 0.15,
    }
    -- Expose config to hub Cfg so existing UI sliders can drive it
    -- (hub already has AimSmoothMode, AimbotSpeed, AimFOV wired to Cfg)
    local function syncFromCfg()
        pcall(function()
            if Cfg.AimFOV then AIM_CFG.FOVLimit = Cfg.AimFOV end
            if Cfg.AimbotSpeed then
                -- hub AimbotSpeed 1-100 maps to 0-400 deg/s
                AIM_CFG.MaxSpeed = Cfg.AimbotSpeed * 4
            end
        end)
    end

    -- ── SERVICES ────────────────────────────────────────────────────────────
    local lp  = game:GetService("Players").LocalPlayer
    local ws  = game:GetService("Workspace")
    local rs  = game:GetService("RunService")
    local UIS = game:GetService("UserInputService")

    local camCtrl     = require(lp.PlayerScripts.Controllers.CameraController)
    local fighterCtrl = require(lp.PlayerScripts.Controllers.FighterController)
    local duelCtrl    = require(lp.PlayerScripts.Controllers.DuelController)
    local cam         = ws.CurrentCamera

    -- ── HELPERS ─────────────────────────────────────────────────────────────
    local function gaussRand()
        local u1 = math.max(math.random(), 1e-10)
        return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * math.random())
    end

    local function angularError(a, b)
        return math.deg(math.acos(math.clamp(a:Dot(b), -1, 1)))
    end

    local function computeDeltas(curLook, toTarget)
        local cF = Vector3.new(curLook.X, 0, curLook.Z)
        local tF = Vector3.new(toTarget.X, 0, toTarget.Z)
        local yawDelta = 0
        if cF.Magnitude > 0.001 and tF.Magnitude > 0.001 then
            cF = cF.Unit; tF = tF.Unit
            local cross = cF:Cross(tF)
            yawDelta = math.atan2(cross.Y, cF:Dot(tF))
        end
        local curPitch = math.asin(math.clamp(curLook.Y, -1, 1))
        local tgtPitch = math.asin(math.clamp(toTarget.Y, -1, 1))
        return tgtPitch - curPitch, yawDelta
    end

    local function resolveEnemy()
        local dcur = duelCtrl.CurrentObject
        if not dcur or not dcur.Duelers then return nil end
        for _, d in ipairs(dcur.Duelers) do
            if not d.IsLocalPlayer then
                local cf = d.ClientFighter
                if not cf then continue end
                local entity = cf.Entity
                if not entity or not entity._is_in_world then continue end
                local hum = entity.Humanoid
                if hum and hum.Health <= 0 then continue end
                return entity
            end
        end
        return nil
    end

    local function resolveTargetPart(entity)
        local p = AIM_CFG.TargetPart
        if     p == "Head"       then return entity.Head
        elseif p == "HitboxHead" then return entity._hitboxes and entity._hitboxes[2]
        elseif p == "HitboxBody" then return entity._hitboxes and entity._hitboxes[1]
        elseif p == "RootPart"   then return entity.RootPart
        end
        return entity.Head
    end

    -- ── STATE ────────────────────────────────────────────────────────────────
    local aimStartTime     = nil
    local aimVarianceOff   = Vector3.zero

    local function activateAim()
        getgenv()._rivalsAimActive = true
        aimStartTime = tick()
        local v = AIM_CFG.AimVariance
        aimVarianceOff = Vector3.new(
            (math.random()-0.5)*2*v,
            (math.random()-0.5)*2*v,
            (math.random()-0.5)*2*v
        )
    end

    -- ── INPUT ─────────────────────────────────────────────────────────────
    aimConnect(UIS.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode ~= AIM_CFG.Key then return end
        if AIM_CFG.Mode == "hold" then
            activateAim()
        elseif AIM_CFG.Mode == "toggle" then
            getgenv()._rivalsAimToggled = not getgenv()._rivalsAimToggled
            if getgenv()._rivalsAimToggled then activateAim() else getgenv()._rivalsAimActive = false end
        end
    end)

    aimConnect(UIS.InputEnded, function(input, _)
        if input.KeyCode ~= AIM_CFG.Key then return end
        if AIM_CFG.Mode == "hold" then
            getgenv()._rivalsAimActive = false
        end
    end)

    -- ── MAIN LOOP ─────────────────────────────────────────────────────────
    aimConnect(rs.RenderStepped, function(dt)
        syncFromCfg()

        local entity = resolveEnemy()
        if not entity then return end
        local part = resolveTargetPart(entity)
        if not part then return end

        local lf = fighterCtrl.LocalFighter
        if not lf or not lf.Entity or not lf.Entity.RootPart then return end

        local camPos    = cam.CFrame.Position
        local targetPos = part.Position + aimVarianceOff + Vector3.new(0, AIM_CFG.VerticalOffset, 0)
        local curLook   = cam.CFrame.LookVector
        local toTarget  = (targetPos - camPos).Unit
        local angErr    = angularError(curLook, toTarget)
        local inFOV     = angErr <= AIM_CFG.FOVLimit

        -- Pre-aim drift (passive, always runs when key not held)
        if AIM_CFG.PreAimEnabled and not getgenv()._rivalsAimActive and inFOV and angErr <= AIM_CFG.PreAimFOV then
            local preRad = math.rad(AIM_CFG.PreAimSpeed) * dt
            local pD, yD = computeDeltas(curLook, toTarget)
            local tot = math.sqrt(pD*pD + yD*yD)
            if tot > 0.0001 then
                local sc = math.min(preRad / tot, 1)
                local cur = camCtrl.Rotation
                camCtrl.Rotation = Vector2.new(cur.X + pD*sc, cur.Y + yD*sc)
            end
            return
        end

        if not getgenv()._rivalsAimActive then return end
        if not inFOV then return end

        local elapsed     = tick() - (aimStartTime or tick())
        local speedFactor = math.min(elapsed * AIM_CFG.Acceleration, 1)
        local maxRad      = math.rad(AIM_CFG.MaxSpeed) * dt * speedFactor
        local settleRad   = math.rad(AIM_CFG.SettleRadius)

        local pD, yD = computeDeltas(curLook, toTarget)
        local tot = math.sqrt(pD*pD + yD*yD)
        if tot < 0.0001 then return end

        local scale
        if AIM_CFG.MaxSpeed <= 0 then
            scale = AIM_CFG.SettleLerp
        elseif tot <= settleRad then
            scale = AIM_CFG.SettleLerp
        else
            scale = maxRad > 0 and math.min(maxRad / tot, 1) or AIM_CFG.SettleLerp
        end

        -- Jitter: strongest at aim start, fades out
        local jitter = 0
        if AIM_CFG.JitterStrength > 0 then
            local fade = math.max(1 - elapsed / AIM_CFG.JitterFadeTime, 0)
            jitter = gaussRand() * AIM_CFG.JitterStrength * fade
        end

        local cur = camCtrl.Rotation
        camCtrl.Rotation = Vector2.new(
            cur.X + pD * scale + jitter,
            cur.Y + yD * scale + jitter * 0.7
        )
    end)

    print("[rivals-aimbot] Active | Key=Q Mode=hold Speed=" .. AIM_CFG.MaxSpeed .. "deg/s FOV=" .. AIM_CFG.FOVLimit .. "°")
end
