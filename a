    local killer = hubStreakKiller() or "???"
    return '<font color="#FF6B00">[FEVER]</font> <font color="#FFFFFF">' .. hand .. "</font>'s "
        .. '<font color="#FFD700">' .. hubComma(prev) .. "</font>"
        .. ' <font color="#B0B0B0">win streak was ended by</font> '
        .. '<font color="#FF4444">' .. tostring(killer) .. "</font>"
end


function hubStreakWatchTick()
    if not Cfg.StreakMsgEnabled then return end
    local cur = 0
    pcall(function()
        cur = tonumber(LP:GetAttribute("StatisticDuelsWinStreak")) or 0
    end)
    local prev = getgenv()._HubStreakPrev
    if prev == nil then
        getgenv()._HubStreakPrev = cur
        return
    end
    if cur > prev then prev = cur getgenv()._HubStreakPrev = prev end
    local dead = false
    pcall(function()
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        dead = (h == nil) or (h.Health <= 0)
    end)
    local minN = Cfg.StreakMsgMin or 3
    if dead and not getgenv()._HubStreakLatched and prev >= minN then
        getgenv()._HubStreakLatched = true
        local disp = (Cfg.SettingsDisplay ~= "" and Cfg.SettingsDisplay) or LP.DisplayName
        local hand = (Cfg.SettingsUser ~= "" and Cfg.SettingsUser) or LP.Name
        hubStreakMsg(hubStreakText(prev))
    elseif not dead then
        getgenv()._HubStreakLatched = false
    end
    -- value dip without observed death (respawn faster than the 1s tick)
    if cur < prev then
        if prev >= minN and not getgenv()._HubStreakLatched then
            getgenv()._HubStreakLatched = true
            local disp = (Cfg.SettingsDisplay ~= "" and Cfg.SettingsDisplay) or LP.DisplayName
            local hand = (Cfg.SettingsUser ~= "" and Cfg.SettingsUser) or LP.Name
            hubStreakMsg(hubStreakText(prev))
        end
        getgenv()._HubStreakPrev = cur
    end
end


