-- Best-effort SERVER emote: finds the game's own emote RemoteEvent and
-- fires it so EVERYONE sees the dance, not just you. Shop/purchase/equip
-- remotes are never touched ??" firing those could buy things. RemoteEvents
-- only (never Functions: a wrong InvokeServer can hang the thread).
function hubPlayEmoteRemote(name, ids)
    local fired = false
    pcall(function()
        local cache = getgenv()._HubEmoteRemotes
        if type(cache) ~= "table" then
            cache = {}
            getgenv()._HubEmoteRemotes = cache
            local rems = ReplicatedStorage:FindFirstChild("Remotes")
            local roots = {}
            if rems then table.insert(roots, rems) end
            table.insert(roots, ReplicatedStorage)
            for _, root in ipairs(roots) do
                for _, d in ipairs(root:GetDescendants()) do
                    local okE = false
                    pcall(function() okE = d:IsA("RemoteEvent") end)
                    if okE then
                        local nm = string.lower(d.Name or "")
                        local isEmote = string.find(nm, "emote", 1, true)
                            or string.find(nm, "dance", 1, true)
                        local isShop = string.find(nm, "buy", 1, true)
                            or string.find(nm, "purchase", 1, true)
                            or string.find(nm, "shop", 1, true)
                            or string.find(nm, "equip", 1, true)
                            or string.find(nm, "unlock", 1, true)
                            or string.find(nm, "price", 1, true)
                            or string.find(nm, "cost", 1, true)
                            or string.find(nm, "store", 1, true)
                        if isEmote and not isShop then table.insert(cache, d) end
                    end
                end
            end
        end
        for _, r in ipairs(cache) do
            pcall(function()
                r:FireServer(tostring(name))
                fired = true
            end)
            if ids and ids[1] then
                pcall(function() r:FireServer(tostring(ids[1])) end)
            end
        end
    end)
    return fired
end


-- Asset loader, hardened: Animation parented to the Animator before load
-- (bare instances fail on some builds), content preloaded, then verified.
-- Returns a loaded track or nil - never a dead handle.
function hubLoadEmoteTrack(an, ids)
    for _, id in ipairs(ids or {}) do
        local track = nil
        pcall(function()
            local aid = tostring(id or "")
            if aid == "" then return end
            if not aid:match("%d+") then return end
            if not string.find(aid, "rbxassetid://", 1, true) then
                local digits = aid:match("(%d+)")
                if digits then aid = "rbxassetid://" .. digits end
            end
            local a = Instance.new("Animation")
            a.AnimationId = aid
            a.Parent = an
            pcall(function()
                game:GetService("ContentProvider"):PreloadAsync({ a })
            end)
            local t = an:LoadAnimation(a)
            if t then
                local t0 = tick()
                while (t.Length or 0) <= 0.1 and tick() - t0 < 1.2 do task.wait(0.1) end
                if (t.Length or 0) > 0.1 then track = t end
            end
        end)
        if track then return track end
    end
    return nil
end


-- Play-verify: actually Plays each candidate id and keeps the first one
-- that reports IsPlaying. Fixes "emote picked but nothing moves": old code
-- trusted LoadAnimation alone, and dead/moderated ids load as ghosts.
function hubPlayEmoteAsset(an, ids, speed, loop)
    for _, id in ipairs(ids or {}) do
        local ok, track = pcall(function() return hubLoadEmoteTrack(an, { id }) end)
        if ok and track then
            local played = false
            pcall(function()
                track.Looped = loop and true or false
                track.Priority = Enum.AnimationPriority.Action
                track:Play(0.15, 1, speed or 1)
                track:AdjustSpeed(speed or 1)
                local t0 = tick()
                while not track.IsPlaying and tick() - t0 < 0.8 do task.wait(0.05) end
                played = track.IsPlaying and true or false
                if not played then track:Stop() end
            end)
            if played then return track end
        end
    end
    return nil
end


-- Snapshot of playing tracks, so engine-emote paths only claim tracks that
-- STARTED after our invoke (gun poses/idles that were already playing must
-- never count as "your emote played").
function hubPlayingSet(an)
    local s = {}
    pcall(function()
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                s[tr] = true
            end
        end
    end)
    return s
end


function hubPlayEmote(name, speed, loop)
    hubStopEmote()
    name = name or Cfg.EmoteName or "Dance 1"
    speed = speed or Cfg.EmoteSpeed or 1
    loop = (loop ~= nil and loop) or Cfg.EmoteLoop or false
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        hubNotify("Emote: no character yet", 2, "miss")
        return
    end
    -- Sit is a state, not an animation
    if name == "Sit" then
        pcall(function() hum.Sit = true end)
        getgenv()._HubEmoteName = name
        hubNotify("Emote: Sit", 2, "hit")
        return
    end
    -- path 0: RIVALS native PlayClient — the game's own emote OOP class.
    -- Handles multi-part emotes (props, sounds, networked character anim).
    -- This is what the game calls when you press an emote button in-game.
    do
        local rivalsPlayed = false
        pcall(function()
            local modFolder = game:GetService("ReplicatedStorage").Modules.Emotes
            local mod = modFolder and modFolder:FindFirstChild(name)
            if not mod then return end
            local ok, cls = pcall(require, mod)
            if not ok or type(cls) ~= "table" then return end
            local FC = require(LP.PlayerScripts.Controllers.FighterController)
            local lf = FC and FC.LocalFighter
            if not lf then return end
            local inst = nil
            pcall(function() inst = cls.new() end)
            if not inst then pcall(function() inst = cls.new(lf) end) end
            if not inst then return end
            local okPC = pcall(function() inst:PlayClient(lf, 1, {}) end)
            if okPC then
                getgenv()._HubEmoteRivalsInst = inst
                getgenv()._HubEmoteName = name
                hubNotify("Emote: " .. tostring(name), 2, "hit")
                rivalsPlayed = true
            end
        end)
        if rivalsPlayed then return end
    end
    -- server-first: the game's own emote remote makes EVERYONE see it.
    -- Local tracks below still play as the guaranteed visual.
    pcall(function() hubPlayEmoteRemote(name, hubEmoteIdsFor(name)) end)
    local an = hum:FindFirstChildOfClass("Animator")
    if not an then
        pcall(function() an = hum:WaitForChild("Animator", 3) end)
    end
    -- path 1: the GAME's own emote pipe (Animate.PlayEmote bindable).
    -- rig-correct by definition ??" this is what /e dance uses.
    local defName = HUB_EMOTE_DEFAULTS[name]
    if defName and char then
        local before1 = hubPlayingSet(an)
        pcall(function()
            local animate = char:FindFirstChild("Animate")
            local bf = animate and animate:FindFirstChild("PlayEmote")
            if bf then bf:Invoke(defName) end
        end)
        task.wait(0.3)
        local played = false
        if an then
            pcall(function()
                for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                    if tr.IsPlaying and not before1[tr] then -- v16: no Length gate (streaming rigs report 0)
                        tr:AdjustSpeed(speed)
                        getgenv()._HubEmoteTrack = tr
                        played = true
                    end
                end
            end)
        end
        if played then
            getgenv()._HubEmoteName = name
            if loop then hubEmoteLoopWatch(name) end
            hubNotify("Emote: " .. tostring(name), 2, "hit")
            return
        end
    end
    -- path 2: engine default (Humanoid:PlayEmote) for classic names
    if defName then
        local before2 = hubPlayingSet(an)
        pcall(function() hum:PlayEmote(defName) end)
        task.wait(0.3)
        local played2 = false
        if an then
            pcall(function()
                for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                    if tr.IsPlaying and not before2[tr] then -- v16: no Length gate (streaming rigs report 0)
                        tr:AdjustSpeed(speed)
                        getgenv()._HubEmoteTrack = tr
                        played2 = true
                    end
                end
            end)
        end
        if played2 then
            getgenv()._HubEmoteName = name
            if loop then hubEmoteLoopWatch(name) end
            hubNotify("Emote: " .. tostring(name), 2, "hit")
            return
        end
    end
    -- path 3: asset pools, play-verified per id (dead ids are skipped,
    -- the first id that actually moves the rig wins)
    if not an then
        hubNotify("Emote: no Animator", 2, "miss")
        return
    end
    local track = nil
    local ids = hubEmoteIdsFor(name)
    if ids and #ids > 0 then track = hubPlayEmoteAsset(an, ids, speed, loop) end
    if not track and an then
        -- id-less game emote: last resort is the engine pipe by raw name
        pcall(function() hum:PlayEmote(name) end)
        task.wait(0.3)
        pcall(function()
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.IsPlaying then -- v16: no Length gate (streaming rigs report 0)
                    tr:AdjustSpeed(speed)
                    getgenv()._HubEmoteTrack = tr
                    track = tr
                end
            end
        end)
    end
    if not track then
        local n = (ids and #ids) or 0
        hubNotify("Emote failed: " .. tostring(name) .. " (" .. tostring(n) .. " ids, none played)", 3, "miss")
        return
    end
    getgenv()._HubEmoteTrack = track
    getgenv()._HubEmoteName = name
    pcall(function()
        track.Looped = loop
        track.Priority = Enum.AnimationPriority.Action4
        track:Play(0.15, 1, speed)
        track:AdjustSpeed(speed)
    end)
    if loop then hubEmoteLoopWatch(name) end
    hubNotify("Emote: " .. tostring(name), 2, "hit")
end


function hubEmoteLoopWatch(name)
    getgenv()._HubEmoteLoop = true
    task.spawn(function()
        while getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name do
            task.wait(0.5)
            -- Check if track is still alive
            local alive = false
            pcall(function()
                local t = getgenv()._HubEmoteTrack
                if t and t.IsPlaying then
                    alive = true
                    t:AdjustSpeed(Cfg.EmoteSpeed or 1)
                end
            end)
            -- Check current character health (not captured var — always live LP.Character)
            local ch = LP.Character
            local h2 = ch and ch:FindFirstChildOfClass("Humanoid")
            local charAlive = h2 and h2.Health > 0
            if not alive then
                if getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name then
                    if charAlive then
                        -- Track died but char is alive: stun/interrupt — replay now
                        getgenv()._HubEmoteLoop = false
                        hubPlayEmote(name, Cfg.EmoteSpeed, true)
                        return
                    else
                        -- Char dead/resetting — wait for new character to spawn then replay
                        local waited = 0
                        while waited < 8 do
                            task.wait(0.3)
                            waited += 0.3
                            local newCh = LP.Character
                            local newHum = newCh and newCh:FindFirstChildOfClass("Humanoid")
                            if newHum and newHum.Health > 0 then
                                task.wait(0.5) -- let character fully load
                                if getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name then
                                    getgenv()._HubEmoteLoop = false
                                    hubPlayEmote(name, Cfg.EmoteSpeed, true)
                                end
                                return
                            end
                        end
                        break -- timed out waiting for respawn
                    end
                end
                break
            end
            if not charAlive then break end
        end
    end)
end


-- Manual shots: equipped mag dropped since last frame = a bullet left.
-- (Refills/reloads only ever RAISE the number, so they can't false-fire.)
_shotAmmoBase = nil
_shotItemId   = nil


function detectShotSound()
    if not Cfg.HitSoundEnabled then return end
    local fc = getFC()
    local lf = fc and fc.LocalFighter
    local it = lf and lf.EquippedItem
    local ammo = it and it.Data and it.Data.Ammo
    local oid = nil
    pcall(function() oid = it and it:Get("ObjectID") end)
    if oid ~= _shotItemId then
        _shotItemId = oid
        _shotAmmoBase = ammo
        return
    end
    if type(ammo) == "number" and type(_shotAmmoBase) == "number" then
        local drop = _shotAmmoBase - ammo
            if drop > 0 and drop <= 50 then playHitSound() hubTracerManual() end
    end
    _shotAmmoBase = ammo
end


-- Kills: elimination-feed slot whose Eliminator label is you. Victim labels
-- with your name are ignored (that's you dying, no jingle for that).
_killFeedBase = nil


function detectKillSound()
    if not Cfg.KillSoundEnabled then
        _killFeedBase = nil
        return
    end
    -- NOLAG: cached feed ref (recursive FindFirstChild is a full-tree walk).
    local feed = getgenv()._HubKillFeed
    if not (feed and feed.Parent) then
        local mg = LP.PlayerGui:FindFirstChild("MainGui")
        feed = mg and mg:FindFirstChild("EliminationFeed", true)
        getgenv()._HubKillFeed = feed
    end
    if not feed then
        _killFeedBase = nil
        return
    end
    local myDisp = LP.DisplayName
    local n = 0
    local _desc = feed:GetDescendants()
    for _i = 1, math.min(#_desc, 200) do
        local c = _desc[_i]
        if c:IsA("TextLabel") and c.Parent and c.Parent.Name == "Eliminator" then
            local t = c.Text
            if t == REAL_NAME or t == REAL_DISPLAY or t == myDisp
                or (Cfg.SettingsDisplay ~= "" and t == Cfg.SettingsDisplay) then
                n += 1
            end
        end
    end
    if _killFeedBase == nil then
        _killFeedBase = n
    elseif n > _killFeedBase then
        _killFeedBase = n
        playKillSound()
        -- v16: secret-inspect chance roll on every elimination
        if (Cfg.InspectChance or 0) > 0 and math.random(1, 100) <= Cfg.InspectChance then
            task.spawn(function() pcall(function() hubSecretInspect() end) end)
        end
    elseif n < _killFeedBase then
        _killFeedBase = n
    end
end


-- ?"??"? Font styler: forces one font family across PlayerGui text (~1/s cadence
-- because the game rebuilds UI constantly). "Default" = hands off.
-- WHY FontFace, not .Font: RIVALS labels use a custom font ASSET
-- (rbxassetid://12187365977), so legacy .Font writes render nowhere.
-- Font.fromName families below were ALL verified live on the client.
FONT_OPTIONS = { "Default",
    "GothamSSm", "GothamBlack", "GothamBold", "GothamMedium", "Code", "Arcade", "Fantasy", "Cartoon", "SciFi",
    "LuckiestGuy", "Bangers", "Creepster", "Jura", "Oswald", "Roboto", "RobotoBlack", "RobotoCondensed",
    "RobotoMono", "Montserrat", "MontserratBlack", "Nunito", "NunitoBlack", "IndieFlower", "PatrickHand",
    "SpecialElite", "Kalam", "Michroma", "Poppins", "PoppinsBlack", "Inter", "InterBlack",
    "SourceSansPro", "SourceSansBold", "Merriweather", "PlayfairDisplay", "SpaceMono", "Ubuntu",
    "Lato", "LatoBlack", "OpenSans", "Raleway", "BebasNeue", "Anton", "Pacifico",
    "DancingScript", "GreatVibes", "PressStart2P", "Bodoni", "Garamond", "Fondamento",
}
-- old saved values map onto real families
FONT_LEGACY_FALLBACK = {
    Gotham = "GothamSSm", GothamBold = "GothamSSm",
    GothamMedium = "GothamSSm", GothamBlack = "GothamSSm",
}
_fontFaceCache = {}


function applyFontStyle()
    local wantFont = not (Cfg.FontStyle == nil or Cfg.FontStyle == "" or Cfg.FontStyle == "Default")
    local wantColor = Cfg.FontColorEnabled and true or false
    if not wantFont and not wantColor then return end
    local fam, face, okE, ef = nil, nil, false, nil
    if wantFont then
        fam = FONT_LEGACY_FALLBACK[Cfg.FontStyle] or Cfg.FontStyle
        face = _fontFaceCache[fam]
        if not face then
            local okF, f = pcall(function()
                return Font.fromName(fam, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            end)
            if not okF or not f then face = nil else face = f _fontFaceCache[fam] = f end
        end
        local _okE, _ef = pcall(function() return Enum.Font[Cfg.FontStyle] end)
        okE, ef = _okE, _ef
        if not face and not (okE and ef) then return end -- bad font name, color still runs below --
    end
    local wantCol = Cfg.FontColorEnabled and Color3.fromRGB(Cfg.FontColorR or 255, Cfg.FontColorG or 255, Cfg.FontColorB or 255) or nil
    local pg = LP.PlayerGui
    if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            if wantFont and okE and ef and d.Font ~= ef then
                pcall(function() d.Font = ef end)
            end
            if wantFont then
                local same = false
                pcall(function()
                    same = (d.FontFace.Family == face.Family)
                end)
                if not same then
                    pcall(function() d.FontFace = face end)
                end
            end
            if wantCol then pcall(function() if d.TextColor3 ~= wantCol then d.TextColor3 = wantCol end end) end
        end
    end
end


function cycleFontStyle()
    local cur = Cfg.FontStyle
    local at = 1
    for i, n in ipairs(FONT_OPTIONS) do
        if n == cur then at = i break end
    end
    local nxt = FONT_OPTIONS[(at % #FONT_OPTIONS) + 1]
    -- push through Linoria's registry too so the dropdown shows it
    local applied = false
    pcall(function()
        local opts = getgenv().Options
        local o = opts and opts.FontStyle
        if o and o.SetValue then o:SetValue(nxt) applied = true end
    end)
    if not applied then
        Cfg.FontStyle = nxt
    end
    pcall(function() Library:Notify("Font: " .. tostring(nxt), 2) end)
end


-- ?"??"? Infinite double jump: every air-jump press re-fires the leap, no weapon
-- needed. Feels like holding Bow/Fists/Daggers without holding them.
-- v3.1: true infinite (Max=0) or capped multi-jump, coyote-time grace,
-- hold-to-rise mode, grounded reset, debounced so one press = one leap.
_djConn = nil
_djCount = 0
_djLastGround = 0
_djLastFire = 0
_djHoldTask = nil


function djGrounded(hum)
    if not hum then return false end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Landed
        or st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.RunningNoPhysics
        or st == Enum.HumanoidStateType.Climbing
        or st == Enum.HumanoidStateType.Swimming
        or st == Enum.HumanoidStateType.Seated then
        return true
    end
    local ok, fl = pcall(function() return hum.FloorMaterial end)
    if ok and fl ~= Enum.Material.Air then return true end
    return false
end


function djDoLeap()
    if not Cfg.MiscDoubleJump then return end
    if Cfg.MiscFly then return end
    local now = tick()
    if now - _djLastFire < 0.08 then return end -- one press = one leap
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and hum.Health > 0) then return end
    if djGrounded(hum) then
        _djCount = 0
        _djLastGround = now
        return -- grounded: let the normal jump run, reset the counter
    end
    local coyote = Cfg.MiscDoubleJumpCoyote or 0
    if coyote > 0 and (now - _djLastGround) <= coyote and _djCount == 0 then
        -- still inside coyote grace: free leap, doesn't spend the counter
    else
        local maxJ = Cfg.MiscDoubleJumpMax or 0
        if maxJ > 0 and _djCount >= maxJ then return end
        _djCount += 1
    end
    _djLastFire = now
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    local v = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(v.X, Cfg.MiscDoubleJumpPower, v.Z)
    playCustomSound("HubJumpSound", Cfg.DoubleJumpSoundId, 0.6)
end


-- Bow-like double jump: hooks the game's own MechanicsController so mid-air
-- jumps fire the real DoubleJump (same boost as the bow), no velocity hacks.
function hubDoubleJumpHook()
    pcall(function()
        local mc = require(LP.PlayerScripts.Controllers.MechanicsController)
        if type(mc) ~= "table" then return end
        if getgenv()._HubDJHooked then return end
        local old = mc.DoubleJumpRequest
        if type(old) ~= "function" then return end
        getgenv()._HubDJHooked = true
        mc.DoubleJumpRequest = function(self, ...)
            local okAir, airborne = pcall(function()
                return self.LocalFighter and not self.LocalFighter:IsGrounded()
            end)
            if Cfg.MiscDoubleJump and okAir and airborne then
                return self:DoubleJump()
            end
            return old(self, ...)
        end
    end)
end


function enableDoubleJump()
    if _djConn then
        pcall(function() _djConn:Disconnect() end)
        _djConn = nil
    end
    if _djHoldTask then
        getgenv()._HubDJHold = false
        _djHoldTask = nil
    end
    if not Cfg.MiscDoubleJump then return end
    -- game's own jump path first (bow boost), retry while controllers load
    hubDoubleJumpHook()
    task.spawn(function()
        for _ = 1, 6 do
            task.wait(1)
            if not Cfg.MiscDoubleJump then return end
            if getgenv()._HubDJHooked then return end
            hubDoubleJumpHook()
        end
    end)
    _djCount = 0
    _djLastGround = tick()
    _djConn = UserInputService.JumpRequest:Connect(function()
        -- hooked game path owns the jump when live (exact bow boost);
        -- this leap is only the fallback while controllers still load.
        if getgenv()._HubDJHooked then return end
        djDoLeap()
    end)
    table.insert(_miscConns, _djConn)
    -- grounded watcher: touching ground resets the air counter
    local gc = RunService.Heartbeat:Connect(function()
        if not Cfg.MiscDoubleJump then return end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and djGrounded(hum) then
            _djCount = 0
            _djLastGround = tick()
        end
    end)
    table.insert(_miscConns, gc)
    -- hold-to-rise: holding Space chains leaps while airborne
    if Cfg.MiscDoubleJumpHold and not _djHoldTask then
        getgenv()._HubDJHold = true
        _djHoldTask = task.spawn(function()
            while getgenv()._HubDJHold and Cfg.MiscDoubleJump and Cfg.MiscDoubleJumpHold do
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    djDoLeap()
                end
                task.wait(0.12)
            end
            _djHoldTask = nil
        end)
    end
end


-- ?"??"? Anti flash / anti smoke (event-driven, no polling so no frame cost)
-- Flash: white fullscreen overlays in PlayerGui + sudden Lighting postfx are
-- destroyed on spawn (pre-existing map lighting is baselined, never touched).
-- Smoke: legacy Smoke puffs die; big transparent non-collide cloud parts go
-- fully invisible with their emitters off (originals restored on toggle-off).
_flashConns = {}
_smokeConns = {}
_flashBaseFx = {}
_smokeFaded = {}
_smokeEmitters = {}


function disconns(t)
    for _, c in ipairs(t) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(t)
end


function isPostFx(inst)
    return inst:IsA("BlurEffect") or inst:IsA("ColorCorrectionEffect")
        or inst:IsA("SunRaysEffect") or inst:IsA("BloomEffect")
        or inst:IsA("DepthOfFieldEffect")
end


function isFlashOverlay(inst)
    if not (inst:IsA("Frame") or inst:IsA("ImageLabel")) then return false end
    local ok, full = pcall(function()
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local sz = inst.AbsoluteSize
        return sz.X > vp.X * 0.7 and sz.Y > vp.Y * 0.7
    end)
    if not ok or not full then return false end
    if inst:IsA("Frame") then
        if inst.BackgroundTransparency > 0.85 then return false end
        local bg = inst.BackgroundColor3
        return (bg.R + bg.G + bg.B) > 2.4
    end
    return true
end


function setAntiFlash(on)
    disconns(_flashConns)
    if not on then return end
    table.clear(_flashBaseFx)
    pcall(function()
        for _, d in ipairs(Lighting:GetDescendants()) do
            if isPostFx(d) then _flashBaseFx[d] = true end
        end
    end)
    local pg = LP.PlayerGui
    if pg then
        table.insert(_flashConns, pg.DescendantAdded:Connect(function(inst)
            if not Cfg.AntiFlash then return end
            if isFlashOverlay(inst) then pcall(function() inst:Destroy() end) end
        end))
        for _, d in ipairs(pg:GetDescendants()) do
            if isFlashOverlay(d) then pcall(function() d:Destroy() end) end
        end
    end
    table.insert(_flashConns, Lighting.DescendantAdded:Connect(function(inst)
        if not Cfg.AntiFlash then return end
        if isPostFx(inst) and not _flashBaseFx[inst] then
            pcall(function() inst:Destroy() end)
        end
    end))
end


function smokePartHit(p)
    if not p:IsA("BasePart") then return false end
    local ch = LP.Character
    if ch and p:IsDescendantOf(ch) then return false end
    -- name match catches smoke-bomb props regardless of size
    local nm = string.lower(p.Name)
    if string.find(nm, "smoke", 1, true) then return true end
    local ok, hit = pcall(function()
        return p.Size.Magnitude > 8
            and p.Transparency >= 0.1 and p.Transparency < 1
            and p.CanCollide == false
    end)
    return ok and hit
end


function fadeSmokePart(p)
    if _smokeFaded[p] ~= nil then return end
    local ok, t = pcall(function() return p.Transparency end)
    if not ok then return end
    _smokeFaded[p] = t
    pcall(function() p.Transparency = 1 end)
    for _, d in ipairs(p:GetDescendants()) do
        if d:IsA("ParticleEmitter") or d:IsA("Smoke") then
            if _smokeEmitters[d] == nil then
                local oe = true
                pcall(function() oe = d.Enabled end)
                _smokeEmitters[d] = oe
                pcall(function() d.Enabled = false end)
            end
        end
    end
end


function neutralizeSmokeInst(inst)
    if inst:IsA("Smoke") then
        pcall(function() inst:Destroy() end)
        return
    end
    if inst:IsA("ParticleEmitter") then
        local par = inst.Parent
        if par and smokePartHit(par) and _smokeEmitters[inst] == nil then
            local oe = true
            pcall(function() oe = inst.Enabled end)
            _smokeEmitters[inst] = oe
            pcall(function() inst.Enabled = false end)
        end
        return
    end
    if inst:IsA("BasePart") then
        if smokePartHit(inst) then fadeSmokePart(inst) end
        return
    end
    if inst:IsA("Model") or inst:IsA("Folder") then
        for _, d in ipairs(inst:GetDescendants()) do neutralizeSmokeInst(d) end
    end
end


function setAntiSmoke(on)
    disconns(_smokeConns)
    if not on then
        for p, t in pairs(_smokeFaded) do
            pcall(function() p.Transparency = t end)
        end
        table.clear(_smokeFaded)
        for e, oe in pairs(_smokeEmitters) do
            pcall(function() e.Enabled = oe end)
        end
        table.clear(_smokeEmitters)
        return
    end
    table.insert(_smokeConns, Workspace.DescendantAdded:Connect(function(inst)
        if not Cfg.AntiSmoke then return end
        neutralizeSmokeInst(inst)
    end))
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do neutralizeSmokeInst(d) end
    end)
end


function antiFxCleanup()
    setAntiFlash(false)
    setAntiSmoke(false)
end


_perfSaved = nil


-- Potato enforcement: duels reset Lighting (shadows back on, fresh postfx),
-- which silently undoes potato seconds after you enable it. Re-kill on
-- sight; harmless no-op while everything stays off.
function hubPerfEnforce()
    if not Cfg.PerfPotato then return end
    local need = false
    pcall(function()
        if Lighting.GlobalShadows then need = true end
    end)
    if not need then
        pcall(function()
            local function liveFx(list)
                for _, d in ipairs(list) do
                    if d:IsA("PostEffect") and d.Enabled then return true end
                end
                return false
            end
            if liveFx(Lighting:GetDescendants()) then need = true end
            local cam = Workspace.CurrentCamera
            if not need and cam and liveFx(cam:GetDescendants()) then need = true end
        end)
    end
    if need then pcall(function() applyPerf() end) end
end


function hubFpsSafeIsProtected(inst) -- never touch gameplay / hub / characters vitals, only eye candy --
    if not inst then return true end
    local nm = "" pcall(function() nm = tostring(inst.Name or "") end)
    if nm == "_HubHitboxExpander" or nm == "_HubHitboxWeld" or nm == "_HubSkyPlat" or nm == "_HubUnderPlat" then return true end
    if string.find(nm, "_Hub", 1, true) then return true end
