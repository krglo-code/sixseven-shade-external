-- Diagnose: reports live module shapes so detection gaps are visible.
function hubDiagnose()
    local rep = {}
    local function add(s) table.insert(rep, s) end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        add("Modules:" .. tostring(mods ~= nil))
        local im = mods and mods:FindFirstChild("ItemLibrary")
        local il = im and require(im)
        local nItems, nVM = 0, 0
        if il then
            if type(il.Items) == "table" then
                for _ in pairs(il.Items) do nItems += 1 end
            end
            if type(il.ViewModels) == "table" then
                for _ in pairs(il.ViewModels) do nVM += 1 end
            end
        end
        add("Items:" .. nItems .. " ViewModels:" .. nVM)
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local nC, types, sample = 0, {}, nil
        if lib and type(lib.Cosmetics) == "table" then
            for name, info in pairs(lib.Cosmetics) do
                nC += 1
                local t = type(info) == "table" and tostring(info.Type or "?") or type(info)
                types[t] = true
                if not sample and type(info) == "table" then
                    local ks = {}
                    for k in pairs(info) do table.insert(ks, tostring(k)) end
                    sample = tostring(name) .. " {" .. table.concat(ks, ",") .. "}"
                end
                if nC > 2000 then break end
            end
        end
        local tl = {}
        for t in pairs(types) do table.insert(tl, t) end
        add("Cosmetics:" .. nC .. " types:" .. table.concat(tl, ","))
        if sample then add("e.g. " .. sample:sub(1, 90)) end
        local eq = 0
        for _ in pairs(hubWeaponItems()) do eq += 1 end
        add("Equipped:" .. eq)
    end)
    local txt = table.concat(rep, "\n")
    local lbl = getgenv()._HubWepDiag
    if lbl then pcall(function() lbl:SetText(txt) end) end
    warn("[Hub] diagnose:\n" .. txt)
    pcall(function() Library:Notify("Diagnostics in console (F9)", 3) end)
end


