-- Native Linoria Tabbox: renders "Ragebot | Triggerbot" side-by-side in one row.
-- Tab:Show() / Tab:Hide() are handled internally; we hook them to drive
-- the real groupbox visibility via showMainPage.
local LeftTabbox = Tabs.Aim:AddLeftTabbox("Select")
local LTabRage   = LeftTabbox:AddTab("Ragebot")
local LTabTrig   = LeftTabbox:AddTab("Triggerbot")

-- Wire tab clicks to the page switcher.
-- Linoria fires InputBegan on the button internally and calls Tab:Show().
-- We override Show on each tab so our groupbox logic runs too.
-- Shared sub-tab hook: Left (Rage/Trigger) and Right (Aimbot/Silent) run the
-- EXACT same native path. Linoria's own Tab:Show()/Hide() owns visibility;
-- we only add page tracking + a safe scroll-to-top of the owning column.
-- Groupboxes live INSIDE Tab.Container (see native reparent block in ?36),
-- so switching is 100% native on all four pages ??" nothing custom to break.
function hookHubSubTab(tab, page, side)
    if type(tab) ~= "table" or type(tab.Show) ~= "function" then return end
    if tab._HubHooked then return end
    tab._HubHooked = true
    local orig = tab.Show
    tab.Show = function(self)
        local tgt = self
        if type(tgt) ~= "table" then tgt = tab end
        pcall(function() orig(tgt) end)
        pcall(function()
            if side == "Left" then getgenv()._HubMainPageL = page
            elseif side == "Right" then getgenv()._HubMainPageR = page end
            getgenv()._HubMainPage = page
            -- Scroll the owning column (Tabbox outer -> ScrollingFrame) to top.
            local boxOuter = tab.Container and tab.Container.Parent
                and tab.Container.Parent.Parent or nil
            local scroll = boxOuter and boxOuter.Parent or nil
            if scroll then
                local okS = false
                pcall(function() okS = scroll:IsA("ScrollingFrame") end)
                if okS then pcall(function() scroll.CanvasPosition = Vector2.zero end) end
            end
        end)
        pcall(function() hubTabRise() end)
    end
end
