-- persisted in getgenv so a re-execute still recognizes fakes applied by the
-- previous run (otherwise old fake labels become orphans you can never change)
_lastFakeDisplay = getgenv()._HubV3LastFakeD or ""
_lastFakeUser    = getgenv()._HubV3LastFakeU or ""


function fakeUserTag()
    if Cfg.SpoofUsername == false then return nil end
    if Cfg.SettingsUser ~= "" then return "@" .. Cfg.SettingsUser end
    return nil
end


function isOwnName(t)
    if t == REAL_NAME or t == REAL_DISPLAY
        or t == ("@" .. REAL_NAME) or t == ("@" .. REAL_DISPLAY) then
        return true
    end
    -- also match fakes applied by an earlier pass (user edited the name twice)
    if _lastFakeDisplay ~= "" and (t == _lastFakeDisplay or t == ("@" .. _lastFakeDisplay)) then
        return true
    end
    if _lastFakeUser ~= "" and (t == "@" .. _lastFakeUser or t == _lastFakeUser) then
        return true
    end
    return false
end


-- replacement that preserves @-handle form (display/user fully separate)
function fakeFor(t)
    if t:sub(1, 1) == "@" then
        return fakeUserTag() or t
    end
    if Cfg.SpoofDisplayName ~= false and Cfg.SettingsDisplay ~= "" then
        return Cfg.SettingsDisplay
    end
    return t
end


-- Username lock: spoof off = every @-label of yours reads @REAL_NAME,
-- even ones the game natively renders as @DisplayName. Others untouched.
function lockUsernameSweep()
    if Cfg.SpoofUsername ~= false then return end
    pcall(function()
        local mg = LP.PlayerGui:FindFirstChild("MainGui")
        if not mg then return end
        for _, d in ipairs(mg:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = d.Text
                if type(t) == "string" and t:sub(1, 1) == "@"
                    and isOwnName(t) and t ~= ("@" .. REAL_NAME) then
                    d.Text = "@" .. REAL_NAME
                end
            end
        end
    end)
end


function hubSpoofColorCustom()
