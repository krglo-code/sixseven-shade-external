        bg.ScaleType = Enum.ScaleType.Crop
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.Position = UDim2.new(0, 0, 0, 0)
        bg.ZIndex = 0
        bg.Parent = host
    end
    pcall(function()
