-- Improved target check: hub helpers (team, knocked, LOS, finite) instead
-- of raw Head lookups and deprecated FindPartOnRay. Same shape as pasted.
local function aimbotIsValidTarget(player, cam)
    if player == LP then return false end
    local model = player.Character
    if not model then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local head = headOf(model)
    if not hum or not head then return false end
    if (Cfg.AimbotDeadCheck ~= false) and (Cfg.AimDeadCheck ~= false) then
        if hum.Health <= 0 then return false end
        if modelKnocked(model) then return false end
    end
    if (Cfg.AimbotMaxDistance or 0) > 0 then
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local eRoot = model:FindFirstChild("HumanoidRootPart")
        if myRoot and eRoot then
            if (myRoot.Position - eRoot.Position).Magnitude > Cfg.AimbotMaxDistance then
                return false
            end
        end
    end
    if Cfg.AimbotWallCheck ~= false and Cfg.AimWallCheck ~= false and cam then
        if not hubFiniteVec(head.Position) then return false end
        local selfChar = LP.Character
        if not losClearMulti(cam, head.Position, model, { selfChar, cam }) then
            return false
        end
    end
    return true
end


-- Improved closest-player: screen-space FOV + Distance/Health priority.
-- Returns the Player (with .Character.Head), same as pasted.
local function aimbotGetClosestPlayer(cam, fov)
    if not cam then return nil end
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    if Cfg.AimFOVFollowMouse then
        pcall(function()
            local ml = UserInputService:GetMouseLocation()
            cx, cy = ml.X, ml.Y
        end)
    end
    local closest, closestValue = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if not aimbotIsValidTarget(player, cam) then continue end
        local head = headOf(player.Character)
        local pos, onScreen = cam:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        if not hubFiniteNum(pos.X) or not hubFiniteNum(pos.Y) then continue end
        local dist = math.sqrt((cx - pos.X) ^ 2 + (cy - pos.Y) ^ 2)
        if dist > (fov or Cfg.AimFOV or 500) then continue end
        local value = dist
        if (Cfg.AimbotPriority or "Distance") == "Health" then
            value = player.Character:FindFirstChildOfClass("Humanoid").Health
        end
        if value < closestValue then
            closestValue = value
            closest = player
        end
    end
    return closest
end


