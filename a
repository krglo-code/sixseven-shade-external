-- v9: zeroes spread/recoil/bloom on Info + any live recoil-ish numeric field.
-- Skips cooldown/reload/ammo keys so reload cycles never break.
function hubZeroRecoil(item)
    if item.Info and type(item.Info) == "table" then
        for _, k in ipairs(RECOIL_INFO_FIELDS) do
            if type(item.Info[k]) == "number" and item.Info[k] ~= 0 then item.Info[k] = 0 end
        end
    end
    for k, v in pairs(item) do
        if type(v) == "number" and v ~= 0 then
            local kl = string.lower(tostring(k))
            if string.find(kl, "cooldown", 1, true) or string.find(kl, "reload", 1, true)
                or string.find(kl, "ammo", 1, true) then continue end
            if string.find(kl, "recoil", 1, true) or string.find(kl, "spread", 1, true)
                or string.find(kl, "bloom", 1, true) or string.find(kl, "kickback", 1, true)
                or string.find(kl, "shake", 1, true) or string.find(kl, "sway", 1, true) then
                item[k] = 0
            end
        end
    end
end

