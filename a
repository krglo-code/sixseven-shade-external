function hubCosmeticPool(kind)
    local out = {}
    local kl = string.lower(kind)
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            local tt = type(info) == "table" and string.lower(tostring(info.Type or "")) or ""
            local nn = string.lower(tostring(name))
            -- v9 substring both ways: catches WeaponWrap / Wraps / Weapon Wrap etc.
            -- (empty types never match: find(x, "") would hit everything)
            if (tt ~= "" and (string.find(tt, kl, 1, true) or string.find(kl, tt, 1, true)))
                or string.find(nn, kl, 1, true) then
                table.insert(out, tostring(name))
                if #out >= 150 then break end
            end
        end
    end)
    table.sort(out)
    return out
end


-- Skins differ per weapon; wrap/charm/finisher pools are shared.
-- v18: weapon -> slot lookup so slot-tagged skins rank for their weapons
-- without any name keywords.
function hubWeaponSlotOf(w)
    w = string.lower(tostring(w or ""))
    if w == "" then return "" end
    local hit = ""
    pcall(function()
        for slot, list in pairs(HUB_SLOT_WEAPONS or {}) do
            if hit ~= "" then break end
            for _, n in ipairs(list) do
                if string.lower(tostring(n)) == w then hit = string.lower(slot) break end
            end
        end
    end)
    return hit
end


function hubWeaponSkins(weapon)
    local out = {}
    local w = string.lower(tostring(weapon or ""))
    -- ground truth: viewmodel images are keyed by skin name
    local vmKeys = {}
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local im = mods and mods:FindFirstChild("ItemLibrary")
        local lib = im and require(im)
        local vm = lib and lib.ViewModels or {}
        for name in pairs(vm) do table.insert(vmKeys, tostring(name)) end
    end)
    local function fits(nm)
        if w == "" then return true end
        local nl = string.lower(tostring(nm))
        return string.find(nl, w, 1, true) ~= nil
            or string.find(w, nl, 1, true) ~= nil
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            local t = type(info) == "table" and tostring(info.Type or "") or ""
            if string.find(string.lower(t), "skin", 1, true) then
                -- v15: untagged skins (no weapon fields at all, e.g. Event
                -- Horizon) belong to EVERY weapon. Keywords only filter entries
                -- the game itself tagged to a weapon: same features, no guessing.
                local tagged = false
                if type(info) == "table" then
                    for _, tk in ipairs({ "Weapon", "Slot", "Item", "Category" }) do
                        if info[tk] ~= nil and tostring(info[tk]) ~= "" then tagged = true break end
                    end
                    if not tagged and type(info.Weapons) == "table" and next(info.Weapons) ~= nil then
                        tagged = true
                    end
                end
                -- v18 ARRANGED rank: exact-weapon (0) > slot (1) > untagged (2).
                -- Your weapon's own skins sort on top; nothing keyword-guessed.
                -- v20 FIX: untagged entries (no weapon fields at all) fall
                -- back in at rank 2 so the list is never empty. Tagged
                -- skins still sort on top. Strict-empty was starving it.
                local score = nil
                if w == "" then
                    score = 2
                elseif type(info) == "table" then
                    for _, k in ipairs({ "Weapon", "Item" }) do
                        local v = info[k]
                        if v and string.find(string.lower(tostring(v)), w, 1, true) then
                            score = 0 break
                        end
                    end
                    if score == nil then
                        local ws = info.Weapons
                        if type(ws) == "table" then
                            for _, vv in pairs(ws) do
                                if string.find(string.lower(tostring(vv)), w, 1, true) then
                                    score = 0 break
                                end
                            end
                        end
                    end
                    if score == nil then
                        local slotOf = hubWeaponSlotOf(w)
                        local sfields = {}
                        if type(info.Slot) == "string" then sfields = { info.Slot }
                        elseif type(info.Category) == "string" then sfields = { info.Category } end
                        for _, sf in ipairs(sfields) do
                            if slotOf ~= "" and string.find(string.lower(tostring(sf)), slotOf, 1, true) then
                                score = 1 break
                            end
                        end
                    end
                    -- v20 fallback: truly untagged = universal, rank 2
                    if score == nil then
                        local tagged = false
                        for _, tk in ipairs({ "Weapon", "Slot", "Item", "Category" }) do
                            if info[tk] ~= nil and tostring(info[tk]) ~= "" then tagged = true break end
                        end
                        if not tagged and type(info.Weapons) == "table" and next(info.Weapons) ~= nil then
                            tagged = true
                        end
                        if not tagged then score = 2 end
                    end
                end
                if score ~= nil then
                    table.insert(out, { name = tostring(name), rank = score })
                    if #out >= 250 then break end
                end
            end
        end
    end)
    -- viewmodel keys catch skins the library tags differently
    for _, nm in ipairs(vmKeys) do
        if fits(nm) and #out < 250 then
            local dup = false
            for _, e in ipairs(out) do
                local en = type(e) == "table" and e.name or tostring(e)
                if en == nm then dup = true break end
            end
            if not dup then table.insert(out, { name = nm, rank = 1 }) end
        end
    end
    -- v19: nothing tagged for this weapon = empty list (strict, no flood)
    -- v18 arranged: own skins first, then slot, A-Z inside
    table.sort(out, function(a, b)
        local ar = type(a) == "table" and (a.rank or 2) or 2
        local br = type(b) == "table" and (b.rank or 2) or 2
        if ar ~= br then return ar < br end
        local an = type(a) == "table" and a.name or tostring(a)
        local bn = type(b) == "table" and b.name or tostring(b)
        return an < bn
    end)
    local flat = {}
    for _, e in ipairs(out) do
        if #flat >= 150 then break end
        table.insert(flat, type(e) == "table" and e.name or tostring(e))
    end
    return flat
end


