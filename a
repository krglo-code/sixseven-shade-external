function losClear(cam, worldPos, model, ignoreList)
    -- first-person heads-up: the camera sits INSIDE your skull, so start the
    -- ray a stud ahead ??" otherwise your own head eats every ray and duels
    -- (forced first-person) never lock while third-person lobbies do
    local origin = cam.CFrame.Position + cam.CFrame.LookVector * 1.0
    local dir    = worldPos - origin
    if dir.Magnitude > Cfg.AimMaxDist then return false end
    -- sanitize: a respawning (nil) character must never fault the raycast
    local clean = {}
    if type(ignoreList) == "table" then
        for _, inst in ipairs(ignoreList) do
            if typeof(inst) == "Instance" then table.insert(clean, inst) end
        end
    end
    _rayParams.FilterDescendantsInstances = clean
    local ok, res = pcall(function()
        return Workspace:Raycast(origin, dir, _rayParams)
    end)
    if not ok then return true end
    if not res then return true end
    return res.Instance:IsDescendantOf(model)
end


