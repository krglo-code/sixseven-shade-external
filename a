function hubStopEmote()
    getgenv()._HubEmoteLoop = false
    getgenv()._HubEmoteName = nil
    -- Stop RIVALS native emote instance (path 0: PlayClient)
    pcall(function()
        local inst = getgenv()._HubEmoteRivalsInst
        if inst and type(inst.Destroy) == "function" then inst:Destroy() end
        getgenv()._HubEmoteRivalsInst = nil
    end)
    pcall(function()
        local t = getgenv()._HubEmoteTrack
        if t then t:Stop() end
        getgenv()._HubEmoteTrack = nil
    end)
    pcall(function()
        -- also stop engine-driven default emotes (PlayEmote path)
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local an = hum and hum:FindFirstChildOfClass("Animator")
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.Priority == Enum.AnimationPriority.Action then
                    tr:Stop()
                end
            end
        end
    end)
end


-- Speed slider rides whatever is playing (both engine + custom paths).
function hubEmoteSetSpeed(spd)
    Cfg.EmoteSpeed = spd
