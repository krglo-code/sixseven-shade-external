    if tab == "Skin" then
        local w = (s.weapon ~= "All Weapons") and s.weapon or ""
        pool = hubWeaponSkins(w)
    elseif tab == "Finisher" then
        pool = hubFinisherPool()
    else
        pool = hubCosmeticPool(tab == "Wrap" and "Wrap" or "Charm")
    end
    local out = {
        { id = "__clear", label = "Unselected", glyph = "Ø" },
        { id = "None", label = "None", glyph = "Ø" },
        { id = "__random", label = "Random", glyph = "👻" },
    }
    for _, nm in ipairs(pool) do
        nm = tostring(nm)
        if q == "" or string.find(string.lower(nm), q, 1, true) then
            table.insert(out, { id = nm, label = nm })
        end
    end
    return out
end


