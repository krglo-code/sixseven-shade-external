-- Stage tracer: tiny top-left label naming each boot stage. If the menu
-- ever dies again, this label (not silence) says exactly where.
function hubStage(msg, bad)
    getgenv()._HubStageMsg = tostring(msg)
    pcall(function()
        local bl = getgenv()._HubBootLog
        if bl then bl(msg) end
    end)
    -- top-left stage label removed: no persistent GUI, failures still
    -- surface through bootWarn red banners + executor console.
    pcall(function()
        local g = CoreGui:FindFirstChild("_HubStage")
        if g then g:Destroy() end
    end)
end


_hubStageBase = hubStage
function hubStage(msg, bad)
    _hubStageBase(msg, bad)
    pcall(function()
        local l = getgenv()._HubBootDot
        if l and l.Parent then
            l.Text = "HUB: " .. tostring(msg)
            if bad then
                l.TextColor3 = Color3.fromRGB(255, 90, 90)
            elseif tostring(msg) == "ui built" then
                -- success: tracer did its job, remove it, menu is up --
                task.delay(1, function()
                    pcall(function()
                        local s = CoreGui:FindFirstChild("_HubBootDot")
                        if s then s:Destroy() end
                    end)
                end)
            end
        end
    end)
end


