                            save(d, "CastShadow", cs)
                            pcall(function() d.CastShadow = false end)
                        end
                    end
                end
            end
        end)
        pcall(function() -- RIVALS lag: map neon/glass + muzzle smoke + tripmines + kill FX live in Workspace, handled above --
            local terr = Workspace:FindFirstChildOfClass("Terrain")
            if terr and Cfg.PerfLowWater ~= false then save(terr, "WaterTransparency", terr.WaterTransparency) save(terr, "WaterReflectance", terr.WaterReflectance) terr.WaterTransparency = 1 terr.WaterReflectance = 0 pcall(function() terr.WaterWaveSize = 0 terr.WaterWaveSpeed = 0 end) end
        end)
