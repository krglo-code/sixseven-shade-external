-- Teardown previous instance if re-executing
-- BLACK BOX: file logger + getgenv shim. Runs before anything else. If the
-- chunk dies anywhere, rivals-hub/bootlog.txt shows the last stage reached.
pcall(function()
    if type(getgenv) ~= "function" then
        getgenv = function() return _G end
    end
    local g = getgenv()
    g._HubBootLog = function(m)
        pcall(function()
            local f = "Shade External/logs/bootlog.txt"
            local old = ""
            if type(isfile) == "function" and isfile(f) then
                old = readfile(f)
            end
            if #old > 4000 then old = old:sub(-4000) end
            local ts = "?"
            pcall(function() ts = os.date("%H:%M:%S") end)
            writefile(f, old .. ts .. " " .. tostring(m) .. "\n")
        end)
    end
    g._HubBootLog("file start")
end)
