-- Reload poke: tries every known reload entrypoint on the item table.
-- Only fires when the mag is dry but reserve exists, so full mags and
-- melee/utility (nil ammo) are never touched.
HUB_RELOAD_METHODS = { "Reload", "StartReload", "StartReloading", "BeginReload", "TryReload" }
function hubTryReload(item, force)
    if not force and not Cfg.RageSwapReload then return false end
    if type(item) ~= "table" or item._destroyed then return false end
    local ammo = item.Data and item.Data.Ammo
    if type(ammo) ~= "number" or ammo ~= 0 then return false end
    local reserve = item.Data and (item.Data.AmmoReserve or item.Data.Reserve)
    if type(reserve) == "number" and reserve <= 0 then return false end
    if item._reloading == true then return false end
    local now = tick()
    if item._reload_cooldown ~= nil and item._reload_cooldown > now then return false end
    for _, m in ipairs(HUB_RELOAD_METHODS) do
        if type(item[m]) == "function" then
            local ok = pcall(function() return item[m](item) end)
            if ok then return true end
        end
    end
    return false
end


-- throttled hold-reason notes: every rage hold-fire path was mute, which
-- reads as "ragebot does nothing". One line per reason, max every 6s.
local function hubRageHoldNote(why)
    if (getgenv()._HubRageHoldAt or 0) + 6 > tick() then return end
    getgenv()._HubRageHoldAt = tick()
    hubNotify("Rage holding: " .. tostring(why), 3, "miss")
end


function rageFireStep(cam)
    if not Cfg.RageEnabled then rageFlyRestore() return end
    if hubRageSafetyHold() then return end
    -- FIX v21: RageAnywhere bypasses inDuel gate (lobby/FFA/testing)
    if not inDuel() and not Cfg.RageAnywhere then
        _lastRageSlotApplied = nil
        rageFlyRestore()
        return
    end


    local fc = getFC()
    if not fc or not fc.LocalFighter then return end
    local lf = fc.LocalFighter


    local nowTick = tick()
    if cooldownPatchActive() then
        patchLF(lf, nowTick)
    end


    -- Equip ONLY on slot change. Equipping every frame yanked the weapon out of
    -- your hands constantly (breaks manual switching AND reload timing).
    local slotNum = WEAPON_SLOTS[Cfg.RageWeaponSlot] or 3
    -- (backstab + platform live in loop ?2c now, ungated by Rage Enabled)
    if slotNum ~= _lastRageSlotApplied then
        pcall(function() lf:EquipItem(slotNum) end)
        _lastRageSlotApplied = slotNum
    end


    -- Deflection map at 4Hz is plenty (was a full Objects scan every frame).
    if nowTick - _lastDeflSweep > 0.25 then
        _lastDeflSweep = nowTick
        updateDeflectionMap()
    end


    -- v2: antiaim/spin/desync modes pruned (local-only plant per shot below)


    local targetPlayer, targetRoot, targetHead = getRageTarget(cam)
    -- fresh-target cache for the hitmarker block: it reuses this instead of
    -- running a second full target scan on the same frame
    if targetHead then getgenv()._HubRageNow = { head = targetHead, t = nowTick } end
    if not targetPlayer or not targetHead or not targetRoot then
        -- fly mode parks you home when the lock drops
        if (Cfg.RagePosMode or "Off") == "Fly" then rageFlyRestore() end
        return
    end
    if isDeflecting(targetPlayer) then
        rageLogMiss("deflect")
        hubRageHoldNote("katana deflect up")
        return
    end
    if rageFriendListed(targetPlayer) then return end
    if Cfg.RageIgnoreKnocked and targetHead.Parent and modelKnocked(targetHead.Parent) then
        rageLogMiss("knocked") return
    end


    -- Void spam runs every frame independent of the shoot gate (v2).
    rageVoidSpam(targetRoot)


    if nowTick - _lastRageFire < math.max(0, Cfg.RageFireRate or 0.0005) then return end
    _lastRageFire = nowTick


    local util    = getUtil()
    local enumLib = getEnumLib()
    if not util or not enumLib then return end


    local item = lf.EquippedItem
    if not item then
        rageLogMiss("noItem")
        hubRageHoldNote("no weapon equipped")
        return
    end
    pcall(function() rageFusePoke(item) end)


    -- Auto-swap on EMPTY (debounced): the mag reads 0 for transient frames
    -- mid-spray and mid-reload, so a slot must read empty N straight fire
    -- steps before it counts. Kills the "swaps before secondary is done" bug.
    -- Fallback order: loaded guns first (Primary -> Secondary), melee/utility
    -- (nil ammo) only if RageSwapMelee and no loaded gun exists.
    -- After landing on a slot, Reload() is poked on anything dry-with-reserve
    -- (the gun you left AND the gun you drew), so secondary empties ->
    -- primary comes out already reloading/fresh.
    local ammoNow = item.Data and item.Data.Ammo
    if Cfg.RageAutoSwap and type(ammoNow) == "number" then
        local SW = getgenv()._HubSwap
        if type(SW) ~= "table" then SW = {} getgenv()._HubSwap = SW end
        local oid = nil
        pcall(function() oid = item:Get("ObjectID") end)
        local key = tostring(oid or item.Name or "cur")
        local reloadingNow = (item._reload_cooldown ~= nil and item._reload_cooldown > nowTick)
            or item._reloading == true
        if ammoNow <= 0 and not reloadingNow then
            SW[key] = (SW[key] or 0) + 1
        else
            SW[key] = 0
        end
        local need = math.max(1, Cfg.RageSwapDebounce or 12)
        if (SW[key] or 0) >= need then
            SW[key] = 0
            local emptyItem = item
            local bestGun, bestMelee = nil, nil
            if type(lf.Items) == "table" then
                for slot = 1, 4 do
                    local it = lf.Items[slot]
                    if it and it ~= item then
                        local a = it.Data and it.Data.Ammo
                        if type(a) == "number" and a > 0 then
                            if not bestGun then bestGun = { slot = slot, it = it } end
                        elseif a == nil and not bestMelee then
                            bestMelee = { slot = slot, it = it }
                        end
                    end
                end
            end
            local pick = bestGun or (Cfg.RageSwapMelee and bestMelee) or nil
            if pick then
                pcall(function() lf:EquipItem(pick.slot) end)
                _lastRageSlotApplied = pick.slot
                -- reload the gun we just left (it refills while holstered)
                pcall(function() hubTryReload(emptyItem) end)
                -- and the gun we drew, in case it is dry with reserve
                task.delay(0.35, function()
                    pcall(function()
                        local cur = lf.EquippedItem
                        if cur then hubTryReload(cur) end
                    end)
                end)
                item = lf.EquippedItem or pick.it
            else
                -- nothing loaded anywhere: poke reload on the dry gun instead
                -- of holding fire forever
                if Cfg.RageSwapReload then pcall(function() hubTryReload(item) end) end
                hubRageHoldNote("all mags dry")
                return
            end
        elseif ammoNow <= 0 then
            return -- still inside debounce: hold fire, let reload/frames settle
        end
    end
    if not item then return end


    -- v2 local-only desync plant: fires from the ghost, restores next step.
    -- Fire Origin = Camera skips the plant and fires from the live camera.
    local useCamOrigin = (Cfg.RageFireOrigin or "Head") == "Camera"
    local desyncCF = (not useCamOrigin) and rageDesyncPlant(targetPlayer, targetRoot, targetHead) or nil
    -- FIX v21: track desync offset so aimbot compensates correctly
    if desyncCF then
        local realPos = rageMyOrigin(cam)
        getgenv()._HubDesyncOff = desyncCF.Position - realPos
    else
        getgenv()._HubDesyncOff = nil
    end


    local originPos = desyncCF and desyncCF.Position or rageMyOrigin(cam)
    local targetPos = targetHead.Position


    local jitter = Vector3.new(
        (math.random() - 0.5) * 0.12,
        (math.random() - 0.5) * 0.12,
        (math.random() - 0.5) * 0.12
    )
    local aimedPos  = targetPos + jitter
    local aimCF     = CFrame.lookAt(originPos, aimedPos)
    local tarCF     = targetHead.CFrame
    local objOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))


    local camdata = {}
    camdata[utf8.char(1)] = {
        [utf8.char(0)] = util:EncodeCFrame(aimCF),
        [utf8.char(1)] = util:EncodeCFrame(tarCF),
        [utf8.char(2)] = targetHead,
        [utf8.char(3)] = util:EncodeCFrame(objOffset),
    }


    pcall(function()
        ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"),
            enumLib:ToEnum("StartShooting"),
            camdata,
            nil
        )
    end)
    pcall(function() hubTracerBeam(originPos, aimedPos) end)
    -- hit/miss judgement: HP drop shortly after = session hit
    task.delay(0.35, function()
        pcall(function()
            local m = targetPlayer.Character
            local h = m and m:FindFirstChildOfClass("Humanoid")
            local key = "rh" .. tostring(targetPlayer.UserId)
            local prev = getgenv()[key]
            local cur = h and h.Health or nil
            getgenv()[key] = cur
            if prev and cur and cur < prev then
                rageLogFire(prev - cur)
                if Cfg.RageKillNotify and cur <= 0 then
                    rageSession("kill")
                    playKillSound()
                    pcall(function() hubNotify("Eliminated " .. targetPlayer.DisplayName, 3, "kill") end)
                    if Cfg.TrigDisableOnKill then
                        getgenv()._HubTrigKillLatch = true
                        getgenv()._HubTrigKillAt = tick()
                    end
                end
            else
                rageLogMiss("noDamage")
            end
        end)
    end)
    if Cfg.RageTargetLabel then
        task.spawn(function()
            local L = aimDraw("rageLbl", "Text")
            if not L then return end
            for _ = 1, 30 do
                local m = targetPlayer.Character
                local hd = m and (m:FindFirstChild("HitboxHead") or m:FindFirstChild("Head"))
                if not hd then break end
                local sp, on = cam:WorldToViewportPoint(hd.Position + Vector3.new(0, 1, 0))
                if not on then break end
                L.Text = targetPlayer.DisplayName
                L.Size, L.Center, L.Outline = 13, true, true
                L.Color = Color3.fromRGB(255, 80, 80)
                L.Position, L.Visible = Vector2.new(sp.X, sp.Y), true
                task.wait(0.1)
            end
            L.Visible = false
        end)
    end
    playHitSound()
end


